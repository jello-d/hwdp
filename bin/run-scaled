#!/usr/bin/env bash
#
# run-scaled: magnify a single application via a nested gamescope window. The
# app renders at window/scale and is upscaled to fill the window, so `scale`
# controls how large the UI appears. Works under X11 and Wayland sessions; X
# apps run in gamescope's Xwayland by default (--wayland-app for Wayland ones).
#
# gamescope has no window shell: an app that maximizes itself fills the nested
# screen (the common case, and what magnifies cleanly); an app that opens a
# small fixed window will sit small inside the gamescope window. Tune --size
# toward the app's natural size if that happens.

SCALE=2
SIZE="1280x800"          # gamescope window (output) size; --fullscreen ignores
SIZE_SET=0               # was --size given, or is that just the default?
NATIVE=                  # the app's OWN canvas; the window becomes native*scale
FILTER=linear            # linear | nearest | integer | fsr | nis
FULLSCREEN=0             # 0 = windowed (default), 1 = fill the output
WAYLAND_APP=0

# Below this, an app of the kind people magnify (fixed-layout SDL and Qt
# programs) draws its own layout into a buffer too small for it and the edges
# are simply lost. Overridable, because it is a rule of thumb about other
# people's software rather than a fact about this one.
MIN_CANVAS=${RUN_SCALED_MIN_CANVAS:-640x480}

print_help() {
    echo "Usage: run-scaled [--scale=N] [--size=WxH] [--fullscreen] \
[--filter=F] [--wayland-app] application [args...]"
    echo ""
    echo "--scale       UI magnification. App renders at size/scale and is"
    echo "              upscaled to fill the window. e.g. 1, 1.5, 2, 2x. Def 2."
    echo "--size        gamescope window size WxH. Default 1280x800. The window"
    echo "              is resizable; resizing rescales live."
    echo "--native      the app's OWN canvas WxH; the window becomes"
    echo "              native*scale. Use this when the app has a fixed layout"
    echo "              (most things worth magnifying do): give it the canvas"
    echo "              it expects and say how much bigger you want it, rather"
    echo "              than sizing the window and hoping what is left over"
    echo "              fits. Too small a canvas CLIPS the app, and the clip is"
    echo "              then magnified, which looks like a window fighting its"
    echo "              own contents."
    echo "--fullscreen  Fill the current output instead of a window. The box"
    echo "              becomes the output mode (xrandr/wlr-randr detected)."
    echo "--filter      Upscaler: linear (default), nearest, integer, fsr, nis."
    echo "--wayland-app Target is a Wayland client (adds --expose-wayland)."
    echo ""
}

if [ $# = 0 ]; then print_help; exit 1; fi

while [ $# -gt 0 ]; do
    case $1 in
        --scale=*)      SCALE="${1#*=}"; SCALE="${SCALE%x}"; shift ;;
        --size=*)       SIZE="${1#*=}"; SIZE_SET=1; shift ;;
        --native=*)     NATIVE="${1#*=}"; shift ;;
        --filter=*)     FILTER="${1#*=}"; shift ;;
        --fullscreen)   FULLSCREEN=1; shift ;;
        --wayland-app)  WAYLAND_APP=1; shift ;;
        --)             shift; break ;;
        # NAME the offending flag before the wall of help. An unknown option
        # printed usage and exited 1, so a launcher that redirects output
        # showed the user NOTHING happening and buried the reason in a log.
        # That is exactly how a stale run-scaled meeting a newer caller
        # presents: silence.
        --*)            echo "run-scaled: unknown option: $1" >&2
                        echo "run-scaled: (an older run-scaled does not know" \
                            "a newer caller's flags)" >&2
                        print_help >&2; exit 1 ;;
        *)              break ;;
    esac
done

if [ $# -eq 0 ]; then echo "No application given!" >&2; exit 2; fi

# VALIDATE BEFORE COMPUTING. Neither of these was checked, and neither failed
# usefully: --scale=0 (or a typo like --scale=abc, which bc reads as 0) died
# with a bare "Runtime error ... Divide by zero" from bc, and --size=bogus went
# all the way through to `gamescope -W bogus -H bogus -w 0 -h 0`. A magnifier
# handed a bad number should say so, not hand the mess to gamescope.
case $SCALE in
    ''|*[!0-9.]*|.|*.*.*) echo "run-scaled: --scale must be a number, got" \
        "'$SCALE'" >&2; exit 1 ;;
esac
# Guard the divide itself, not just the shape: "0", "0.0" and "." all parse as
# numeric above and all divide by zero below.
case $(echo "$SCALE > 0" | bc 2>/dev/null) in
    1) ;;
    *) echo "run-scaled: --scale must be greater than 0, got '$SCALE'" >&2
       exit 1 ;;
esac
# _wxh <value> <flag>: the WxH shape, used by --size and --native alike.
_wxh() {
    case $1 in
        [0-9]*x[0-9]*)
            case ${1%x*}${1#*x} in
                *[!0-9]*) ;;
                *) return 0 ;;
            esac ;;
    esac
    echo "run-scaled: $2 must be WxH in pixels, got '$1'" >&2
    exit 1
}
if [ "$FULLSCREEN" -ne 1 ] && [ -z "$NATIVE" ]; then
    _wxh "$SIZE" --size
fi
if [ -n "$NATIVE" ]; then
    _wxh "$NATIVE" --native
    # REFUSE rather than pick a winner. --native and --size both determine the
    # window, and --fullscreen determines it too; silently honouring one would
    # be the same class of surprise this option exists to remove.
    if [ "$SIZE_SET" -eq 1 ]; then
        echo "run-scaled: --native and --size both set the window; give one" >&2
        exit 1
    fi
    if [ "$FULLSCREEN" -eq 1 ]; then
        echo "run-scaled: --native has nothing to set under --fullscreen," \
            "where the window is the output" >&2
        exit 1
    fi
fi
# RESOLVE gamescope, do not just trust PATH. Debian ships it in /usr/games,
# which a LOGIN shell has and a launcher generally does not: a compositor
# keybind, a .desktop entry or a systemd unit runs with
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin and nothing
# else. So "installed and works when I type it" and "fails when launched from
# the menu" are the same box, which is a miserable thing to debug.
#
# Same shape as the kbd-rgb PATH bug: a `command -v` against an inherited PATH
# decided a feature was absent when it was merely elsewhere.
GAMESCOPE_DIRS=${GAMESCOPE_DIRS:-/usr/games /usr/local/bin}
GAMESCOPE=$(command -v gamescope || true)
if [ -z "$GAMESCOPE" ]; then
    for _d in $GAMESCOPE_DIRS; do
        [ -x "$_d/gamescope" ] && { GAMESCOPE=$_d/gamescope; break; }
    done
fi
[ -n "$GAMESCOPE" ] || {
    echo "run-scaled: gamescope not found (PATH, /usr/games)" >&2; exit 4; }

# --- box (gamescope window/output) size -------------------------------------
# Windowed: the box is --size. Fullscreen: detect the output mode so the
# render/upscale ratio matches the panel (-f fills the real display anyway).
if [ "$FULLSCREEN" -eq 1 ]; then
    # Ask `hwdp geometry` -- the PUBLIC interface, the same one wb and term
    # use -- rather than reaching into the package's libexec. Fields 2 and 3
    # are the current MODE, which is what gamescope's -W/-H want.
    #
    # This used to be a third display parser living right here: wlr-randr
    # --json piped through python3 on Wayland, xrandr scraped with sed on X11,
    # which is how one repo ended up with three ways to ask one question (and
    # python3 as an undeclared dependency). One probe covers both now, and any
    # provider an integrator drops in works here for free.
    #
    # The X11 path changed meaning deliberately: the old sed read `Screen 0:
    # current WxH`, the union of every output, so a multi-head box got a box
    # spanning all of them. The first output is the right answer for a window
    # about to go fullscreen on one screen.
    read -r BOX_W BOX_H <<<"$(hwdp geometry --now \
        | awk 'NR == 1 { print $2, $3 }')"
    [ -z "$BOX_W" ] && { echo "run-scaled: could not detect output; use" \
        "--size=WxH without --fullscreen" >&2; exit 3; }
elif [ -n "$NATIVE" ]; then
    # The window is what the app needs, magnified: box = native * scale, so the
    # canvas below comes back out as exactly the native size.
    BOX_W=$(bc <<<"${NATIVE%x*} * $SCALE / 1")
    BOX_H=$(bc <<<"${NATIVE#*x} * $SCALE / 1")
else
    BOX_W="${SIZE%x*}"; BOX_H="${SIZE#*x}"
fi

# Internal render size = box / scale (integers for gamescope). This is the
# CANVAS the app is handed, and the number that actually matters: a fixed-layout
# app draws its own size into it and loses whatever does not fit.
INT_W=$(bc <<<"$BOX_W / $SCALE")
INT_H=$(bc <<<"$BOX_H / $SCALE")

# WARN, not fail: plenty of apps are happy in a small canvas, and refusing
# would be this tool deciding it knows better. But silence here is how a
# 426x266 canvas reached tuxtype, which wants 640x480, clipped two menu items
# and half its title off the edges, and then magnified the crop -- reported,
# reasonably, as "the window is fighting the scale".
if [ "${INT_W:-0}" -lt "${MIN_CANVAS%x*}" ] \
   || [ "${INT_H:-0}" -lt "${MIN_CANVAS#*x}" ]; then
    echo "run-scaled: the app gets a ${INT_W}x${INT_H} canvas, under" \
        "${MIN_CANVAS}." >&2
    echo "run-scaled: a fixed-layout app will CLIP, and the clip is what gets" \
        "magnified." >&2
    echo "run-scaled: try --native=WxH (the app's own size) instead of" \
        "--size/--scale." >&2
fi

# --- assemble gamescope invocation ------------------------------------------
GS=("$GAMESCOPE" -w "$INT_W" -h "$INT_H" -W "$BOX_W" -H "$BOX_H")
[ "$FULLSCREEN" -eq 1 ] && GS+=(-f) || GS+=(-b)   # -b: borderless window
case $FILTER in
    linear)  ;;
    nearest) GS+=(-n) ;;
    integer) GS+=(-S integer) ;;
    fsr)     GS+=(-F fsr) ;;
    nis)     GS+=(-F nis) ;;
    *) echo "run-scaled: unknown --filter=$FILTER" >&2; exit 1 ;;
esac
[ "$WAYLAND_APP" -eq 1 ] && GS+=(--expose-wayland)

# Inside gamescope's Xwayland the child is an X11 client, but a Wayland desktop
# exports toolkit hints (QT_QPA_PLATFORM=wayland, GDK_BACKEND=wayland, ...) that
# make Qt/GTK/SDL apps chase a nested Wayland the sandbox does not expose. Force
# X11 backends for the child only. --wayland-app skips this on purpose.
if [ "$WAYLAND_APP" -eq 1 ]; then
    CHILD=()
else
    CHILD=(env -u WAYLAND_DISPLAY \
        QT_QPA_PLATFORM=xcb \
        GDK_BACKEND=x11 \
        SDL_VIDEODRIVER=x11 \
        CLUTTER_BACKEND=x11 \
        MOZ_ENABLE_WAYLAND=0)
fi

exec "${GS[@]}" -- "${CHILD[@]}" "$@"
