#!/usr/bin/env python3
"""hwdp gdesk: the desk tool, in a window (GTK 4 and libadwaita).

`hwdp gdesk` lands here; `hwdp gdesk <desk>` too, for a desk by name
(`hwdp desks`), which away from its panels is loaded from its files and
saved back to them without applying. The same desk tool as `hwdp desk`,
four tabs over one desk:

  PHYSICAL, the layout, drawn to scale
    click, Tab    highlight a monitor       drag  move it: it stays where it
                                                  touches another, and pulls
                                                  in to any alignment nearby
    Enter         select the highlighted one to move, or put it down (or
                  double-click); selected, the arrows step it (shift+arrow
                  one pixel) and a drag carries it. A drag selects it too,
                  and it STAYS selected when the button is let go, so the
                  arrows fine-tune it; a click on nothing puts it down
    r             rotate it a quarter turn  w     swap (mark, then swap)
    o             switch it off / back on   i     a label on every monitor
    p             preview live, with a countdown that reverts unless kept
  SURFACES, the names: each with its label and where it is at this desk
    a             add one                   e     its label (or double-click)
    D             delete it (from every desk's list; asked first)
  VIRTUAL, the grid: a miniature of the desk in every workspace cell
    click         select a spot (a panel, or half of one, in a cell)
    drag a name   from the list beside the grid onto a spot: placed there
    Enter         pick the name for the spot (or double-click it)
    g             cut the panel in this cell: whole, top-bottom, left-right
    shift+arrows  move the cell's column left or right, or its row up or
                  down (it trades places with its neighbour); t turns the
                  grid, columns becoming rows. Everything a cell holds goes
                  with it: surfaces, cuts, and the wallpaper it shows
    A             ARRANGE: every workspace a tile to lay out freely, any
                  shape: drag one (or pick a place and shift+arrows) and it
                  lands on a row and column, swapping with a tile there;
                  d deletes one (asked first when it holds something);
                  Enter commits, evened out into a grid; Esc cancels
    x             clear the spot            f / F  the default / none
    b             the cell's wallpaper      + - ] [  columns and rows
                  (the picker shows each image; every cell with one shows
                  it cut across the panels the way the session cuts it,
                  the integrator's default too where the desk sets none)
  REVIEW, the map as it will be saved, and what is missing from it
  everywhere
    1 - 4         the tabs
    Ctrl+S or s   save, and keep editing
    Esc           back out of what is in progress (undo a move or drag, drop
                  the mark); with nothing in progress, the quit prompt
    q or closing  quit; with unsaved changes it asks first

THIS FILE ONLY DRAWS. What a key, a click or a drag means (the App), the
desk as data, the words both views say and every call out to hwdp live in
lib/hwdp_desk, shared with the terminal tool, so the two cannot disagree
about what a desk is or how it is saved.
"""
import hashlib
import itertools
import os
import queue
import re
import shutil
import sys
import threading
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.environ.get("HWDP_LIB") or os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from hwdp_desk.controller import App, ESC, key_code     # noqa: E402
from hwdp_desk.hwdp import Hwdp, OfflineHwdp, desk_lock # noqa: E402
from hwdp_desk.model import (                           # noqa: E402
    HALVES, NEAR, REGION_OF, Desk, near_misses, slicer_layout, slicer_name)
from hwdp_desk.words import (                           # noqa: E402
    arrange_words, cell_words, covered, deltile_words, delname_words,
    error_lines, label_of, mark_of, pick_words, review_lines,
    selection_words, unsplit_words, where_words)

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import (Adw, Gdk, GdkPixbuf, Gio, GLib, GObject, Gtk,
                               Pango, PangoCairo)
    GTK_WHY = ""
except (ImportError, ValueError) as e:      # said by main, not here
    GTK_WHY = str(e)
try:
    import cairo            # the preview's slices; without it, none drawn
except ImportError:
    cairo = None

# THE WINDOW'S app_id IS A PUBLISHED CONTRACT: an integrator's window rule
# (sticky, always on top) matches on it, and the title is no key, since it
# names the desk. Changing it silently breaks every such rule, so it does
# not change; `hwdp gdesk --app-id` prints it for a rule to be made from.
APP_ID = "io.github.jello_d.hwdp.gdesk"
TABS = ("physical", "surfaces", "virtual", "review")    # app.tab's order
MARGIN = 32         # widget pixels around a drawing
TRAY = 56           # the strip under it for the monitors switched off
REACH = 12          # widget pixels within which a drag pulls in to align
SLOP = 4            # widget pixels a press may wander and still be a click
CELL_GAP = 10       # between the virtual tab's cells
CELL_HEAD = 22      # a cell's own line: where it is, its wallpaper
ENTER = 10
TICK_MS = 100
PREVIEW_SPAN = 960  # the whole desk this many pixels across, for slices
PREVIEW_WAIT = 400  # ms of no change before a preview is cut
THUMB = (128, 72)   # the picker's thumbnails
KEEP_LAYOUTS = 16   # slice sets kept, one per desk geometry, newest first
KEEP_THUMBS = 2000  # thumbnails kept, newest first
SLICE_ALPHA = 0.5   # a cell's wallpaper, faint, so the names stand out
LIT_ALPHA = 1.0     # ... and the selected spot's part of it, whole (its
                    # label has a backing; 75% read too close to 50%)
FRACTION = {r: f for f, r in REGION_OF.items()}         # region -> x y w h


# --- the frames: logical pixels to widget pixels -----------------------------
# Pure, so a test reads them without a display.

def frame(outs, w, h, room=None):
    """(scale, ox, oy, minx, miny) fitting the outputs that are on into a
    W x H widget, with room under them for the ones that are off. With
    ROOM, an output being dragged: fit the others with its size spare on
    every side, which is everywhere a drop can land (it always touches one
    of them), so it never leaves the drawing."""
    on = [o for o in outs if o.on and o is not room] or outs
    pw, ph = (room.w, room.h) if room else (0, 0)
    minx, miny = min(o.x for o in on) - pw, min(o.y for o in on) - ph
    bw = max(o.x + o.w for o in on) + pw - minx
    bh = max(o.y + o.h for o in on) + ph - miny
    tray = TRAY if any(not o.on for o in outs) else 0
    aw, ah = max(1, w - 2 * MARGIN), max(1, h - 2 * MARGIN - tray)
    scale = min(aw / bw, ah / bh)
    ox = MARGIN + (aw - bw * scale) / 2
    oy = MARGIN + (ah - bh * scale) / 2
    return scale, ox, oy, minx, miny


def box(o, fr):
    """Output O's rectangle in widget pixels, (x, y, w, h)."""
    scale, ox, oy, minx, miny = fr
    return (ox + (o.x - minx) * scale, oy + (o.y - miny) * scale,
            o.w * scale, o.h * scale)


def tray_boxes(outs, w, h):
    """[(index, (x, y, w, h))] for the outputs that are off, in a row along
    the bottom of a W x H widget."""
    off = [i for i, o in enumerate(outs) if not o.on]
    bw, gap = 120, 12
    x = (w - len(off) * bw - (len(off) - 1) * gap) / 2
    found = []
    for i in off:
        found.append((i, (x, h - MARGIN / 2 - TRAY + 8, bw, TRAY - 16)))
        x += bw + gap
    return found


def inside(px, py, r):
    return r[0] <= px <= r[0] + r[2] and r[1] <= py <= r[1] + r[3]


def hit(outs, fr, w, h, px, py):
    """The index of the output under widget point (PX, PY), or None."""
    rects = [(i, box(o, fr)) for i, o in enumerate(outs) if o.on]
    for i, r in rects + tray_boxes(outs, w, h):
        if inside(px, py, r):
            return i
    return None


def vframe(app, w, h, dims=None):
    """The virtual tab's frame: every cell the same size, each holding the
    desk at one scale, as a dict (cw, ch: a cell's pitch; s: the scale;
    minx, miny, bw, bh: the desk's logical bounds). DIMS, (columns, rows),
    when it is not the grid (an arrangement's lattice)."""
    on = app.desk.on()
    gw, gh = dims or app.grid
    minx, miny = min(o.x for o in on), min(o.y for o in on)
    bw = max(o.x + o.w for o in on) - minx
    bh = max(o.y + o.h for o in on) - miny
    cw, ch = (w - 2 * MARGIN) / gw, (h - 2 * MARGIN) / gh
    iw = max(1, cw - CELL_GAP - 12)
    ih = max(1, ch - CELL_GAP - CELL_HEAD - 8)
    return {"cw": cw, "ch": ch, "s": min(iw / bw, ih / bh), "minx": minx,
            "miny": miny, "bw": bw, "bh": bh}


def cell_rect(vf, cx, cy):
    return (MARGIN + cx * vf["cw"], MARGIN + cy * vf["ch"],
            vf["cw"] - CELL_GAP, vf["ch"] - CELL_GAP)


def vbox(vf, cx, cy, o):
    """Output O's rectangle in cell (cx, cy), in widget pixels."""
    x, y, w, h = cell_rect(vf, cx, cy)
    s = vf["s"]
    ox = x + (w - vf["bw"] * s) / 2
    oy = y + CELL_HEAD + (h - CELL_HEAD - vf["bh"] * s) / 2
    return (ox + (o.x - vf["minx"]) * s, oy + (o.y - vf["miny"]) * s,
            o.w * s, o.h * s)


def part(region, r):
    """REGION's rectangle inside rectangle R."""
    fx, fy, fw, fh = FRACTION[region]
    return (r[0] + fx * r[2], r[1] + fy * r[3], fw * r[2], fh * r[3])


def vhit(app, w, h, px, py):
    """(cx, cy, output, region) under widget point (PX, PY) in the virtual
    tab: the half of a panel when it is cut in that cell, the whole panel
    when not, (cx, cy, None, None) between panels; None outside every
    cell."""
    vf = vframe(app, w, h)
    for cy in range(app.grid[1]):
        for cx in range(app.grid[0]):
            if not inside(px, py, cell_rect(vf, cx, cy)):
                continue
            for o in app.desk.on():
                b = vbox(vf, cx, cy, o)
                if not inside(px, py, b):
                    continue
                for rg in HALVES[app.split_at(o, cx, cy)]:
                    if inside(px, py, part(rg, b)):
                        return cx, cy, o, rg
            return cx, cy, None, None
    return None


def arr_dims(app):
    """An arrangement's lattice: (x0, y0) its first place, (nx, ny) its
    size, the tiles and the ring round them."""
    x0, y0, x1, y1 = app.arr_extent()
    return (x0, y0), (x1 - x0 + 1, y1 - y0 + 1)


def arr_hit(app, w, h, px, py):
    """The lattice place under widget point (PX, PY), or None."""
    (x0, y0), dims = arr_dims(app)
    vf = vframe(app, w, h, dims)
    for ix in range(dims[0]):
        for iy in range(dims[1]):
            if inside(px, py, cell_rect(vf, ix, iy)):
                return x0 + ix, y0 + iy
    return None


# --- the cache: what makes a second look fast ---------------------------------
# ~/.cache/hwdp/gdesk holds what is slow to make and stable across edits:
# thumbs/, one small PNG per image, named by the image's path, mtime, size
# and the thumbnail size (an edited image is a new name; the old one ages
# out); slices/<layout>/, the slicer's cut of every wallpaper for ONE desk
# geometry, so going back to a layout (an undone rotation) cuts nothing.
# Both are pruned to the newest KEEP_*, and pruning touches only names of
# the shape this writes, inside these directories.

def cache_root():
    return os.path.join(os.environ.get("XDG_CACHE_HOME") or
                        os.path.expanduser("~/.cache"), "hwdp", "gdesk")


def thumb_file(path):
    """Where PATH's thumbnail is kept (OSError when PATH is gone)."""
    st = os.stat(path)
    key = "%s\0%d\0%d\0%dx%d" % ((path, st.st_mtime_ns, st.st_size)
                                   + THUMB)
    return os.path.join(cache_root(), "thumbs",
                        hashlib.sha1(key.encode()).hexdigest()[:24] + ".png")


def layout_dir(layout):
    """Where the cut for LAYOUT (slicer_layout's text) is kept."""
    return os.path.join(cache_root(), "slices",
                        hashlib.sha1(layout.encode()).hexdigest()[:16])


def prune(sub, keep, pattern):
    """Keep the KEEP newest entries of cache_root()/SUB whose names match
    PATTERN; remove the rest. Newest by mtime: a use touches an entry."""
    base = os.path.join(cache_root(), sub)
    try:
        names = [n for n in os.listdir(base) if re.fullmatch(pattern, n)]
        names.sort(key=lambda n: os.path.getmtime(os.path.join(base, n)),
                   reverse=True)
    except OSError:
        return
    for n in names[keep:]:
        old = os.path.join(base, n)
        try:
            if os.path.isdir(old) and not os.path.islink(old):
                shutil.rmtree(old)
            else:
                os.remove(old)
        except OSError:
            pass                    # another may have taken it: no matter


def touch(path):
    try:
        os.utime(path)
    except OSError:
        pass


def banner_text(desk):
    """The one warning the drawing carries, in the terminal tool's words,
    or "" when the desk is sound."""
    if desk.faults():
        return "the monitors do not meet edge to edge"
    gaps = near_misses(desk, NEAR)
    if gaps:
        return "  ".join("%dpx gap between %s and %s" % (g, a, b)
                         for a, b, g in gaps) + \
            " (the pointer cannot cross it)"
    return ""


# --- drawing -----------------------------------------------------------------

def rgba(c, alpha=None):
    return (c.red, c.green, c.blue, c.alpha if alpha is None else alpha)


def rounded(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
    cr.arc(x + r, y + r, r, 3.1416, 4.7124)
    cr.close_path()


def layout(cr, s, size, bold):
    lay = PangoCairo.create_layout(cr)
    lay.set_font_description(Pango.FontDescription.from_string(
        "Sans %s%d" % ("Bold " if bold else "", size)))
    lay.set_text(s, -1)
    return lay


def text(cr, s, x, y, w, size, bold, colour):
    """S centred in width W at Y; returns the height it took (0 when it
    does not fit, and then draws nothing)."""
    lay = layout(cr, s, size, bold)
    tw, th = lay.get_pixel_size()
    if tw > w - 8:
        return 0
    cr.set_source_rgba(*colour)
    cr.move_to(x + (w - tw) / 2, y)
    PangoCairo.show_layout(cr, lay)
    return th


def fit(cr, s, r, colour, bold=True, sizes=(11, 9, 8), align=0.5,
        back=None):
    """S in rectangle R at the largest of SIZES that fits it whole, else at
    the smallest cut with an ellipsis (the line under the drawing says it
    in full). ALIGN places it across: 0 left, 0.5 centred, 1 right. BACK,
    a colour, is a backing behind it (over a picture)."""
    x, y, w, h = r
    for size in sizes:
        lay = layout(cr, s, size, bold)
        tw, th = lay.get_pixel_size()
        if tw <= w - 6 and th <= h:
            break
    else:
        lay.set_width(int(max(1, w - 6) * Pango.SCALE))
        lay.set_ellipsize(Pango.EllipsizeMode.END)
        tw, th = lay.get_pixel_size()
        if th > h or w < 12:
            return
    tx, ty = x + 3 + (w - 6 - tw) * align, y + (h - th) / 2
    if back:
        rounded(cr, tx - 4, ty - 1, tw + 8, th + 2, 4)
        cr.set_source_rgba(*back)
        cr.fill()
    cr.set_source_rgba(*colour)
    cr.move_to(tx, ty)
    PangoCairo.show_layout(cr, lay)


def paint(cr, img, b, alpha=SLICE_ALPHA, only=None):
    """Slice IMG stretched into box B: a slice is the output's logical
    rectangle already, so this only scales it. ONLY, a rectangle, paints
    just that part of it."""
    cr.save()
    rounded(cr, b[0], b[1], b[2], b[3], 3)
    cr.clip()
    if only:
        cr.rectangle(*only)
        cr.clip()
    cr.translate(b[0], b[1])
    cr.scale(b[2] / img.get_width(), b[3] / img.get_height())
    cr.set_source_surface(img, 0, 0)
    cr.paint_with_alpha(alpha)
    cr.restore()


def draw_output(cr, app, i, rect, fg, accent):
    """One monitor: HIGHLIGHTED (where Tab and a click land) is an accent
    outline; SELECTED to move is filled with the accent as well."""
    o = app.desk.outs[i]
    x, y, w, h = rect
    sel, moving = i == app.sel, app.moving and app.moving[0] is o
    fill = rgba(accent, 0.55) if moving else \
        rgba(fg, 0.10 if sel else 0.07 if o.on else 0.03)
    rounded(cr, x + 2, y + 2, w - 4, h - 4, 8)
    cr.set_source_rgba(*fill)
    cr.fill_preserve()
    cr.set_line_width(4 if moving else 2.5 if sel else 1.5)
    if app.mark is o:
        cr.set_dash([8, 5])
        cr.set_source_rgba(*rgba(accent))
    else:
        cr.set_dash([] if o.on else [4, 4])
        cr.set_source_rgba(*(rgba(accent) if sel else rgba(fg, 0.5)))
    cr.stroke()
    cr.set_dash([])
    lines = [(o.label, 13, True)]
    if o.on:
        lines += [("%d×%d" % (o.w, o.h), 10, False),
                  ("%s  %s°" % (o.token(), o.degrees()), 9, False)]
    if moving:
        lines += [("moving: Enter puts it down", 9, True)]
    ty = y + max(8, h / 2 - 9 * len(lines))
    for s, size, bold in lines:
        took = text(cr, s, x, ty, w, size, bold, rgba(fg, 0.9))
        ty += took + 2


def draw_cut(cr, sp, b, fg):
    """A panel cut in a cell: a dashed line between its halves."""
    cr.set_dash([3, 3])
    cr.set_line_width(1)
    cr.set_source_rgba(*rgba(fg, 0.5))
    r = part(HALVES[sp][0], b)
    if sp == "top-bottom":
        cr.move_to(b[0], r[1] + r[3])
        cr.line_to(b[0] + b[2], r[1] + r[3])
    else:
        cr.move_to(r[0] + r[2], b[1])
        cr.line_to(r[0] + r[2], b[1] + b[3])
    cr.stroke()
    cr.set_dash([])


def draw_panel(cr, app, o, cx, cy, b, lit, fg, accent, img=None):
    """One panel in one cell: its slice of the cell's wallpaper (IMG), its
    surfaces in their parts, the cut, the default where nothing claims it,
    and LIT (a region) the selection.

    WITH A WALLPAPER the picture carries it all, on the plain background:
    faint (SLICE_ALPHA), surfaces untinted so no colour sits on it, and the
    selected spot's part at full strength (LIT_ALPHA) with a thin outline,
    which a dark or even picture needs to show the spot at all. Without one
    the accent tints say which parts are placed and which is selected."""
    if img is not None:
        paint(cr, img, b)
        if lit:
            # Over the faint pass: 1 - (1 - a)(1 - x) = LIT_ALPHA.
            paint(cr, img, b, 1 - (1 - LIT_ALPHA) / (1 - SLICE_ALPHA),
                  part(lit, b))
    rounded(cr, b[0], b[1], b[2], b[3], 3)
    cr.set_source_rgba(*rgba(fg, 0.0 if img is not None else 0.07))
    cr.fill_preserve()
    cr.set_line_width(1)
    cr.set_source_rgba(*rgba(fg, 0.35))
    cr.stroke()
    back = (0, 0, 0, 0.35) if img is not None else None
    ink = rgba(fg, 0.95)
    sp = app.split_at(o, cx, cy)
    if sp:
        draw_cut(cr, sp, b, fg)
    for x in app.surfaces:
        if x.conn != o.conn or (x.cx, x.cy) != (cx, cy):
            continue
        r = part(x.region, b)
        if img is None:
            rounded(cr, r[0] + 2, r[1] + 2, r[2] - 4, r[3] - 4, 3)
            cr.set_source_rgba(*rgba(accent,
                                     0.5 if x.region == lit else 0.22))
            cr.fill()
        fit(cr, label_of(app, x.name), r, ink, back=back)
    claimed, whole = covered(app, o, cx, cy)
    d = app.default
    if not whole and d and d.conn == o.conn and d.region not in claimed:
        fit(cr, "(%s)" % label_of(app, d.name), part(d.region, b),
            ink if back else rgba(fg, 0.45), bold=False, back=back)
    if lit:
        r = part(lit, b)
        rounded(cr, r[0] + 1, r[1] + 1, r[2] - 2, r[3] - 2, 3)
        cr.set_line_width(1.5 if img is not None else 2.5)
        cr.set_source_rgba(*rgba(accent))
        cr.stroke()


def draw_cell(cr, app, vf, cx, cy, fg, accent, cut=None, at=None,
              cur=None):
    """Cell (cx, cy) drawn at its own place, or at AT (an index into the
    frame) when an arrangement has moved it; CUR lights it, and only the
    grid lights a spot inside it."""
    ix, iy = at or (cx, cy)
    if cur is None:
        cur = [cx, cy] == app.vcell
    x, y, w, h = cell_rect(vf, ix, iy)
    rounded(cr, x, y, w, h, 8)
    cr.set_source_rgba(*rgba(fg, 0.03))
    cr.fill_preserve()
    cr.set_line_width(2 if cur else 1)
    cr.set_source_rgba(*(rgba(accent) if cur else rgba(fg, 0.18)))
    cr.stroke()
    head = (x + 4, y + 2, w - 8, CELL_HEAD - 2)
    fit(cr, "%d,%d" % (cx, cy), head, rgba(fg, 0.6), sizes=(9,), align=0)
    wall, own = app.wall_at((cx, cy))
    if wall:
        fit(cr, wall if own else "(default) " + wall,
            (x + w / 3, y + 2, w * 2 / 3 - 4, CELL_HEAD - 2),
            rgba(fg, 0.5 if own else 0.35), bold=False, sizes=(8,), align=1)
    sel_o, sel_r = app.vspot()
    for o in app.desk.on():
        draw_panel(cr, app, o, cx, cy, vbox(vf, ix, iy, o),
                   sel_r if cur and o is sel_o and at is None else None,
                   fg, accent, (cut or {}).get((cx, cy, slicer_name(o))))


def draw_arrangement(cr, app, w, h, fg, accent, cut, hover):
    """An ARRANGEMENT: every tile drawn as its cell, where the draft has
    put it; every empty place of the lattice a dashed outline to drop
    into; the selected place lit, and HOVER (a drag's target) outlined."""
    (x0, y0), dims = arr_dims(app)
    vf = vframe(app, w, h, dims)
    for ix in range(dims[0]):
        for iy in range(dims[1]):
            pos = (x0 + ix, y0 + iy)
            cell = app.arr["at"].get(pos)
            sel = pos == app.arr["sel"]
            if cell is not None:
                draw_cell(cr, app, vf, cell[0], cell[1], fg, accent, cut,
                          at=(ix, iy), cur=sel)
            else:
                r = cell_rect(vf, ix, iy)
                rounded(cr, r[0], r[1], r[2], r[3], 8)
                cr.set_dash([5, 5])
                cr.set_line_width(2 if sel else 1)
                cr.set_source_rgba(*(rgba(accent) if sel else
                                     rgba(fg, 0.15)))
                cr.stroke()
                cr.set_dash([])
            if pos == hover:
                r = cell_rect(vf, ix, iy)
                rounded(cr, r[0] - 3, r[1] - 3, r[2] + 6, r[3] + 6, 10)
                cr.set_line_width(3)
                cr.set_source_rgba(*rgba(accent, 0.8))
                cr.stroke()


def colours(area):
    return area.get_color(), \
        Adw.StyleManager.get_default().get_accent_color_rgba()


# --- the wallpapers: the cells' slices, and the picker's thumbnails ----------

CUT_LOCK = threading.Lock()     # one slicer at a time in the cache


class Slices:
    """Wallpapers on the desk AS EDITED, small, cut by wallpaper-slicer the
    way the session's are (WALLPAPER_SLICER_LAYOUT), in the background,
    into the cache (a directory per layout, see layout_dir). WALLS says
    what to cut ({cell: file}), LANDED is called when a cut arrives. Cut
    again once the layout and WALLS have held still for WAIT ms; an image
    already cut for this layout costs nothing."""

    def __init__(self, win, walls, landed, wait=PREVIEW_WAIT):
        self.win, self.cut, self.why = win, {}, ""
        self.walls, self.landed, self.wait = walls, landed, wait
        self.want = self.timer = None
        self.running = False

    def key(self):
        return (tuple(slicer_layout(self.win.app.desk, PREVIEW_SPAN)),
                tuple(sorted(self.walls().items())))

    def refresh(self):
        k = self.key()
        if k == self.want or cairo is None:
            return
        self.want = k
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(self.wait, self._start)

    def _start(self):
        self.timer = None
        if not self.running:
            self.running = True
            threading.Thread(target=self._work, args=(self.want,),
                             daemon=True).start()
        return GLib.SOURCE_REMOVE

    def _work(self, k):
        # Whatever happens here is SAID: a worker that died in silence
        # would leave the preview running forever and never cut again.
        layout = "\n".join(k[0]) + "\n"
        try:
            with CUT_LOCK:
                outdir = layout_dir(layout)
                os.makedirs(outdir, exist_ok=True)
                touch(outdir)
                found, why = self.win.app.hw.slice_preview(
                    dict(k[1]), layout, outdir)
                prune("slices", KEEP_LAYOUTS, r"[0-9a-f]{16}")
        except Exception as e:
            found, why = {}, "the cut raised %r" % e
        imgs = {}
        for spot, path in found.items():
            try:
                imgs[spot] = cairo.ImageSurface.create_from_png(path)
            except (cairo.Error, OSError) as e:
                why = why or "%s: %s" % (path, e)
        GLib.idle_add(self._landed, k, imgs, why)

    def _landed(self, k, imgs, why):
        self.running = False
        if k == self.want:
            self.cut, self.why = imgs, why
            self.landed()
        else:
            self._start()           # it changed while that cut ran
        return GLib.SOURCE_REMOVE


class Thumbs:
    """The picker's thumbnails, decoded off the main thread and kept for
    the session; a row gets its picture when it lands.

    A FEW decoders working through the rows IN ORDER, so the visible
    ones come first. Measured on 82 real wallpapers: a thread per image
    showed nothing for 1.6s (all of them competing) and one at a time took
    11s for the list; neither loses an image. One that fails shows an icon
    saying so, its reason in the tooltip, never a blank square.

    Each is KEPT in the cache (thumb_file), so a later window reads a small
    PNG instead of decoding the image; WARM queues every image behind any
    row that is waiting, so the picker is ready before it is opened."""
    WORKERS = 3

    def __init__(self):
        self.done, self.waiting = {}, {}
        self.todo = queue.PriorityQueue()
        self.order = itertools.count()
        self.workers = []

    def _queue(self, path, prio):
        self.todo.put((prio, next(self.order), path))
        while len(self.workers) < self.WORKERS:
            t = threading.Thread(target=self._run, daemon=True)
            t.start()
            self.workers.append(t)

    def warm(self, paths):
        """Make every PATH's thumbnail ready, behind anything waited on."""
        for p in paths:
            if p not in self.done:
                self._queue(p, 1)

    def into(self, path, picture):
        if path in self.done:
            self._show(picture, *self.done[path])
            return
        if path in self.waiting:
            self.waiting[path].append(picture)
            return
        self.waiting[path] = [picture]
        self._queue(path, 0)

    def _run(self):
        while True:
            self._load(self.todo.get()[2])

    @staticmethod
    def _show(picture, tex, why):
        if tex is None:
            tex = Gtk.IconTheme.get_for_display(
                picture.get_display()).lookup_icon(
                "image-missing-symbolic", None, 48, 1,
                Gtk.TextDirection.NONE, 0)
            picture.set_content_fit(Gtk.ContentFit.SCALE_DOWN)
            picture.set_tooltip_text("no thumbnail: %s" % why)
        picture.set_paintable(tex)

    def _load(self, path):
        """From the cache when it is there, else decoded at twice THUMB
        (crisp on a scaled panel), cropped to exactly that, covering it,
        so every row's picture is one size whatever the image's own shape,
        and kept."""
        # The texture is made from PNG BYTES: a kept thumbnail already is
        # one, and Gdk.Texture.new_for_pixbuf is deprecated (it warned on
        # every window, 2026-11-20).
        try:
            kept = thumb_file(path)
            with open(kept, "rb") as fh:
                data = fh.read()
            touch(kept)
            GLib.idle_add(self._landed, path, data, "")
            return
        except OSError:
            pass
        pb, why = self._decode(path)
        data = None
        if pb is not None:
            try:
                data = pb.save_to_bufferv("png", [], [])[1]
                kept = thumb_file(path)
                os.makedirs(os.path.dirname(kept), exist_ok=True)
                with open(kept + ".new", "wb") as fh:
                    fh.write(data)
                os.replace(kept + ".new", kept)
            except (OSError, GLib.Error):
                pass                # shown anyway; kept next time
        GLib.idle_add(self._landed, path, data, why)

    @staticmethod
    def _decode(path):
        tw, th = THUMB[0] * 2, THUMB[1] * 2
        try:
            info, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
            if info is None or w <= 0 or h <= 0:
                raise TypeError("not an image this box can read")
            k = max(tw / w, th / h)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                path, max(tw, round(w * k)), max(th, round(h * k)), False)
            pb, why = pb.new_subpixbuf((pb.get_width() - tw) // 2,
                                       (pb.get_height() - th) // 2,
                                       tw, th), ""
        except (GLib.Error, TypeError, ZeroDivisionError) as e:
            pb, why = None, str(e) or "unreadable"
        return pb, why

    def _landed(self, path, data, why):
        tex = None
        if data:
            try:
                tex = Gdk.Texture.new_from_bytes(GLib.Bytes.new(data))
            except GLib.Error as e:
                why = why or str(e)
        self.done[path] = (tex, why)
        for pic in self.waiting.pop(path, []):
            self._show(pic, tex, why)
        return GLib.SOURCE_REMOVE


# --- the physical tab --------------------------------------------------------

class DeskView:
    """The PHYSICAL drawing: every output to scale, dragged with the
    pointer. The App decides; this only maps pixels to logical pixels."""

    def __init__(self, win):
        self.win = win
        self.area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.area.set_draw_func(self._draw)
        self.frozen = None      # the frame held still while dragging
        self.pressed = None     # the output a press landed on
        self.start = None       # the grabbed output's (x, y) at the grab
        self.moved = False      # past SLOP: a drag, not a click
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self.on_begin)
        drag.connect("drag-update", self.on_update)
        drag.connect("drag-end", self.on_end)
        self.area.add_controller(drag)
        twice = Gtk.GestureClick()
        twice.connect("pressed", self.on_click)
        self.area.add_controller(twice)

    def fr(self):
        if self.moved:
            return self.frozen
        return frame(self.win.app.desk.outs, self.area.get_width(),
                     self.area.get_height())

    def on_begin(self, gesture, px, py):
        """A press HIGHLIGHTS what it lands on (on nothing, puts down the
        selected one); it becomes a drag only past SLOP."""
        app = self.win.app
        i = hit(app.desk.outs, self.fr(), self.area.get_width(),
                self.area.get_height(), px, py)
        if i is None:
            app.release()
        if i is None or not app.highlight(i):
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            self.win.sync()
            return
        self.pressed, self.start, self.moved = i, None, False
        self.win.sync()

    def on_update(self, gesture, dx, dy):
        app = self.win.app
        if self.pressed is None or (not self.moved and
                                    dx * dx + dy * dy < SLOP * SLOP):
            return
        if not self.start:
            if not app.grab(self.pressed):
                self.pressed = None
                return
            self.frozen = frame(app.desk.outs, self.area.get_width(),
                                self.area.get_height(), room=app.cur)
            self.start = (app.cur.x, app.cur.y)
        self.moved = True
        scale = self.frozen[0]
        self.win.app.drag_to(self.start[0] + dx / scale,
                             self.start[1] + dy / scale, REACH / scale)
        self.win.sync()

    def on_end(self, gesture, dx, dy):
        if self.start:
            self.win.app.drop()
        self.frozen = self.start = self.pressed = None
        self.moved = False
        self.win.sync()

    def on_click(self, gesture, n, px, py):
        """A double-click on a monitor: Enter on IT, in or out of selected
        (highlighted here, since nothing orders this gesture after the
        drag's press)."""
        app = self.win.app
        i = hit(app.desk.outs, self.fr(), self.area.get_width(),
                self.area.get_height(), px, py)
        if n == 2 and i is not None and app.highlight(i):
            self.win.press(ENTER)

    def _draw(self, area, cr, w, h):
        app = self.win.app
        fg, accent = colours(area)
        fr = self.fr()
        for i, o in enumerate(app.desk.outs):
            if o.on:
                draw_output(cr, app, i, box(o, fr), fg, accent)
        for i, rect in tray_boxes(app.desk.outs, w, h):
            draw_output(cr, app, i, rect, fg, accent)


# --- the surfaces tab: the names ---------------------------------------------

class NamesPage:
    """Every name, its label and where it is at this desk; the App's
    selected one selected. Rebuilt only when what it shows changes."""

    def __init__(self, win):
        self.win, self.shown, self.quiet = win, None, False
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.list.add_css_class("boxed-list")
        self.list.set_placeholder(Gtk.Label(
            label="No names yet: Add makes one", margin_top=24,
            margin_bottom=24))
        self.list.connect("row-selected", self.on_selected)
        self.list.connect("row-activated",
                          lambda *_: self.win.press(ord("e")))
        clamp = Adw.Clamp(child=self.list, maximum_size=760, margin_top=24,
                          margin_bottom=24, margin_start=12, margin_end=12,
                          valign=Gtk.Align.START)
        self.widget = Gtk.ScrolledWindow(child=clamp, vexpand=True)

    def on_selected(self, lb, row):
        if row is not None and not self.quiet:
            self.win.app.side = row.get_index()
            self.win.sync()

    def sync(self):
        app = self.win.app
        now = [(n, lab, mark_of(app, n)[0], where_words(app, n))
               for n, lab in app.names]
        self.quiet = True
        if now != self.shown:
            self.shown = now
            self.list.remove_all()
            for n, lab, mk, at in now:
                row = Adw.ActionRow(title=lab, subtitle="%s · %s" % (n, at),
                                    use_markup=False, activatable=True)
                row.add_prefix(Gtk.Label(label=mk, width_chars=2))
                self.list.append(row)
        row = self.list.get_row_at_index(app.side)
        if row is not None and self.list.get_selected_row() is not row:
            self.list.select_row(row)
        self.quiet = False


# --- the virtual tab: the grid, and the names to drag onto it ----------------

class GridPage:
    """The grid of desk miniatures, the names beside it to drag onto a
    spot, and the selection in full under it."""

    def __init__(self, win):
        self.win, self.shown = win, None
        self.slices = Slices(win, self.shown_walls, self._landed)
        self.area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.area.set_draw_func(self._draw)
        click = Gtk.GestureClick()
        click.connect("pressed", self.on_press)
        self.area.add_controller(click)
        self.dragging = self.hover = None   # an arrangement's drag
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self.on_tile_begin)
        drag.connect("drag-update", self.on_tile_update)
        drag.connect("drag-end", self.on_tile_end)
        self.area.add_controller(drag)
        drop = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.COPY)
        drop.connect("motion", self.on_motion)
        drop.connect("drop", self.on_drop)
        self.area.add_controller(drop)
        self.names = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.names.add_css_class("navigation-sidebar")
        self.names.connect("row-activated", self.on_name)
        side = Gtk.ScrolledWindow(child=self.names, width_request=200,
                                  hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.sel = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.sel.add_css_class("heading")
        self.cell = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.cell.add_css_class("dim-label")
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                      margin_bottom=8, margin_start=MARGIN, hexpand=True)
        col.append(self.area)
        col.append(self.sel)
        col.append(self.cell)
        self.widget = Gtk.Box()
        self.widget.append(col)
        self.widget.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        self.widget.append(side)

    def at(self, x, y):
        return vhit(self.win.app, self.area.get_width(),
                    self.area.get_height(), x, y)

    def place_at(self, x, y):
        return arr_hit(self.win.app, self.area.get_width(),
                       self.area.get_height(), x, y)

    # An arrangement: a press picks a place, a drag carries a tile there.
    def on_tile_begin(self, gesture, x, y):
        app = self.win.app
        pos = self.place_at(x, y) if app.arr is not None else None
        if pos is None or pos not in app.arr["at"] or self.win.alert:
            gesture.set_state(Gtk.EventSequenceState.DENIED)
            return
        self.dragging, self.hover = pos, pos
        self.start = (x, y)

    def on_tile_update(self, gesture, dx, dy):
        if self.dragging is not None:
            self.hover = self.place_at(self.start[0] + dx,
                                       self.start[1] + dy)
            self.area.queue_draw()

    def on_tile_end(self, gesture, dx, dy):
        app = self.win.app
        if self.dragging is not None and self.hover is not None and \
                app.arr is not None:
            app.arr_put(self.dragging, self.hover)
        self.dragging = self.hover = None
        self.win.sync()

    def on_press(self, gesture, n, x, y):
        app = self.win.app
        if app.arr is not None:
            pos = self.place_at(x, y)
            if pos is not None and not self.win.alert:
                app.arr["sel"] = pos
                self.win.sync()
            return
        spot = self.at(x, y)
        if spot is None or self.win.alert or self.win.app.busy:
            return
        self.win.app.select_spot(*spot)
        if n == 2 and spot[2] is not None:
            self.win.press(ENTER)       # the picker, as Enter opens it
        self.win.sync()

    def on_motion(self, target, x, y):
        if self.win.app.arr is not None:
            return 0
        spot = self.at(x, y)
        if spot is None or spot[2] is None:
            return 0
        self.win.app.select_spot(*spot)
        self.win.sync()
        return Gdk.DragAction.COPY

    def on_drop(self, target, name, x, y):
        if self.win.app.arr is not None:
            return False
        spot = self.at(x, y)
        if spot is None or spot[2] is None or self.win.alert:
            return False
        self.win.app.select_spot(*spot)
        self.win.app.place(name)
        self.win.sync()
        return True

    def on_name(self, lb, row):
        """A name activated in the list goes on the selected spot."""
        self.win.app.place(self.win.app.names[row.get_index()][0])
        self.win.sync()

    def _row(self, n, lab, mk, used):
        row = Gtk.Box(spacing=8, margin_top=4, margin_bottom=4)
        row.append(Gtk.Label(label=mk, width_chars=2))
        name = Gtk.Label(label=lab, xalign=0, hexpand=True,
                         ellipsize=Pango.EllipsizeMode.END)
        if not used:
            name.add_css_class("dim-label")
        row.append(name)
        src = Gtk.DragSource(actions=Gdk.DragAction.COPY)
        src.connect("prepare",
                    lambda *_: Gdk.ContentProvider.new_for_value(n))
        row.add_controller(src)
        row.set_tooltip_text("%s: drag it onto a spot" % n)
        return row

    def sync(self):
        app = self.win.app
        now = [(n, lab) + mark_of(app, n) for n, lab in app.names]
        if now != self.shown:
            self.shown = now
            self.names.remove_all()
            for item in now:
                self.names.append(self._row(*item))
        self.caption()
        self.slices.refresh()
        self.area.queue_draw()

    def _landed(self):
        self.area.queue_draw()
        self.caption()

    def shown_walls(self):
        """Every cell's wallpaper as the session shows it: the desk's own,
        else the integrator's default."""
        app = self.win.app
        return {(cx, cy): f for cx in range(app.grid[0])
                for cy in range(app.grid[1])
                for f in [app.wall_at((cx, cy))[0]] if f}

    def caption(self):
        app = self.win.app
        if app.arr is not None:
            self.sel.set_text(arrange_words(app))
            self.cell.set_text("arranging: drag a workspace (it lands on a"
                               " row and column), d deletes one, Enter"
                               " commits, Esc cancels")
            return
        self.sel.set_text(selection_words(app))
        why = self.slices.why
        self.cell.set_text(cell_words(app) + (
            "   (no preview: %s)" % why.splitlines()[-1] if why else ""))

    def _draw(self, area, cr, w, h):
        app = self.win.app
        fg, accent = colours(area)
        if app.arr is not None:
            draw_arrangement(cr, app, w, h, fg, accent, self.slices.cut,
                             self.hover)
            return
        vf = vframe(app, w, h)
        for cy in range(app.grid[1]):
            for cx in range(app.grid[0]):
                draw_cell(cr, app, vf, cx, cy, fg, accent, self.slices.cut)


# --- the window --------------------------------------------------------------

def button(label, icon, tip, call):
    b = Gtk.Button(tooltip_text=tip, focusable=False)
    if label:
        b.set_child(Adw.ButtonContent(label=label, icon_name=icon))
    else:
        b.set_icon_name(icon)
    b.connect("clicked", lambda _b: call())
    return b


def curses_key(name):
    """The terminal tool's code for a key a button presses (the App takes
    curses codes; see controller.KEYSYMS)."""
    import curses
    return getattr(curses, "KEY_" + name)


