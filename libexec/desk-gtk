class Window:
    """The desk tool's window over one App. Every change goes through the
    App; sync() then makes the window say what the App now holds."""

    def __init__(self, gapp, app):
        self.app = app
        self.alert = None       # (kind, its dialog, refresh) while one is up
        self.thumbs = Thumbs()
        # Every wallpaper's thumbnail made ready now, in the background, so
        # the picker opens on pictures; the oldest of the kept ones go.
        threading.Thread(target=prune, args=("thumbs", KEEP_THUMBS,
                                             r"[0-9a-f]{24}\.png"),
                         daemon=True).start()
        self.thumbs.warm(os.path.join(app.hw.wallpaper_dir(), n)
                         for n in app.hw.wallpaper_images())
        self.win = Adw.ApplicationWindow(application=gapp,
                                         default_width=1200,
                                         default_height=760)
        self.win.set_title(getattr(app.hw, "name", None) and
                           "%s: hwdp gdesk" % app.hw.name or "hwdp gdesk")
        self.stack = Adw.ViewStack()
        self.view = DeskView(self)
        self.names = NamesPage(self)
        self.grid = GridPage(self)
        self.review = Gtk.TextView(editable=False, monospace=True,
                                   cursor_visible=False, left_margin=24,
                                   top_margin=16)
        for page, name, title, icon in (
                (self.view.area, "physical", "Physical",
                 "video-display-symbolic"),
                (self.names.widget, "surfaces", "Surfaces", "tag-symbolic"),
                (self.grid.widget, "virtual", "Virtual",
                 "view-grid-symbolic"),
                (Gtk.ScrolledWindow(child=self.review, vexpand=True),
                 "review", "Review", "view-list-symbolic")):
            self.stack.add_titled_with_icon(page, name, title, icon)
        self.stack.connect("notify::visible-child-name", self.on_tab)
        self.banner = Adw.Banner()
        tv = Adw.ToolbarView(content=self.stack)
        tv.add_top_bar(Adw.HeaderBar(title_widget=Adw.ViewSwitcher(
            stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE)))
        tv.add_top_bar(self.banner)
        tv.add_bottom_bar(self._bar())
        self.win.set_content(tv)
        keys = Gtk.EventControllerKey(
            propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.win.add_controller(keys)
        self.win.connect("close-request", self.on_close)
        GLib.timeout_add(TICK_MS, self.tick)
        self.sync()

    def _bar(self):
        """The buttons under the drawing: this tab's own, then save."""
        def keyed(label, icon, tip, code):
            return button(label, icon, tip, lambda: self.press(code))
        self.ident = Gtk.ToggleButton(icon_name="find-location-symbolic",
                                      tooltip_text="A label on every "
                                      "monitor (i)", focusable=False)
        self.ident.connect("toggled", self.on_ident)
        groups = tab_buttons(keyed, self.ident)
        bar = Gtk.ActionBar()
        self.groups = {}
        for tab, items in groups.items():
            g = Gtk.Box(spacing=4)
            for b in items:
                g.append(b)
            bar.pack_start(g)
            self.groups[tab] = g
        self.status = Gtk.Label(ellipsize=Pango.EllipsizeMode.END,
                                hexpand=True, xalign=0.5)
        self.spinner = Adw.Spinner(visible=False)
        mid = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, hexpand=True)
        mid.append(self.spinner)
        mid.append(self.status)
        bar.set_center_widget(mid)
        save = keyed("Save", "document-save-symbolic",
                     "Save, and keep editing (Ctrl+S)", ord("s"))
        save.add_css_class("suggested-action")
        self.preview = keyed("Preview", "view-reveal-symbolic",
                             "Apply it live; it reverts unless kept (p)",
                             ord("p"))
        bar.pack_end(save)
        bar.pack_end(self.preview)
        self.edits = [b for g in groups.values() for b in g
                      if isinstance(b, Gtk.Button)] + [self.preview, save]
        return bar

    # --- input: everything reaches the App as the terminal's key codes --
    def press(self, code):
        self.app.key(code, time.monotonic())
        self.sync()

    def on_tab(self, stack, _param):
        tab = TABS.index(stack.get_visible_child_name())
        if tab != self.app.tab:
            self.app.tab, self.app.msg = tab, ""
            self.sync()

    def on_key(self, ctrl, keyval, keycode, state):
        if self.alert:
            return False            # the dialog has the keyboard
        name = Gdk.keyval_name(keyval) or ""
        uc = Gdk.keyval_to_unicode(keyval)
        char = chr(uc) if uc else ""
        if state & Gdk.ModifierType.CONTROL_MASK:
            if name.lower() == "s":
                self.press(ord("s"))
                return True
            return False
        code = key_code(name, char,
                        bool(state & Gdk.ModifierType.SHIFT_MASK))
        if code is None:
            return False
        if TABS[self.app.tab] == "review" and not (
                code in (ord("s"), ord("q"), ESC) or char.isdigit()):
            return False            # the review scrolls by itself
        self.press(code)
        return True

    def on_ident(self, b):
        if b.get_active() != self.app.ident:
            self.press(ord("i"))

    def on_close(self, _win):
        if self.app.done:
            return False
        self.app.key(ord("q"), time.monotonic())
        if self.app.done:
            return False
        self.sync()
        return True

    def tick(self):
        self.app.tick(time.monotonic())
        self.sync()
        return GLib.SOURCE_CONTINUE

    # --- output: the window says what the App holds ---------------------
    def sync(self):
        app = self.app
        if app.done:
            self.win.close()
            return
        busy = bool(app.busy)
        self.spinner.set_visible(busy)
        self.status.set_text(" ".join(x for x in (app.busy[0], app.busy[2])
                                      if x) if busy else app.msg or
                             getattr(app, "where", ""))
        for b in self.edits:
            b.set_sensitive(not busy)
        if self.ident.get_active() != app.ident:
            self.ident.set_active(app.ident)
        tab = TABS[app.tab]
        if self.stack.get_visible_child_name() != tab:
            self.stack.set_visible_child_name(tab)
        shown = "arrange" if tab == "virtual" and app.arr is not None \
            else tab
        for name, g in self.groups.items():
            g.set_visible(name == shown)
        self.preview.set_visible(tab == "physical")
        warn = banner_text(app.desk) if tab == "physical" else ""
        self.banner.set_title(warn)
        self.banner.set_revealed(bool(warn))
        self.sync_page(tab)
        self.sync_alert()

    def sync_page(self, tab):
        if tab == "physical":
            self.view.area.queue_draw()
        elif tab == "surfaces":
            self.names.sync()
        elif tab == "virtual":
            self.grid.sync()
        else:
            text = "\n".join(review_lines(self.app))
            buf = self.review.get_buffer()
            if buf.get_text(buf.get_start_iter(), buf.get_end_iter(),
                            False) != text:
                buf.set_text(text)

    def sync_alert(self):
        kind = self.app.dialog[0] if self.app.dialog else None
        if self.alert and self.alert[0] != kind:
            shown, self.alert = self.alert[1], None
            shown.force_close()
        if kind and not self.alert and kind in DIALOGS:
            d, refresh = DIALOGS[kind](self)
            self.alert = (kind, d, refresh)
            d.present(self.win)
        if self.alert and self.alert[2]:
            self.alert[2]()

    def on_response(self, d, rid):
        """An alert answered: its answer is the terminal tool's key."""
        if not self.alert or self.alert[1] is not d:
            return                  # closed by sync, not by a person
        self.alert = None
        self.press(RESPONSES[rid])

    def on_closed(self, d):
        """A form closed by a person (Esc, Cancel): the App's Esc."""
        if not self.alert or self.alert[1] is not d:
            return
        self.alert = None
        self.press(ESC)


# --- the dialogs: one for each of the App's ----------------------------------
# Each builder takes the window and returns (the dialog, a refresh or
# None). An ALERT answers with a response, mapped to the terminal tool's key
# for it; a FORM (fields, a list) calls the App and closes when the App's
# dialog does.

def keep_body(app):
    left = max(0, int(app.dialog[1] - time.monotonic() + 0.999))
    return "It reverts in %d second%s unless kept." % (
        left, "" if left == 1 else "s")


def alert(win, heading, body, responses, default, close):
    d = Adw.AlertDialog(heading=heading, body=body)
    for rid, label, look in responses:
        d.add_response(rid, label)
        if look:
            d.set_response_appearance(rid, look)
    d.set_default_response(default)
    d.set_close_response(close)
    d.connect("response", win.on_response)
    return d


def keep_alert(win):
    d = alert(win, "Keep this layout?", keep_body(win.app),
              [("revert", "Revert", Adw.ResponseAppearance.DESTRUCTIVE),
               ("keep", "Keep", Adw.ResponseAppearance.SUGGESTED)],
              "keep", "revert")
    return d, lambda: d.set_body(keep_body(win.app))


def quit_alert(win):
    return alert(win, "Save the changes?", "This desk has changes not saved.",
                 [("cancel", "Keep editing", None),
                  ("discard", "Discard", Adw.ResponseAppearance.DESTRUCTIVE),
                  ("save", "Save", Adw.ResponseAppearance.SUGGESTED)],
                 "save" if win.app.dialog[1] == ord("s") else "cancel",
                 "cancel"), None


def error_alert(win):
    d = win.app.dialog[1]
    said = error_lines(dict(d), 100, 10 ** 6)[2:-2]
    return alert(win, d["title"], "\n".join(said),
                 [("close", "Close", None)], "close", "close"), None


def delname_alert(win):
    head, said = delname_words(win.app)
    return alert(win, head, "\n".join(said),
                 [("cancel", "Keep it", None),
                  ("delete", "Delete", Adw.ResponseAppearance.DESTRUCTIVE)],
                 "cancel", "cancel"), None


def unsplit_alert(win):
    head, said = unsplit_words(win.app)
    return alert(win, head, "\n".join(said),
                 [("cancel", "Keep the split", None),
                  ("join", "Join", Adw.ResponseAppearance.DESTRUCTIVE)],
                 "cancel", "cancel"), None


def form_dialog(win, title, act, body, width=440, height=-1):
    """A dialog with Cancel and ACT (a button) in its header over BODY;
    closing it any way but ACT is the App's Esc."""
    d = Adw.Dialog(title=title, content_width=width, content_height=height)
    head = Adw.HeaderBar(show_start_title_buttons=False,
                         show_end_title_buttons=False)
    cancel = Gtk.Button(label="Cancel")
    cancel.connect("clicked", lambda _b: d.close())
    head.pack_start(cancel)
    if act:
        act.add_css_class("suggested-action")
        head.pack_end(act)
    tv = Adw.ToolbarView(content=body)
    tv.add_top_bar(head)
    d.set_child(tv)
    d.connect("closed", win.on_closed)
    return d


def name_form(win):
    """A new name, or the selected one's label: two fields, the App's
    rules, and its refusal shown under them until it is right."""
    app, f = win.app, win.app.form
    edit = f["edit"] is not None
    name = Adw.EntryRow(title="Name", text=f["name"], sensitive=not edit)
    label = Adw.EntryRow(title="Label", text=f["label"])
    group = Adw.PreferencesGroup(
        description="A name is letters, digits, - and _, fixed once made."
        " The label is what a workspace name shows (blank: the name).")
    group.add(name)
    group.add(label)
    err = Gtk.Label(wrap=True, xalign=0)
    err.add_css_class("error")
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                   margin_top=12, margin_bottom=18, margin_start=18,
                   margin_end=18)
    body.append(group)
    body.append(err)
    ok = Gtk.Button(label="Keep" if edit else "Add")

    def submit(*_):
        app.form_submit(name.get_text(), label.get_text())
        win.sync()
    ok.connect("clicked", submit)
    name.connect("entry-activated", submit)
    label.connect("entry-activated", submit)
    d = form_dialog(win, "Label %s" % f["name"] if edit else
                    "A new surface name", ok, body)
    d.set_focus(label if edit else name)
    d.fields, d.ok = (name, label), ok      # for a test to fill in
    return d, lambda: err.set_text(app.form["err"] if app.form else "")


def thumb_row(win, name):
    """A wallpaper picker row: the image's thumbnail, then its name; the
    default has no image to show."""
    app = win.app
    r = Adw.ActionRow(title=name, use_markup=False, activatable=True)
    pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER,
                      width_request=THUMB[0], height_request=THUMB[1],
                      can_shrink=True, margin_top=4, margin_bottom=4)
    dflt = app.wall_defaults.get(tuple(app.vcell))
    if name in app.wpick["images"]:
        win.thumbs.into(os.path.join(app.hw.wallpaper_dir(), name), pic)
    elif dflt:
        r.set_subtitle("this place's default: %s" % dflt)
        win.thumbs.into(os.path.join(app.hw.wallpaper_dir(), dflt), pic)
    else:
        r.set_subtitle("no default known here")
    r.add_prefix(pic)
    r.picture = pic                 # for a test to watch it land
    return r


def pick_rows(win, kind, rows, st):
    """Fill ROWS with what the picker shows now; the App's choice
    selected. Returns how many."""
    app = win.app
    shown = app.pick_list() if kind == "pick" else app.wpick_list()
    rows.remove_all()
    for item in shown:
        if kind == "pick":
            r = Adw.ActionRow(title=item[1], subtitle=item[0],
                              use_markup=False, activatable=True)
        else:
            r = thumb_row(win, item)
        rows.append(r)
    r = rows.get_row_at_index(min(st["sel"], max(0, len(shown) - 1)))
    if r is not None:
        rows.select_row(r)
    return len(shown)


def wall_preview(win, chosen):
    """The wallpaper picker's strip: the whole desk with the highlighted
    image cut across it, CHOSEN() naming it (None for the default), cut
    as the session would and drawn at full strength."""
    cell = tuple(win.app.vcell)
    area = Gtk.DrawingArea(content_height=170, margin_start=12,
                           margin_end=12, margin_top=6)
    sl = Slices(win, lambda: {cell: chosen()} if chosen() else {},
                area.queue_draw, wait=150)

    def draw(_a, cr, w, h):
        on = win.app.desk.on()
        fg, _accent = colours(area)
        minx, miny = min(o.x for o in on), min(o.y for o in on)
        bw = max(o.x + o.w for o in on) - minx
        bh = max(o.y + o.h for o in on) - miny
        k = min((w - 16) / bw, (h - 16) / bh)
        fr = (k, (w - bw * k) / 2, (h - bh * k) / 2, minx, miny)
        for o in on:
            b = box(o, fr)
            img = sl.cut.get(cell + (slicer_name(o),))
            if img is not None:
                paint(cr, img, b, 1.0)
            rounded(cr, b[0], b[1], b[2], b[3], 3)
            cr.set_line_width(1)
            cr.set_source_rgba(*rgba(fg, 0.5))
            cr.stroke()
        if not chosen():
            fit(cr, "each panel keeps the desk's own", (0, 0, w, h),
                rgba(fg, 0.6), bold=False)
    area.set_draw_func(draw)
    return area, sl


def pick_form(win, kind):
    """The name picker (pick) or the wallpaper picker (wpick): a filter and
    the list it leaves; choosing a row is the App's Enter on it."""
    app = win.app
    st = app.pick if kind == "pick" else app.wpick
    search = Gtk.SearchEntry(text=st["filter"], margin_start=12,
                             margin_end=12, margin_top=6)
    rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
    rows.add_css_class("boxed-list")
    rows.set_placeholder(Gtk.Label(label="Nothing matches", margin_top=12,
                                   margin_bottom=12))

    def changed(_e):
        st["filter"], st["sel"] = search.get_text(), 0
        pick_rows(win, kind, rows, st)

    def choose(_lb, row):
        st["sel"] = row.get_index()
        win.press(ENTER)

    def highlighted():
        r = rows.get_selected_row()
        name = r.get_title() if r is not None else None
        if kind != "wpick" or name is None:
            return None
        return name if name in app.wpick["images"] else \
            app.wall_defaults.get(tuple(app.vcell))

    def first(_e):
        if rows.get_row_at_index(0) is not None:
            choose(None, rows.get_row_at_index(0))
    search.connect("search-changed", changed)
    search.connect("activate", first)
    rows.connect("row-activated", choose)
    pick_rows(win, kind, rows, st)
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    preview = None
    if kind == "wpick" and cairo is not None:
        strip, preview = wall_preview(win, highlighted)
        rows.connect("row-selected", lambda *_: preview.refresh())
        body.append(strip)
    body.append(search)
    body.append(Gtk.ScrolledWindow(child=Adw.Clamp(
        child=rows, margin_start=12, margin_end=12, margin_bottom=12),
        vexpand=True))
    title = pick_words(app) if kind == "pick" else \
        "Wallpaper of cell %d,%d" % tuple(app.vcell)
    d = form_dialog(win, title, None, body, width=560,
                    height=760 if kind == "wpick" else 600)
    d.set_focus(search)
    d.search, d.rows, d.preview = search, rows, preview  # for a test
    if preview is not None:
        preview.refresh()
    return d, None


def deltile_alert(win):
    head, said = deltile_words(win.app)
    return alert(win, head, "\n".join(said),
                 [("cancel", "Keep it", None),
                  ("delete", "Delete", Adw.ResponseAppearance.DESTRUCTIVE)],
                 "cancel", "cancel"), None


DIALOGS = {"keep": keep_alert, "quit": quit_alert, "error": error_alert,
           "delname": delname_alert, "unsplit": unsplit_alert,
           "deltile": deltile_alert,
           "name": name_form, "pick": lambda w: pick_form(w, "pick"),
           "wpick": lambda w: pick_form(w, "wpick")}
RESPONSES = {"keep": ord("y"), "revert": ESC, "cancel": ESC,
             "discard": ord("d"), "save": ord("s"), "close": ENTER,
             "delete": ord("y"), "join": ord("y")}


# --- the program -------------------------------------------------------------

def load(argv):
    """The App over the desk ARGV names (`--desk KEY [--name NAME]`, as
    `hwdp gdesk <name>` passes), or over the attached one; or a reason
    it cannot start, and its exit status."""
    args, key, name = argv[1:], None, None
    if args[:1] == ["--desk"] and len(args) in (2, 4) and \
            (len(args) == 2 or args[2] == "--name"):
        key = args[1]
        name = args[3] if len(args) == 4 else key
    elif args:
        return None, "the tool takes no arguments but a desk" \
            " (hwdp gdesk <desk>)", 2
    if key:
        hw = OfflineHwdp(key, name)
        outs = hw.geometry()
        if not outs:
            return None, "%s has no panels on record" % name, 2
        app = App(Desk(outs, hw.repack), hw)
        hw.desk = app.desk
        app.where = "%s: not attached, saving edits its files" % name
        return app, "", 0
    hw = Hwdp()
    return App(Desk(hw.geometry(), hw.repack), hw), "", 0


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print(__doc__.split("\n\n")[1])
        return 0
    if argv[1:] == ["--app-id"]:
        print(APP_ID)           # needs no GTK and no session: a rule's key
        return 0
    if GTK_WHY:
        print("hwdp gdesk: needs python3-gi with GTK 4 and libadwaita"
              " (%s); hwdp desk works in a terminal" % GTK_WHY,
              file=sys.stderr)
        return 4
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("hwdp gdesk: needs a Wayland session; hwdp desk works in a"
              " terminal", file=sys.stderr)
        return 3
    held, why = desk_lock("hwdp gdesk")
    if held is None:
        print("hwdp gdesk: " + why, file=sys.stderr)
        return 5
    app, why, rc = load(argv)
    if not app:
        print("hwdp gdesk: " + why, file=sys.stderr)
        return rc
    # The app_id must not depend on D-Bus: GTK takes the application's id
    # only once it has REGISTERED on the session bus, and otherwise the
    # program's name, which was `desk-gtk` (measured: no bus, no rule
    # match). The name IS the id, so both paths give the contract.
    GLib.set_prgname(APP_ID)
    GLib.set_application_name("hwdp gdesk")
    gapp = Adw.Application(application_id=APP_ID,
                           flags=Gio.ApplicationFlags.NON_UNIQUE)
    gapp.connect("activate", lambda g: Window(g, app).win.present())
    try:
        return gapp.run([argv[0]])
    finally:
        app.hw.identify(False)  # the labels go however this ends


if __name__ == "__main__":
    sys.exit(main(sys.argv))
