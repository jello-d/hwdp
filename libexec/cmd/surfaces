#!/bin/sh
# hwdp surfaces: this desk's named SURFACES, resolved against the outputs that
# are switched on now. One line per surface:
#
#   SURFACE CONNECTOR WS_X WS_Y X Y W H
#
# X Y W H is the surface's rect INSIDE that output, in the output's LOGICAL
# pixels (after rotation and scale, truncated as the compositor does), so a
# consumer adds the output's own position if it wants global coordinates.
# WS_X WS_Y is the workspace cell the surface is meant for, passed through.
#
#   --check   validate the file and report, in words, instead of resolving
#
# A SURFACE IS A NAME FOR "THIS PANEL, THIS PART OF IT, THIS CELL", authored
# per desk in $HWDP_SURFACES/<hwdp-id>.conf (default ~/.config/hwdp/surfaces):
#
#   surface comms "Dell Inc. U2720Q ABC123" cell 0 0 bottom
#   surface code  "LG Electronics 4K DEF456" cell 0 0
#
# The panel is named by its EDID "Make Model Serial", exactly as a kanshi
# profile names it, so a desk has one vocabulary. The region is one of
# `top bottom left right full` (halves; default full).
#
# THE BOUNDARY, which is the whole reason this is hwdp's: hwdp owns which
# panel and which part of it a NAME means at this desk, because only hwdp can
# resolve a fraction of a panel to pixels (the logical size depends on the
# sticky scale). What a name means for WINDOWS ("Slack lives on comms") is the
# consumer's. hwdp has no opinion about windows.
#
# A SEED, NOT A PLACEMENT: a consumer that learns geometry (usher) uses this
# only where it has nothing learned, so it never has to be pixel-perfect.
#
# SOFT, like `hwdp id`: no file prints nothing and exits 0, and a consumer
# falls back to what it does without one. But a file that is BROKEN (a line
# that does not parse, a name used twice, two surfaces claiming overlapping
# space) is refused outright with nothing on stdout: a map that is half right
# would quietly seed windows into the wrong places, which is worse than none.
#
# ENABLED, NOT ATTACHED: a surface on a panel that is switched off is left out
# (and named on stderr). "Ignore the built-in panel when docked" puts that
# panel in the kernel's list and not in the compositor's, and a consumer
# placing windows needs the compositor's.
set -eu
. "$HWDP_LIB/displayset_lib"

MODE=emit
case "${1:-}" in
  '') ;;
  --check) MODE=check ;;
  -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
  *) echo "hwdp surfaces: unexpected argument '$1'" >&2; exit 2 ;;
esac

SURF=${HWDP_SURFACES:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/hwdp/surfaces}
_id=$(hwdp_id)
if [ -z "$_id" ]; then
  [ "$MODE" = check ] && echo "hwdp surfaces: no displays attached"
  exit 0
fi
_file=$SURF/$_id.conf
if [ ! -f "$_file" ]; then
  [ "$MODE" = check ] && echo "no surfaces for this desk ($_file)"
  exit 0
fi

if ! _live=$(probe_layout); then
  echo "hwdp surfaces: no layout provider could answer; surfaces need a" \
       "session (the compositor knows which outputs are on)" >&2
  exit 3
fi

# The live table first (TAB records, as probe_layout gives them), then the
# file, parsed by hand because a panel name is quoted and holds spaces.
printf '%s\n' "$_live" | awk -v mode="$MODE" -v file="$_file" \
  "$HWDP_AWK_LOGICAL"'
  function err(m) { E[++ne] = file ":" FNR ": " m }
  function note(m) { O[++no] = m }
  # <region> <W> <H>: sets RX RY RW RH inside a W x H output
  function region(r, W, H) {
    RX = 0; RY = 0; RW = W; RH = H
    if (r == "top")    { RH = int(H / 2) }
    if (r == "bottom") { RY = int(H / 2); RH = H - RY }
    if (r == "left")   { RW = int(W / 2) }
    if (r == "right")  { RX = int(W / 2); RW = W - RX }
  }
  # Two regions of one panel overlap unless they are opposite halves.
  function clash(a, b) {
    if (a == "full" || b == "full" || a == b) return 1
    if ((a == "top" && b == "bottom") || (a == "bottom" && b == "top"))
      return 0
    if ((a == "left" && b == "right") || (a == "right" && b == "left"))
      return 0
    return 1
  }
  FILENAME == "-" {
    split($0, f, "\t")
    if (f[1] == "") next
    ATT[f[1]] = 1
    if (f[12] == 1 && f[3] + 0 > 0) {
      ON[f[1]] = f[2]; lsize(f[3], f[4], f[8], f[9])
      LWD[f[1]] = LW; LHT[f[1]] = LH
    }
    next
  }
  /^[ \t]*(#|$)/ { next }
  {
    line = $0
    if (!match(line, /^[ \t]*surface[ \t]+/)) {
      err("expected `surface <name> \"<panel>\" cell <x> <y> [region]`")
      next
    }
    line = substr(line, RLENGTH + 1)
    if (!match(line, /^[A-Za-z0-9_-]+/)) { err("bad surface name"); next }
    nm = substr(line, 1, RLENGTH); line = substr(line, RLENGTH + 1)
    if (!match(line, /^[ \t]+"[^"]+"/)) {
      err(nm ": the panel must be a quoted EDID name"); next
    }
    pn = substr(line, RSTART, RLENGTH); line = substr(line, RLENGTH + 1)
    sub(/^[ \t]+"/, "", pn); sub(/"$/, "", pn)
    if (!match(line, /^[ \t]+cell[ \t]+[0-9]+[ \t]+[0-9]+/)) {
      err(nm ": expected `cell <x> <y>` after the panel"); next
    }
    cs = substr(line, RSTART, RLENGTH); line = substr(line, RLENGTH + 1)
    sub(/^[ \t]+/, "", cs); split(cs, c, /[ \t]+/)   # cell, x, y
    rg = line; gsub(/^[ \t]+|[ \t]+$/, "", rg)
    if (rg == "") rg = "full"
    if (rg !~ /^(top|bottom|left|right|full)$/) {
      err(nm ": region `" rg "` is not one of top bottom left right full")
      next
    }
    if (nm in SEEN) { err("surface `" nm "` is defined twice"); next }
    SEEN[nm] = 1
    n++; SN[n] = nm; SP[n] = pn; SX[n] = c[2]; SY[n] = c[3]; SR[n] = rg
    SL[n] = FNR
  }
  END {
    for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++)
      if (SP[i] == SP[j] && SX[i] == SX[j] && SY[i] == SY[j] \
          && clash(SR[i], SR[j]))
        E[++ne] = file ": `" SN[i] "` (" SR[i] ") and `" SN[j] "` (" \
          SR[j] ") claim the same part of \"" SP[i] "\" in cell " \
          SX[i] " " SY[i]
    if (ne > 0) {
      for (i = 1; i <= ne; i++) print "hwdp surfaces: " E[i] > "/dev/stderr"
      exit 2
    }
    for (i = 1; i <= n; i++) {
      p = SP[i]
      if (!(p in ATT)) {
        note("`" SN[i] "`: no attached panel is named \"" p "\" (a typo?)")
        continue
      }
      if (!(p in ON)) {
        note("`" SN[i] "`: \"" p "\" is attached but switched off; skipped")
        continue
      }
      USED[p] = 1
      region(SR[i], LWD[p], LHT[p])
      if (mode == "emit")
        printf "%s %s %d %d %d %d %d %d\n", SN[i], ON[p], SX[i], SY[i], \
          RX, RY, RW, RH
      else
        printf "ok    %-12s %s, %s of %s (%dx%d at %d,%d), cell %d %d\n", \
          SN[i], ON[p], (SR[i] == "full") ? "all" : SR[i] " half", p, \
          RW, RH, RX, RY, SX[i], SY[i]
    }
    if (mode == "check")
      for (p in ON) if (!(p in USED))
        note("\"" p "\" (" ON[p] ") is switched on and has no surface")
    for (i = 1; i <= no; i++)
      if (mode == "emit") print "hwdp surfaces: " O[i] > "/dev/stderr"
      else print "note  " O[i]
  }' - "$_file"
