#!/bin/sh
# hwdp surfaces: this desk's named SURFACES, resolved against the outputs that
# are switched on now. One line per surface:
#
#   SURFACE CONNECTOR WS_X WS_Y X Y W H
#
# X Y W H is the surface's rect INSIDE that output, in the output's LOGICAL
# pixels (after rotation and scale, truncated as the compositor does), so a
# consumer adds the output's own position if it wants global coordinates.
# WS_X WS_Y is the workspace cell the surface is meant for. THAT RECORD IS
# FROZEN at eight fields: a consumer (usher) refuses a map whole on a line
# with any other count, so anything new is a separate mode.
#
#   --map     the WORKSPACE MAP (usher's R7): the same eight fields, then
#             PANEL FX FY FW FH (the panel id `hwdp id --panels` prints, and
#             the region as a fraction of that panel), plus the desk's
#             DEFAULT as one record with `* *` for its cell: the region every
#             cell no surface claims falls to, which is what makes the map
#             total without hwdp having to paint every cell
#   --grid    the desk's grid, `W H`; nothing when the desk sets none
#   --names   the surface NAMES, `name label...`, one per line
#   --check   validate the files and report, in words, instead of resolving
#   --write   replace this desk's file from lines on stdin (see write_file)
#   --write-names  replace the names list from stdin (see write_names)
#
# THE WORDS (agreed 2026-11-11): a PANEL is a physical screen; a DESK the
# panels attached together; the GRID the virtual workspace dimensions; a
# WORKSPACE one cell of it, which under wsync is the whole desk at once; a
# REGION full/top/bottom/left/right of a panel; a SURFACE a NAMED region of a
# panel in one workspace. A surface is a place, never an app.
#
# TWO KINDS OF FILE, by who changes them:
#   $HWDP_SURFACE_NAMES ($HWDP_DESKS/surfaces.names): every surface NAME,
#     global across desks, `name [label]`. The same name at two desks is the
#     same role, which is how a consumer carries a window from one desk to
#     the next, so a name a desk places must be listed here, or the desk is
#     refused (a typo would quietly break that join). A name a desk does not
#     place is simply unplaced there, a normal state. No names file: no
#     check, so a desk authored before it existed still resolves.
#   $HWDP_DESKS/<file>.conf (~/.config/hwdp/desks): ONE desk,
#       grid 3 3
#       surface comms "Dell Inc. U2720Q ABC123" cell 0 0 bottom
#       default elsewhere "@builtin"
#     found as <desk id>.conf (this exact desk), else <shape>.conf (a GENERIC
#     desk of that kind: BL.conf serves any laptop on its own), else the
#     pre-desk-file $HWDP_SURFACES/<desk or plain id>.conf, read as before.
#
# A panel is named by its EDID "Make Model Serial", exactly as a kanshi
# profile names it, or by `@builtin`, which is whichever laptop panel is
# present: what a generic file and a desk with a laptop docked both need.
# The region is one of `top bottom left right full` (halves; default full).
#
# THE BOUNDARY, which is the whole reason this is hwdp's: hwdp owns which
# panel and which part of it a NAME means at this desk, because only hwdp can
# resolve a fraction of a panel to pixels (the logical size depends on the
# sticky scale). What a name means for WINDOWS ("Slack lives on comms") is the
# consumer's. hwdp has no opinion about windows.
#
# A SEED, NOT A PLACEMENT: a consumer that learns geometry (usher) uses this
# only where it has nothing learned, so it never has to be pixel-perfect.
#
# SOFT, like `hwdp id`: no file prints nothing and exits 0, and a consumer
# falls back to what it does without one. But a file that is BROKEN (a line
# that does not parse, a name used twice or not listed, a cell outside the
# grid, two surfaces claiming overlapping space) is refused outright with
# nothing on stdout: a map that is half right would quietly seed windows into
# the wrong places, which is worse than none.
#
# ENABLED, NOT ATTACHED: a surface on a panel that is switched off is left out
# (and named on stderr). "Ignore the built-in panel when docked" puts that
# panel in the kernel's list and not in the compositor's, and a consumer
# placing windows needs the compositor's.
set -eu
. "$HWDP_LIB/displayset_lib"

MODE=emit
case "${1:-}" in
  '') ;;
  --map)   MODE=map ;;
  --grid)  MODE=grid ;;
  --names) MODE=names ;;
  --check) MODE=check ;;
  --write) MODE='write' ;;
  --write-names) MODE=write-names ;;
  -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
  *) echo "hwdp surfaces: unexpected argument '$1'" >&2; exit 2 ;;
esac

_cfg=${XDG_CONFIG_HOME:-${HOME:-}/.config}/hwdp
SURF=${HWDP_SURFACES:-$_cfg/surfaces}
DESKS=${HWDP_DESKS:-$_cfg/desks}
# The names list sits IN the desks dir (not a .conf, so never read as a
# desk): one directory then holds everything the desk tool writes, which an
# integrator can record whole without taking the rest of ~/.config/hwdp.
# Its first home was ~/.config/hwdp/surfaces.names, still used (read AND
# written) while it is there and the new one is not, so moving it is a plain
# `mv` at any moment rather than a flag day.
NAMES=${HWDP_SURFACE_NAMES:-$DESKS/surfaces.names}
if [ -z "${HWDP_SURFACE_NAMES:-}" ] && [ ! -e "$NAMES" ] \
    && [ -f "$_cfg/surfaces.names" ]; then
  NAMES=$_cfg/surfaces.names
fi

# fire_saved <file>: the `saved` edge (hooks_lib), so an integrator can record
# the desk tool's data now rather than at the next layout save. After the
# write, and fail-soft: a hook never undoes or fails a write that landed.
fire_saved() {
  HWDP_SAVED=$1; export HWDP_SAVED
  # shellcheck disable=SC2034  # read by hooks_lib, sourced next
  HWDP_HOOK_TAG='hwdp surfaces'
  . "$HWDP_LIB/hooks_lib"
  run_hooks saved
}

# write_names: REPLACE the names list from `name [label]` lines on stdin, the
# ONE writer of it. Refused whole (exit 2) on a bad or doubled name, and on
# dropping a name that ANY desk file still places, each named: the list is
# global, so a desk this tool cannot see must not be broken by it. Atomic,
# beside the file; the old list kept in the state dir.
write_names() {
  mkdir -p "$(dirname "$NAMES")"
  _nt=$(mktemp "$NAMES.XXXXXX") || return 1
  _ntq="'$_nt'"
  # shellcheck disable=SC2064  # the literal path, baked in when armed
  trap "rm -f $_ntq" EXIT INT TERM
  awk 'BEGIN { print "# surface names, global across desks: name [label]" }
    /^[ \t]*(#|$)/ { next }
    $1 !~ /^[A-Za-z0-9_-]+$/ { print "hwdp surfaces: --write-names: bad" \
      " name `" $1 "`" > "/dev/stderr"; bad = 1; next }
    $1 in S { print "hwdp surfaces: --write-names: `" $1 "` twice" \
      > "/dev/stderr"; bad = 1; next }
    { S[$1] = 1; sub(/^[ \t]+/, ""); print }
    END { exit bad ? 2 : 0 }' > "$_nt" || return 2
  _used=$(for _df in "$DESKS"/*.conf "$SURF"/*.conf; do
            [ -f "$_df" ] || continue
            awk -v f="$_df" '$1 == "surface" || $1 == "default" {
              print $2 "\t" f }' "$_df"
          done | awk -F"$TAB" 'NR == FNR { split($0, w, " ")
                                           if (w[1] !~ /^#/) K[w[1]] = 1; next }
                 !($1 in K) { print "`" $1 "` is placed by " $2 }' \
                 "$_nt" -)
  if [ -n "$_used" ]; then
    printf '%s\n' "$_used" | sed 's/^/hwdp surfaces: --write-names: /' >&2
    echo "hwdp surfaces: --write-names: NOT written: unplace those first" >&2
    return 2
  fi
  chmod 644 "$_nt"
  if [ -f "$NAMES" ] && ! cmp -s "$_nt" "$NAMES"; then
    _bk=${XDG_STATE_HOME:-${HOME:-}/.local/state}/hwdp/surfaces
    mkdir -p "$_bk"
    cp -p "$NAMES" "$_bk/surfaces.names.bak"
  fi
  mv "$_nt" "$NAMES"
  printf '%s\n' "$NAMES"
  fire_saved "$NAMES"
}

# --names needs no displays at all: the list is global.
if [ "$MODE" = write-names ]; then
  write_names
  exit $?
fi
if [ "$MODE" = names ]; then
  [ -f "$NAMES" ] || exit 0
  awk '/^[ \t]*(#|$)/ { next }
    { n = $1; sub(/^[ \t]*[^ \t]+[ \t]*/, ""); print n, ($0 == "" ? n : $0) }
  ' "$NAMES"
  exit 0
fi

# write_file: REPLACE this desk's file from lines on stdin,
#   grid <w> <h>
#   surface <name> <connector | "EDID name"> cell <x> <y> [region]
#   default <name> <connector | "EDID name"> [region]
# the ONE writer of a desk file, so the layout tool never edits it as text.
#   - a connector is resolved to its EDID name NOW, as `arrange` does: the
#     file keys panels by name, because connectors move between ports;
#   - it always writes THIS desk's own file (<desk id>.conf), even when what
#     it read was a generic or older one: editing "this desk" must never
#     change every desk of its kind;
#   - lines in the file read for a panel that is NOT switched on now are
#     KEPT, and so is its grid unless one is given: a tool sees only the
#     panels in front of it, and must not silently drop what it could not see;
#   - the result is validated by this same command before it replaces
#     anything, and refused whole (exit 2) if broken;
#   - the old file is kept as a .bak in the state dir, never beside it (the
#     desks dir may be recorded whole, as muster captures profiles).
write_file() {
  if ! _live=$(probe_layout); then
    echo "hwdp surfaces: writing needs a session (to resolve connectors)" >&2
    return 3
  fi
  mkdir -p "$DESKS"
  _wd=$(mktemp -d "$DESKS/.write.XXXXXX") || _wd=
  case $_wd in
    "$DESKS"/.write.?*) [ -d "$_wd" ] ;;
    *) false ;;
  esac || { echo "hwdp surfaces: no temp dir in $DESKS" >&2; return 1; }
  _wq="'$_wd'"
  # shellcheck disable=SC2064  # the literal path, baked in when armed
  trap "rm -rf $_wq" EXIT INT TERM

  # connector -> EDID name, for the outputs switched on now; at a desk the
  # built-in by its ROLE, so the file serves whichever laptop is docked.
  _wb=; docked && _wb=$_bn
  printf '%s\n' "$_live" | awk -F"$TAB" -v OFS="$TAB" -v b="$_wb" \
    '$1 != "" && $12 == 1 { print $2, ($1 == b) ? "@builtin" : $1 }' \
    > "$_wd/names"
  # The given lines, connectors resolved; refused whole on any bad line.
  awk -F"$TAB" '
    NR == FNR { N[$1] = $2; next }
    /^[ \t]*(#|$)/ { next }
    {
      line = $0; sub(/^[ \t]+/, "", line)
      if (line ~ /^grid[ \t]/) { print line; next }
      if (line !~ /^(surface|default)[ \t]/) {
        print "hwdp surfaces: --write: not a grid, surface or default" \
          " line: " $0 > "/dev/stderr"; bad = 1; next
      }
      kw = line; sub(/[ \t].*/, "", kw)
      rest = line; sub(/^[a-z]+[ \t]+[^ \t]+[ \t]+/, "", rest)
      if (rest ~ /^"/) { print line; next }
      conn = rest; sub(/[ \t].*/, "", conn); sub(/^[^ \t]+/, "", rest)
      if (!(conn in N)) {
        print "hwdp surfaces: --write: no switched-on output named `" \
          conn "`" > "/dev/stderr"; bad = 1; next
      }
      nm = line; sub(/^[a-z]+[ \t]+/, "", nm); sub(/[ \t].*/, "", nm)
      print kw " " nm " \"" N[conn] "\"" rest
    }
    END { if (bad) exit 2 }' "$_wd/names" - > "$_wd/given" || return 2
  # What the file read keeps: its lines for panels NOT switched on now, and
  # its grid when none was given.
  : > "$_wd/kept"
  if [ -n "$_file" ]; then
    awk -F"$TAB" -v grid="$(grep -c '^grid[ \t]' "$_wd/given" || :)" '
      NR == FNR { ON[$2] = 1; next }
      /^[ \t]*grid[ \t]/ { if (grid == 0) print; next }
      match($0, /^[ \t]*(surface|default)[ \t]+[^ \t]+[ \t]+"[^"]+"/) {
        p = substr($0, RSTART, RLENGTH); sub(/^[^"]*"/, "", p)
        sub(/"$/, "", p); if (!(p in ON)) print
      }' "$_wd/names" "$_file" > "$_wd/kept"
  fi
  { echo "# this desk, written by hwdp surfaces --write:"
    echo "#   grid <w> <h>"
    echo "#   surface <name> \"<EDID name>\" cell <x> <y> [region]"
    echo "#   default <name> \"<EDID name>\" [region]"
    echo "#   region: top bottom left right full (halves; default full)"
    grep '^[ \t]*grid[ \t]' "$_wd/given" "$_wd/kept" | sed 's/^[^:]*://' \
      | head -1
    grep -v '^[ \t]*grid[ \t]' "$_wd/given" || :
    grep -v '^[ \t]*grid[ \t]' "$_wd/kept" || :
  } > "$_wd/$_desk.conf"
  # Validated by this same command, against the candidate, before anything
  # is replaced.
  if ! HWDP_DESKS=$_wd HWDP_SURFACES=$_wd/none "$0" >/dev/null 2>"$_wd/err"
  then
    sed 's/^/  /' "$_wd/err" >&2
    echo "hwdp surfaces: --write: NOT written, the result would be broken" >&2
    return 2
  fi
  _dst=$DESKS/$_desk.conf
  if [ -f "$_dst" ] && ! cmp -s "$_wd/$_desk.conf" "$_dst"; then
    _bk=${XDG_STATE_HOME:-${HOME:-}/.local/state}/hwdp/surfaces
    mkdir -p "$_bk"
    cp -p "$_dst" "$_bk/$_desk.conf.bak"
  fi
  mv "$_wd/$_desk.conf" "$_dst"
  printf '%s\n' "$_dst"
  fire_saved "$_dst"
}


_id=$(hwdp_id)
if [ -z "$_id" ]; then
  [ "$MODE" = check ] && echo "hwdp surfaces: no displays attached"
  exit 0
fi
# THIS desk's file, then a generic one for its kind, then the files from
# before desk files existed (under the desk id, then the plain id).
_desk=$(desk_id)
_file=
for _f in "$DESKS/$_desk.conf" "$DESKS/$(shape).conf" "$SURF/$_desk.conf" \
    "$SURF/$_id.conf"; do
  if [ -f "$_f" ]; then _file=$_f; break; fi
done
_bn=$(builtin_name)
if [ "$MODE" = write ]; then
  write_file
  exit $?
fi
if [ "$MODE" = grid ]; then
  [ -n "$_file" ] || exit 0
  awk '$1 == "grid" && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
         print $2, $3; exit }' "$_file"
  exit 0
fi
if [ -z "$_file" ]; then
  [ "$MODE" = check ] && echo "no surfaces for this desk ($DESKS/$_desk.conf)"
  exit 0
fi

if ! _live=$(probe_layout); then
  echo "hwdp surfaces: no layout provider could answer; surfaces need a" \
       "session (the compositor knows which outputs are on)" >&2
  exit 3
fi
# connector -> panel id, as `hwdp id --panels` prints it, for --map.
_pids=$(probe_panels | awk -F"$TAB" '$2 != "" && $1 != "" {
          print $2, substr($1, 1, 12) }')
_nf=$NAMES; [ -f "$_nf" ] || _nf=/dev/null
[ "$MODE" = check ] && echo "desk file: $_file"
[ "$MODE" = check ] && [ "$_nf" = /dev/null ] \
  && echo "note  no names file ($NAMES): names are not checked"

. "$HWDP_LIB/surfaces_lib"
printf '%s\n' "$_live" | surfaces_resolve "$MODE" "$_file" "$_nf" "$_bn" \
  "$_pids"
