#!/bin/sh
# hwdp surfaces: this desk's named SURFACES, resolved against the outputs that
# are switched on now. One line per surface:
#
#   SURFACE CONNECTOR WS_X WS_Y X Y W H
#
# X Y W H is the surface's rect INSIDE that output, in the output's LOGICAL
# pixels (after rotation and scale, truncated as the compositor does), so a
# consumer adds the output's own position if it wants global coordinates.
# WS_X WS_Y is the workspace cell the surface is meant for. THAT RECORD IS
# FROZEN at eight fields: a consumer (usher) refuses a map whole on a line
# with any other count, so anything new is a separate mode.
#
#   --map     the WORKSPACE MAP (usher's R7): the same eight fields, then
#             PANEL FX FY FW FH (the panel id `hwdp id --panels` prints, and
#             the region as a fraction of that panel), plus the desk's
#             DEFAULT as one record with `* *` for its cell: the region every
#             cell no surface claims falls to, which is what makes the map
#             total without hwdp having to paint every cell
#   --grid    the desk's grid, `W H`; nothing when the desk sets none
#   --labels  the same eight fields, then the surface's LABEL (its
#             vanity name, spaces and all: the rest of the line, so the
#             eight before it still split on whitespace). Opt-in, because a
#             consumer of the frozen record refuses a ninth field
#   --names   the surface NAMES, `name: label`, one per line: a handle has
#             no colon, so the first one divides it from the label, which
#             keeps its spaces (and any colons) as written
#   --check   validate the files and report, in words, instead of resolving
#   --write   replace this desk's file from lines on stdin (see write_file)
#   --write-names [--unplace]  replace the names list from stdin (see
#             write_names); a name it drops that a desk still places is
#             refused, or with --unplace taken off every such desk first
#   --wallpapers   this desk's wallpaper per workspace, `X Y FILE`, the
#             cells inside its grid only; FILE is relative to the wallpaper
#             directory (the integrator's), as a wallpaper map writes it.
#             Nothing when the desk sets none: every cell keeps its default
#   --follow FROM X Y [NAME...]  where a person on cell X Y of desk FROM
#             should be NOW: the cell of THIS desk holding one of the
#             surfaces FROM had there (the built-in's first, then whole
#             before halves, then reading order), then of NAME... (an
#             integrator's memory of what it last followed, which carries
#             it across a desk with nothing placed, as a dock that is still
#             arriving is). Prints `CX CY NAME`; when no candidate is placed
#             here, `- - NAME` (the one it looked for first, for the caller
#             to remember) and exit 1; nothing and exit 1 when there was no
#             candidate at all. FROM is a desk key (HWDP_PREVIOUS_
#             DESK, see `hwdp watch`), its own file else its kind's; empty
#             for none. Surface names are global, which is the whole join
#   --default-wallpapers  the wallpaper each cell has when this desk sets
#             none, `X Y FILE`, as the INTEGRATOR says: hwdp knows no image
#             of its own, so it asks the `wallpapers` providers
#             (<root>/wallpapers/*, handed the desk's SHAPE, first to answer
#             wins, silence abstains). Nothing when none answers
#   --write-wallpapers  replace this desk's wallpapers from `X Y FILE` lines
#             on stdin, every other line of the desk file kept as it is
#             (see write_wallpapers)
#   --splits  the panels CUT in two, `CONNECTOR CX CY top-bottom|left-right`
#             per panel and cell, switched-on panels only (see `split`)
#   --raw     the desk file's own lines, unresolved, TAB-separated:
#             `surface|default NAME PANEL CX CY REGION` (`*` cells for the
#             default), and `split - PANEL CX CY top-bottom|left-right`;
#             PANEL the quoted EDID name or @builtin as written
#
# HWDP_DESK=<key> works on THAT desk instead of the attached one, whether or
# not its panels are here (`hwdp desks` names the keys; the layout tool uses
# it to edit a desk away from it). Nothing is resolved against outputs that
# are not this desk's: --raw and --grid read the file, --write replaces it
# WHOLE (the caller holds every panel of the desk, so nothing is kept from
# the old file but its grid when none is given, and panels must be named by
# EDID name or @builtin, since there are no connectors to resolve), and a
# plain run or --check validates the file and resolves what it can.
#
# THE WORDS (agreed 2026-11-11): a PANEL is a physical screen; a DESK the
# panels attached together; the GRID the virtual workspace dimensions; a
# WORKSPACE one cell of it, which under wsync is the whole desk at once; a
# REGION full/top/bottom/left/right of a panel; a SURFACE a NAMED region of a
# panel in one workspace. A surface is a place, never an app.
#
# (end of --help: the rest is for maintainers)
# TWO KINDS OF FILE, by who changes them:
#   $HWDP_SURFACE_NAMES ($HWDP_DESKS/surfaces.names): every surface NAME,
#     global across desks, `name [label]`. The same name at two desks is the
#     same role, which is how a consumer carries a window from one desk to
#     the next, so a name a desk places must be listed here, or the desk is
#     refused (a typo would quietly break that join). A name a desk does not
#     place is simply unplaced there, a normal state. No names file: no
#     check, so a desk authored before it existed still resolves.
#   $HWDP_DESKS/<file>.conf (~/.config/hwdp/desks): ONE desk,
#       grid 3 3
#       split "Dell Inc. U2720Q ABC123" cell 0 0 top-bottom
#       surface comms "Dell Inc. U2720Q ABC123" cell 0 0 bottom
#       default elsewhere "@builtin"
#     found as <desk id>.conf (this exact desk), else <shape>.conf (a GENERIC
#     desk of that kind: BL.conf serves any laptop on its own), else the
#     pre-desk-file $HWDP_SURFACES/<desk or plain id>.conf, read as before.
#
# A panel is named by its EDID "Make Model Serial", exactly as a kanshi
# profile names it, or by `@builtin`, which is whichever laptop panel is
# present: what a generic file and a desk with a laptop docked both need.
# The region is one of `top bottom left right full` (halves; default full).
# A `split` CUTS a panel in one cell, top-bottom or left-right, so a split
# with nothing placed in it yet is kept; a surface there must then be one of
# its halves. A half with no split line (a file from before splits were
# written) implies its split. Each cell decides for itself: a panel can be
# split in one cell and whole in the next.
#
# THE BOUNDARY, which is the whole reason this is hwdp's: hwdp owns which
# panel and which part of it a NAME means at this desk, because only hwdp can
# resolve a fraction of a panel to pixels (the logical size depends on the
# sticky scale). What a name means for WINDOWS ("Slack lives on comms") is the
# consumer's. hwdp has no opinion about windows.
#
# A SEED, NOT A PLACEMENT: a consumer that learns geometry (usher) uses this
# only where it has nothing learned, so it never has to be pixel-perfect.
#
# SOFT, like `hwdp id`: no file prints nothing and exits 0, and a consumer
# falls back to what it does without one. But a file that is BROKEN (a line
# that does not parse, a name used twice or not listed, a cell outside the
# grid, two surfaces claiming overlapping space) is refused outright with
# nothing on stdout: a map that is half right would quietly seed windows into
# the wrong places, which is worse than none.
#
# ENABLED, NOT ATTACHED: a surface on a panel that is switched off is left out
# (and named on stderr). "Ignore the built-in panel when docked" puts that
# panel in the kernel's list and not in the compositor's, and a consumer
# placing windows needs the compositor's.
set -eu
. "$HWDP_LIB/displayset_lib"

MODE=emit
case "${1:-}" in
  '') ;;
  --map)   MODE=map ;;
  --grid)  MODE=grid ;;
  --names) MODE=names ;;
  --labels) MODE=labels ;;
  --check) MODE=check ;;
  --write) MODE='write' ;;
  --write-names) MODE=write-names ;;
  --wallpapers) MODE=wallpapers ;;
  --default-wallpapers) MODE=default-wallpapers ;;
  --follow) MODE=follow ;;
  --write-wallpapers) MODE=write-wallpapers ;;
  --raw)   MODE=raw ;;
  --splits) MODE=splits ;;
  -h|--help) . "$HWDP_LIB/help_lib"; help_print "$0"; exit 0 ;;
  *) echo "hwdp surfaces: unexpected argument '$1'" >&2; exit 2 ;;
esac

_cfg=${XDG_CONFIG_HOME:-${HOME:-}/.config}/hwdp
SURF=${HWDP_SURFACES:-$_cfg/surfaces}
DESKS=${HWDP_DESKS:-$_cfg/desks}
# The names list sits IN the desks dir (not a .conf, so never read as a
# desk): one directory then holds everything the desk tool writes, which an
# integrator can record whole without taking the rest of ~/.config/hwdp.
# Its first home was ~/.config/hwdp/surfaces.names, still used (read AND
# written) while it is there and the new one is not, so moving it is a plain
# `mv` at any moment rather than a flag day.
NAMES=${HWDP_SURFACE_NAMES:-$DESKS/surfaces.names}
if [ -z "${HWDP_SURFACE_NAMES:-}" ] && [ ! -e "$NAMES" ] \
    && [ -f "$_cfg/surfaces.names" ]; then
  NAMES=$_cfg/surfaces.names
fi

# fire_saved <file>: the `saved` edge (hooks_lib), so an integrator can record
# the desk tool's data now rather than at the next layout save. After the
# write, and fail-soft: a hook never undoes or fails a write that landed.
fire_saved() {
  HWDP_SAVED=$1; export HWDP_SAVED
  # shellcheck disable=SC2034  # read by hooks_lib, sourced next
  HWDP_HOOK_TAG='hwdp surfaces'
  . "$HWDP_LIB/hooks_lib"
  run_hooks saved
}

# write_names: REPLACE the names list from `name [label]` lines on stdin, the
# ONE writer of it. Refused whole (exit 2) on a bad or doubled name, and on
# dropping a name that ANY desk file still places, each named: the list is
# global, so a desk this tool cannot see must not be broken by it. Atomic,
# beside the file; the old list kept in the state dir.
# unplace_names <name TAB file lines>: take each NAME off its desk FILE
# (its `surface` and `default` lines; a cut stays, an empty one is legal),
# each file replaced whole beside itself, the old kept as <file>.bak in the
# state dir, and `saved` fired for it, as any desk write is.
unplace_names() {
  _bk=${XDG_STATE_HOME:-${HOME:-}/.local/state}/hwdp/surfaces
  mkdir -p "$_bk"
  for _df in $(printf '%s\n' "$1" | cut -f2 | sort -u); do
    _gone=$(printf '%s\n' "$1" | awk -F"$TAB" -v f="$_df" \
      '$2 == f { print $1 }')
    _dt=$(mktemp "$_df.XXXXXX") || return 1
    awk -v gone="$_gone" 'BEGIN { n = split(gone, g, "\n")
        for (i = 1; i <= n; i++) G[g[i]] = 1 }
      ($1 == "surface" || $1 == "default") && ($2 in G) { next }
      { print }' "$_df" > "$_dt" || { rm -f "$_dt"; return 1; }
    chmod 644 "$_dt"
    cp -p "$_df" "$_bk/$(basename "$_df").bak"
    mv "$_dt" "$_df"
    printf '%s\n' "$_gone" | while read -r _n; do
      echo "hwdp surfaces: --write-names: took \`$_n\` off $_df" >&2
    done
    fire_saved "$_df"
  done
}

write_names() {   # [--unplace]
  mkdir -p "$(dirname "$NAMES")"
  _nt=$(mktemp "$NAMES.XXXXXX") || return 1
  _ntq="'$_nt'"
  # shellcheck disable=SC2064  # the literal path, baked in when armed
  trap "rm -f $_ntq" EXIT INT TERM
  awk 'BEGIN { print "# surface names, global across desks: name [label]" }
    /^[ \t]*(#|$)/ { next }
    $1 !~ /^[A-Za-z0-9_-]+$/ { print "hwdp surfaces: --write-names: bad" \
      " name `" $1 "`" > "/dev/stderr"; bad = 1; next }
    $1 in S { print "hwdp surfaces: --write-names: `" $1 "` twice" \
      > "/dev/stderr"; bad = 1; next }
    { S[$1] = 1; sub(/^[ \t]+/, ""); print }
    END { exit bad ? 2 : 0 }' > "$_nt" || return 2
  _used=$(for _df in "$DESKS"/*.conf "$SURF"/*.conf; do
            [ -f "$_df" ] || continue
            awk -v f="$_df" '$1 == "surface" || $1 == "default" {
              print $2 "\t" f }' "$_df"
          done | awk -F"$TAB" -v OFS="$TAB" 'FILENAME != "-" {
                   split($0, w, " "); if (w[1] !~ /^#/) K[w[1]] = 1; next }
                 !($1 in K) { print $1, $2 }' "$_nt" -)
  if [ -n "$_used" ] && [ "${1:-}" != --unplace ]; then
    printf '%s\n' "$_used" | awk -F"$TAB" '{ print "hwdp surfaces:" \
      " --write-names: `" $1 "` is placed by " $2 }' >&2
    echo "hwdp surfaces: --write-names: NOT written: unplace those first" \
      "(or --unplace: off every desk that places them)" >&2
    return 2
  fi
  if [ -n "$_used" ]; then
    unplace_names "$_used" || return 2
  fi
  chmod 644 "$_nt"
  if [ -f "$NAMES" ] && ! cmp -s "$_nt" "$NAMES"; then
    _bk=${XDG_STATE_HOME:-${HOME:-}/.local/state}/hwdp/surfaces
    mkdir -p "$_bk"
    cp -p "$NAMES" "$_bk/surfaces.names.bak"
  fi
  mv "$_nt" "$NAMES"
  printf '%s\n' "$NAMES"
  fire_saved "$NAMES"
}

# --names needs no displays at all: the list is global.
if [ "$MODE" = write-names ]; then
  case ${2:-} in
    ''|--unplace) ;;
    *) echo "hwdp surfaces: --write-names: unexpected \`$2\`" >&2; exit 2 ;;
  esac
  write_names "${2:-}"
  exit $?
fi
if [ "$MODE" = names ]; then
  [ -f "$NAMES" ] || exit 0
  awk '/^[ \t]*(#|$)/ { next }
    { n = $1; sub(/^[ \t]*[^ \t]+[ \t]*/, "")
      print n ": " ($0 == "" ? n : $0) }
  ' "$NAMES"
  exit 0
fi

# write_file: REPLACE this desk's file from lines on stdin,
#   grid <w> <h>
#   surface <name> <connector | "EDID name"> cell <x> <y> [region]
#   default <name> <connector | "EDID name"> [region]
# the ONE writer of a desk file, so the layout tool never edits it as text.
#   - a connector is resolved to its EDID name NOW, as `arrange` does: the
#     file keys panels by name, because connectors move between ports;
#   - it always writes THIS desk's own file (<desk id>.conf), even when what
#     it read was a generic or older one: editing "this desk" must never
#     change every desk of its kind;
#   - lines in the file read for a panel that is NOT switched on now are
#     KEPT, and so is its grid unless one is given: a tool sees only the
#     panels in front of it, and must not silently drop what it could not see;
#   - the result is validated by this same command before it replaces
#     anything, and refused whole (exit 2) if broken;
#   - the old file is kept as a .bak in the state dir, never beside it (the
#     desks dir may be recorded whole, as muster captures profiles).
write_file() {
  if [ -n "${HWDP_DESK:-}" ]; then
    _live=
  elif ! _live=$(probe_layout); then
    echo "hwdp surfaces: writing needs a session (to resolve connectors)" >&2
    return 3
  fi
  desk_scratch || return 1

  # connector -> EDID name, for the outputs switched on now, the built-in
  # by its ROLE ("@builtin") docked OR NOT, as the desk format has always
  # meant it: written by EDID name when alone, a laptop's own desk read as
  # an EXTERNAL panel (`hwdp desks`: kind EL, named from its model,
  # dragonfly 2026-11-19).
  _wb=; [ -z "${HWDP_DESK:-}" ] && _wb=$_bn
  printf '%s\n' "$_live" | awk -F"$TAB" -v OFS="$TAB" -v b="$_wb" \
    '$1 != "" && $12 == 1 { print $2, ($1 == b) ? "@builtin" : $1 }' \
    > "$_wd/names"
  # The given lines, connectors resolved; refused whole on any bad line.
  # By FILENAME, not NR == FNR: offline the names table is EMPTY, and then
  # NR == FNR holds for every line of stdin, which swallowed them all.
  awk -F"$TAB" '
    FILENAME != "-" { N[$1] = $2; next }
    /^[ \t]*(#|$)/ { next }
    {
      line = $0; sub(/^[ \t]+/, "", line)
      if (line ~ /^grid[ \t]/) { print line; next }
      if (line ~ /^split[ \t]/) {
        # `split <panel> cell ...`: no name, so the panel is word two.
        rest = line; sub(/^split[ \t]+/, "", rest)
        if (rest ~ /^"/) { print line; next }
        conn = rest; sub(/[ \t].*/, "", conn); sub(/^[^ \t]+/, "", rest)
        if (!(conn in N)) {
          print "hwdp surfaces: --write: no switched-on output named `" \
            conn "`" > "/dev/stderr"; bad = 1; next
        }
        print "split \"" N[conn] "\"" rest; next
      }
      if (line !~ /^(surface|default)[ \t]/) {
        print "hwdp surfaces: --write: not a grid, surface, split or" \
          " default line: " $0 > "/dev/stderr"; bad = 1; next
      }
      kw = line; sub(/[ \t].*/, "", kw)
      rest = line; sub(/^[a-z]+[ \t]+[^ \t]+[ \t]+/, "", rest)
      if (rest ~ /^"/) { print line; next }
      conn = rest; sub(/[ \t].*/, "", conn); sub(/^[^ \t]+/, "", rest)
      if (!(conn in N)) {
        print "hwdp surfaces: --write: no switched-on output named `" \
          conn "`" (offline ? " (with HWDP_DESK, name panels by quoted" \
          " EDID name or \"@builtin\")" : "") > "/dev/stderr"
        bad = 1; next
      }
      nm = line; sub(/^[a-z]+[ \t]+/, "", nm); sub(/[ \t].*/, "", nm)
      print kw " " nm " \"" N[conn] "\"" rest
    }
    END { if (bad) exit 2 }' offline="${HWDP_DESK:+1}" "$_wd/names" - \
    > "$_wd/given" || return 2
  # What the file read keeps: its lines for panels NOT switched on now, and
  # its grid when none was given.
  : > "$_wd/kept"
  if [ -n "$_file" ] && [ -n "${HWDP_DESK:-}" ]; then
    # The caller holds the WHOLE desk: keep only the grid, when none given.
    if ! grep -q '^grid[ \t]' "$_wd/given"; then
      grep '^[ \t]*grid[ \t]' "$_file" | head -1 > "$_wd/kept" || :
    fi
  elif [ -n "$_file" ]; then
    # The built-in has TWO spellings, its EDID name and "@builtin", and the
    # file read may use the other one from the lines given (a laptop alone
    # writes by EDID name over a generic file's "@builtin"). Either switched
    # on means both, or every line on it was kept AND given, and the result
    # refused as each surface "defined twice" (dragonfly, 2026-11-18).
    awk -F"$TAB" -v grid="$(grep -c '^grid[ \t]' "$_wd/given" || :)" \
        -v bn="${_bn:-}" '
      FILENAME == ARGV[1] { ON[$2] = 1
        if (bn != "" && ($2 == bn || $2 == "@builtin")) {
          ON[bn] = 1; ON["@builtin"] = 1 }
        next }
      /^[ \t]*grid[ \t]/ { if (grid == 0) print; next }
      match($0, /^[ \t]*(surface|default)[ \t]+[^ \t]+[ \t]+"[^"]+"/) \
          || match($0, /^[ \t]*split[ \t]+"[^"]+"/) {
        p = substr($0, RSTART, RLENGTH); sub(/^[^"]*"/, "", p)
        sub(/"$/, "", p); if (!(p in ON)) print
      }' "$_wd/names" "$_file" > "$_wd/kept"
  fi
  # The wallpapers are written by --write-wallpapers, never here: kept as
  # they are, whichever desk is written, or a desk save would drop them.
  if [ -n "$_file" ]; then
    grep '^[ \t]*wallpaper[ \t]' "$_file" >> "$_wd/kept" || :
  fi
  { desk_header
    grep '^[ \t]*grid[ \t]' "$_wd/given" "$_wd/kept" | sed 's/^[^:]*://' \
      | head -1
    grep -v '^[ \t]*grid[ \t]' "$_wd/given" || :
    grep -v '^[ \t]*grid[ \t]' "$_wd/kept" || :
  } > "$_wd/$_desk.conf"
  install_desk "$_wd" --write
}

# desk_header: the comment every desk file this command writes begins with.
desk_header() {
  echo "# this desk, written by hwdp surfaces --write:"
  echo "#   grid <w> <h>"
  echo "#   split \"<EDID name>\" cell <x> <y> top-bottom|left-right"
  echo "#   surface <name> \"<EDID name>\" cell <x> <y> [region]"
  echo "#   default <name> \"<EDID name>\" [region]"
  echo "#   wallpaper cell <x> <y> <file in the wallpaper directory>"
  echo "#   region: top bottom left right full (halves; default full)"
}

# desk_scratch: a scratch dir beside the desk files, removed on exit, in _wd.
desk_scratch() {
  mkdir -p "$DESKS"
  _wd=$(mktemp -d "$DESKS/.write.XXXXXX") || _wd=
  case $_wd in
    "$DESKS"/.write.?*) [ -d "$_wd" ] ;;
    *) false ;;
  esac || { echo "hwdp surfaces: no temp dir in $DESKS" >&2; return 1; }
  _wq="'$_wd'"
  # shellcheck disable=SC2064  # the literal path, baked in when armed
  trap "rm -rf $_wq" EXIT INT TERM
}

# install_desk <scratch dir> <verb>: the candidate <dir>/<desk>.conf is
# validated by this same command before anything is replaced, refused whole
# (exit 2) if broken; else the old file is kept in the state dir and the
# candidate moved into place, its path printed, and `saved` fired. The ONE
# tail of both writers, so they cannot validate or record differently.
install_desk() {
  if ! HWDP_DESKS=$1 HWDP_SURFACES=$1/none HWDP_DESK=$_desk "$0" \
      >/dev/null 2>"$1/err"
  then
    # The candidate is a scratch file, so its PATH says nothing: name the
    # line of the desk file it would have become.
    _at="s|$1/$_desk\\.conf:\\([0-9][0-9]*\\): |"
    sed -e "${_at}line \\1 of the new $_desk.conf: |" -e 's/^/  /' \
      "$1/err" >&2
    echo "hwdp surfaces: $2: NOT written, the result would be broken" >&2
    return 2
  fi
  _dst=$DESKS/$_desk.conf
  if [ -f "$_dst" ] && ! cmp -s "$1/$_desk.conf" "$_dst"; then
    _bk=${XDG_STATE_HOME:-${HOME:-}/.local/state}/hwdp/surfaces
    mkdir -p "$_bk"
    cp -p "$_dst" "$_bk/$_desk.conf.bak"
  fi
  mv "$1/$_desk.conf" "$_dst"
  printf '%s\n' "$_dst"
  fire_saved "$_dst"
}

# write_wallpapers: REPLACE this desk's wallpapers from `X Y FILE` lines on
# stdin (none clears them), the ONE writer of them. Every other line of the
# file read stays exactly as it was, and it always writes THIS desk's own
# file, as --write does. FILE is a file in the wallpaper directory, which is
# the integrator's: relative, no `..`. Refused whole on a bad line; a cell
# outside the grid is NOT refused (a grid shrunk later must not make the
# file invalid), only left unpublished.
write_wallpapers() {
  desk_scratch || return 1
  awk '/^[ \t]*(#|$)/ { next }
    {
      line = $0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
      if (!match(line, /^[0-9]+[ \t]+[0-9]+[ \t]+[^ \t]/)) {
        print "hwdp surfaces: --write-wallpapers: expected `X Y FILE`: " \
          $0 > "/dev/stderr"; bad = 1; next
      }
      f = line; sub(/^[0-9]+[ \t]+[0-9]+[ \t]+/, "", f)
      if (f ~ /^\// || f ~ /(^|\/)\.\.(\/|$)/) {
        print "hwdp surfaces: --write-wallpapers: `" f "` is not a file" \
          " in the wallpaper directory" > "/dev/stderr"; bad = 1; next
      }
      print "wallpaper cell " $1 " " $2 " " f
    }
    END { exit bad ? 2 : 0 }' > "$_wd/given" || return 2
  { desk_header
    if [ -n "$_file" ]; then
      grep -v -e '^[ \t]*#' -e '^[ \t]*$' -e '^[ \t]*wallpaper[ \t]' \
        "$_file" || :
    fi
    cat "$_wd/given"
  } > "$_wd/$_desk.conf"
  install_desk "$_wd" --write-wallpapers
}


if [ "$MODE" = follow ]; then
  shift
  if [ $# -lt 3 ]; then
    echo "usage: hwdp surfaces --follow FROM X Y [NAME...]" >&2
    exit 2
  fi
  _from=$1 _fx=$2 _fy=$3
  shift 3
  case "$_fx.$_fy" in
    *[!0-9.]*|.*|*.) echo "hwdp surfaces: --follow: X and Y are cells" >&2
                     exit 2 ;;
  esac
  case $_from in
    */*|.*) echo "hwdp surfaces: --follow: bad desk \`$_from\`" >&2
            exit 2 ;;
  esac
  _old=
  if [ -n "$_from" ]; then
    _old=$(HWDP_DESK=$_from "$0" --raw 2>/dev/null) || _old=
    if [ -z "$_old" ]; then
      . "$HWDP_LIB/desks_lib"
      _k=$(desk_kind "$_from" 2>/dev/null) || _k=
      [ -n "$_k" ] && _old=$(HWDP_DESK=$_k "$0" --raw 2>/dev/null) || :
    fi
  fi
  _now=$(env -u HWDP_DESK "$0" 2>/dev/null) || _now=
  _hit=$({
    printf '%s\n' "$_old" | awk -F"$TAB" -v x="$_fx" -v y="$_fy" '
      $1 == "surface" && $4 == x && $5 == y {
        print (($3 == "@builtin") ? 0 : 1) (($6 == "full") ? 0 :
          ($6 == "top" || $6 == "left") ? 1 : 2) "\t" $2 }' \
      | sort -s -k1,1 | cut -f2 | sed 's/^/c\t/'
    for _n in "$@"; do printf 'c\t%s\n' "$_n"; done
    printf '%s\n' "$_now" \
      | awk -v OFS="$TAB" 'NF >= 4 { print "n", $1, $3, $4 }'
  } | awk -F"$TAB" '$1 == "c" { c[++k] = $2; next }
      $1 == "n" && !($2 in at) { at[$2] = $3 " " $4 }
      END { for (i = 1; i <= k; i++) if (c[i] in at) {
              print at[c[i]], c[i]; exit }
            if (k) print "- -", c[1] }')
  [ -n "$_hit" ] && printf '%s\n' "$_hit"
  case $_hit in
    '- -'*|'') exit 1 ;;
  esac
  exit 0
fi

_file=
if [ -n "${HWDP_DESK:-}" ]; then
  # A NAMED desk, attached or not: its own file only.
  case $HWDP_DESK in
    */*|.*|'') echo "hwdp surfaces: bad HWDP_DESK \`$HWDP_DESK\`" >&2
               exit 2 ;;
  esac
  _desk=$HWDP_DESK
  for _f in "$DESKS/$_desk.conf" "$SURF/$_desk.conf"; do
    if [ -f "$_f" ]; then _file=$_f; break; fi
  done
  _bn=$(builtin_name 2>/dev/null) || _bn=
else
  _id=$(hwdp_id)
  if [ -z "$_id" ]; then
    [ "$MODE" = check ] && echo "hwdp surfaces: no displays attached"
    exit 0
  fi
  # THIS desk's file, then a generic one for its kind, then the files from
  # before desk files existed (under the desk id, then the plain id).
  _desk=$(desk_id)
  for _f in "$DESKS/$_desk.conf" "$DESKS/$(shape).conf" \
      "$SURF/$_desk.conf" "$SURF/$_id.conf"; do
    if [ -f "$_f" ]; then _file=$_f; break; fi
  done
  _bn=$(builtin_name)
fi
if [ "$MODE" = write ]; then
  write_file
  exit $?
fi
if [ "$MODE" = write-wallpapers ]; then
  write_wallpapers
  exit $?
fi
if [ "$MODE" = default-wallpapers ]; then
  # The shape of THIS desk: away from it (HWDP_DESK), from its files.
  if [ -n "${HWDP_DESK:-}" ]; then
    . "$HWDP_LIB/desks_lib"
    _sh=$(desk_kind "$HWDP_DESK") || _sh=
  else
    _sh=$(shape) || _sh=
  fi
  [ -n "$_sh" ] || exit 0
  probe_run wallpapers "$_sh" | awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ &&
      NF >= 3 { f = $0; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+/, "", f)
                sub(/[ \t]+$/, "", f); print $1, $2, f }' || :
  exit 0
fi
if [ "$MODE" = wallpapers ]; then
  [ -n "$_file" ] || exit 0
  awk '$1 == "grid" && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && !gw {
         gw = $2; gh = $3 }
    $1 == "wallpaper" && $2 == "cell" && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {
      f = $0; sub(/^[ \t]*wallpaper[ \t]+cell[ \t]+/, "", f)
      sub(/^[0-9]+[ \t]+[0-9]+[ \t]+/, "", f); sub(/[ \t]+$/, "", f)
      n++; X[n] = $3; Y[n] = $4; F[n] = f }
    END { for (i = 1; i <= n; i++)
            if (!gw || (X[i] + 0 < gw && Y[i] + 0 < gh))
              print X[i], Y[i], F[i] }' "$_file"
  exit 0
fi
if [ "$MODE" = grid ]; then
  [ -n "$_file" ] || exit 0
  awk '$1 == "grid" && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
         print $2, $3; exit }' "$_file"
  exit 0
fi
if [ "$MODE" = raw ]; then
  [ -n "$_file" ] || exit 0
  awk -v OFS="$TAB" '$1 == "split" {
      l = $0; if (!match(l, /"[^"]+"/)) next
      pn = substr(l, RSTART + 1, RLENGTH - 2)
      n = split(substr(l, RSTART + RLENGTH), w, /[ \t]+/)
      for (i = 1; i <= n; i++) if (w[i] == "cell") {
        print "split", "-", pn, w[i + 1], w[i + 2], w[i + 3]; next }
    }
    $1 == "surface" || $1 == "default" {
      kw = $1; nm = $2; l = $0
      if (!match(l, /"[^"]+"/)) next
      pn = substr(l, RSTART + 1, RLENGTH - 2)
      rest = substr(l, RSTART + RLENGTH)
      n = split(rest, w, /[ \t]+/); cx = cy = "*"; rg = "full"
      for (i = 1; i <= n; i++) {
        if (w[i] == "cell") { cx = w[i + 1]; cy = w[i + 2]; i += 2 }
        else if (w[i] ~ /^(top|bottom|left|right|full)$/) rg = w[i]
      }
      print kw, nm, pn, cx, cy, rg }' "$_file"
  exit 0
fi
if [ -z "$_file" ]; then
  [ "$MODE" = check ] && echo "no surfaces for this desk ($DESKS/$_desk.conf)"
  exit 0
fi

if ! _live=$(probe_layout); then
  if [ -z "${HWDP_DESK:-}" ]; then
    echo "hwdp surfaces: no layout provider could answer; surfaces need a" \
         "session (the compositor knows which outputs are on)" >&2
    exit 3
  fi
  # A named desk away from its panels: validated in full, resolved to
  # nothing (every check that can refuse the file runs before resolution).
  _live=
fi
# connector -> panel id, as `hwdp id --panels` prints it, for --map.
_pids=$(probe_panels | awk -F"$TAB" '$2 != "" && $1 != "" {
          print $2, substr($1, 1, 12) }')
_nf=$NAMES; [ -f "$_nf" ] || _nf=/dev/null
[ "$MODE" = check ] && echo "desk file: $_file"
[ "$MODE" = check ] && [ "$_nf" = /dev/null ] \
  && echo "note  no names file ($NAMES): names are not checked"

. "$HWDP_LIB/surfaces_lib"
if [ "$MODE" = labels ]; then
  # Resolved as the plain record, THEN labelled: a file the resolver
  # refuses still exits 2 with nothing on stdout.
  _out=$(printf '%s\n' "$_live" | surfaces_resolve emit "$_file" "$_nf" \
    "$_bn" "$_pids") || exit $?
  [ -n "$_out" ] || exit 0
  # By FILENAME, not FNR == NR: that is true for the SECOND file when the
  # first is empty, and with no names list the first is /dev/null.
  printf '%s\n' "$_out" | awk -v nf="$_nf" 'FILENAME == nf {
      if ($0 ~ /^[ \t]*(#|$)/) next
      n = $1; sub(/^[ \t]*[^ \t]+[ \t]*/, ""); L[n] = ($0 == "" ? n : $0)
      next }
    { print $0, (($1 in L) ? L[$1] : $1) }' "$_nf" -
  exit 0
fi
printf '%s\n' "$_live" | surfaces_resolve "$MODE" "$_file" "$_nf" "$_bn" \
  "$_pids"
