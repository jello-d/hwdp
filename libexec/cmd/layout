#!/bin/sh
# hwdp layout: emit the runtime kanshi config for the connected set and print
# its path. `hwdp watch` runs this at supervisor start and points kanshi at it.
#
# This is the kanshi ADAPTER: the probe layer above it is compositor-agnostic,
# but the file this writes is kanshi's format and makes no apology for it.
#
# Layout selection is by HARDWARE, not hostname: the connected set's id names a
# profile under $PROFILES (profiles/<id>.conf). A matching profile is the
# AUTHORED layout (transforms/positions) and this only injects each output's
# scale into it; with none, a simple side-by-side profile is synthesized, so a
# single-panel laptop needs no profile at all.
#
# The scale is STICKY and hand-editable: it lives in $STICKY keyed by the
# output's EDID with a per-output SIGNATURE, and is recomputed only when that
# signature changes (a panel swap). A hand edit sticks until then, detection
# is smart but never clobbers an override.
#
# SCALE MODEL. We NEVER downscale: a scale < 1 enlarges the logical space past
# the panel and the compositor downsamples to soft, bit-mashed text. The
# compositor hard-floors output scale at 1 anyway, so a scale < 1 can never
# actually render: measured, `wlr-randr --scale 0.65` exits 0 and does
# nothing while 1.25 applies. Anything below 1 is therefore CLAMPED here, with
# a note, rather than written into a config that would lie about the session.
# (Older model: scale = min(1, sqrt(area/design_area)), retired, it blurred.)
#
# Above 1 IS used, but only when asked for, via HWDP_TARGET_PPI.
#
#   unset (DEFAULT)   every output stays at 1.00 and physical density is
#     absorbed by the UI NUMBERS instead (see `hwdp ui`). Exact for ONE panel
#     or a wall of IDENTICAL panels, and what every box did before this.
#
#   HWDP_TARGET_PPI=<n>   each output is scaled so its LOGICAL density lands
#     near <n>. This is what makes MIXED densities work, and it is the only
#     thing that can: every consumer of `hwdp ui` has one global config (kitty
#     one font_size, pixdecor one compositor-wide title_font, mako one font),
#     so there is nowhere to put a per-output value. Equalising the LOGICAL
#     density instead makes one set correct on every panel.
#
# It costs LOGICAL REAL ESTATE, not sharpness, a point worth stating because
# it was got wrong once here. The compositor advertises
# wp_fractional_scale_manager_v1 and wp_viewporter, so a client that supports
# them renders at the fractional device scale: a 4K at 1.75 draws text at 1.75x
# device pixels, fully crisp. What shrinks is the logical desktop (3840x2160 ->
# 2194x1234), which is the actual trade.
#
# OPT-IN because the two models want different UI numbers, and `hwdp ui` keys
# off the same variable so the pair stays consistent: with a target set it
# sizes for that target's density, and without one it buckets by panel width.
set -eu
. "$HWDP_LIB/displayset_lib"

# scale_for <res_w> <res_h> <mm_w> <mm_h>: the computed scale for one output.
#
# Physical density comes from the EDID's millimetre size, which is the only
# thing that distinguishes a 27" 4K panel from a 13" one at the same
# resolution, because resolution alone cannot answer this.
#
# Snapped to quarter steps because a compositor renders 1.25/1.5/1.75/2 well
# and an arbitrary 1.7213 buys nothing; capped at 3 so a bogus EDID (some
# panels report 0mm, some lie) cannot produce an absurd logical size. A
# missing or zero size falls back to 1.00 rather than guessing.
scale_for() {   # -> a scale >= 1.00, two decimals
  [ -n "${HWDP_TARGET_PPI:-}" ] || { printf '1.00'; return 0; }
  awk -v rw="${1:-0}" -v mmw="${3:-0}" -v target="$HWDP_TARGET_PPI" 'BEGIN {
    if (rw <= 0 || mmw <= 0 || target <= 0) { printf "1.00"; exit }
    ppi = rw / (mmw / 25.4)
    s   = ppi / target
    s   = int(s * 4 + 0.5) / 4          # quarter steps
    if (s < 1) s = 1                    # never downscale
    if (s > 3) s = 3                    # a lying EDID cannot run away with it
    printf "%.2f", s
  }'
}

# resolve <edid> <signature> <computed>: the sticky scale for this output. Keep
# the stored value when the signature matches (honouring a hand edit), else
# adopt <computed>. Rewrites the output's line in $STICKY, prints the scale.
resolve() {
  _edid=$1; _sig=$2; _scale=$3
  if [ -f "$STICKY" ]; then
    _line=$(awk -F"$TAB" -v e="$_edid" '$1==e{print;exit}' "$STICKY")
    _cur=$(printf '%s' "$_line" | cut -f3)
    if [ -n "$_line" ] && [ "$_cur" = "$_sig" ]; then
      _scale=$(printf '%s' "$_line" | cut -f2)
    fi
  fi
  # CLAMP a sub-1 scale, wherever it came from: a stale entry left by the
  # retired downscale model, or a hand edit. It cannot render (the compositor
  # floors at 1), so writing it into kanshi's config produces a file that
  # claims a scale the session will never have. Say so once, per output:
  # silently "honouring" an override that does nothing is the worse failure.
  if awk -v s="$_scale" 'BEGIN { exit !(s + 0 < 1) }' 2>/dev/null; then
    echo "hwdp layout: scale $_scale for '$_edid' is below 1 and cannot" \
      "render (the compositor floors it); using 1.00" >&2
    _scale=1.00
  fi
  # The temp goes BESIDE $STICKY, not in /tmp. A bare `mktemp` lands on
  # whatever /tmp is (usually tmpfs) and a `mv` from there to ~/.config
  # crosses filesystems, where mv degrades to copy-then-delete and stops being
  # atomic. That defeats the entire point of writing through a temp: an abort
  # mid-copy leaves a HALF-WRITTEN sticky file, and this one holds every
  # panel's scale.
  mkdir -p "$(dirname "$STICKY")"
  _tmp=$(mktemp "$(dirname "$STICKY")/.auto-scale.XXXXXX")
  [ -f "$STICKY" ] && awk -F"$TAB" -v e="$_edid" '$1!=e' "$STICKY" >"$_tmp"
  printf '%s\t%s\t%s\n' "$_edid" "$_scale" "$_sig" >>"$_tmp"
  mv "$_tmp" "$STICKY"
  printf '%s' "$_scale"
}

# Inject each output's scale into the authored profile, leaving every other line
# of it alone.
gen_template() {
  # A DESK's profile names the laptop's own panel by role (@builtin, see
  # desk_id): fill in the live built-in's name, and its native mode, since
  # the mode belongs to whichever laptop is plugged in, not to the desk.
  _bn=$(builtin_name)
  _bm=$(awk -F"$TAB" -v b="$_bn" \
    '$1 == b { printf "%sx%s@%.3fHz", $4, $5, $6; exit }' "$_map")
  while IFS= read -r _l; do
    case $_l in
      *'output "@builtin"'*)
        _l=$(printf '%s\n' "$_l" | awk -v b="$_bn" -v m="$_bm" '{
          sub(/"@builtin"/, "\"" b "\"")
          if (m != "" && $0 !~ / mode / && $0 !~ / disable$/)
            sub(/" /, "\" mode " m " ")
          print }') ;;
    esac
    case $_l in
      # A disabled output takes no scale: it occupies nothing, and the line is
      # what keeps the profile MATCHING kanshi (see cmd/capture).
      *'output "'*' disable') printf '%s\n' "$_l" ;;
      *'output "'*)
        _e=$(printf '%s' "$_l" | sed -n 's/.*output "\([^"]*\)".*/\1/p')
        _v=$(awk -F"$TAB" -v e="$_e" '$1==e{print $2;exit}' "$_map")
        if [ -n "$_v" ]; then
          printf '%s scale %s\n' \
            "$(printf '%s' "$_l" | sed 's/ scale [0-9.]*//')" "$_v"
        else printf '%s\n' "$_l"; fi ;;
      *) printf '%s\n' "$_l" ;;
    esac
  done <"$TEMPLATE"
}

# RE-PLACE an authored profile whose sizes changed since capture, rewriting
# $_otmp in place (see layout_repack). Only when capture left its rects AND
# every authored position still matches them: a position that differs was
# moved by hand, and a hand edit wins over the arithmetic, so it is left
# exactly as written and the gap check below speaks for it instead. With
# nothing changed this is a no-op, so the authored file comes through intact.
repack_template() {
  _old=$(profile_rects <"$TEMPLATE")
  [ -n "$_old" ] || return 0
  _now=$(config_rects <"$_otmp")
  # The desk's rects name the built-in by role; the generated config by the
  # live panel's name. Compare and re-place in the role's terms.
  _bn=; grep -q '^# hwdp-rect "@builtin"' "$TEMPLATE" && _bn=$(builtin_name)
  [ -n "$_bn" ] && _now=$(printf '%s\n' "$_now" | awk -F"$TAB" \
    -v OFS="$TAB" -v b="$_bn" '$1 == b { $1 = "@builtin" } { print }')
  _v=$( { printf '%s\n' "$_old" | awk -v OFS="$TAB" '{ print "old", $0 }'
          printf '%s\n' "$_now" | awk -v OFS="$TAB" '{ print "now", $0 }'
        } | awk -F"$TAB" '
    $1 == "old" { X[$2] = $3; Y[$2] = $4; W[$2] = $5; H[$2] = $6; next }
    $1 == "now" && why == "" {
      if (!($2 in X)) why = $2 " is not in the captured rects"
      else if ($3 != X[$2] || $4 != Y[$2]) why = $2 " was moved by hand"
      else if (r == "" && ($5 != W[$2] || $6 != H[$2]))
        r = $2 " " W[$2] "x" H[$2] " -> " $5 "x" $6
    }
    END {
      if (why != "") print "edited\t" why
      else if (r != "") print "resized\t" r
    }')
  case $_v in
    edited*)
      echo "hwdp layout: authored layout left as written:" \
        "${_v#*"$TAB"}" >&2
      return 0 ;;
    resized*) ;;
    *) return 0 ;;
  esac
  _plan=$(mktemp "$(dirname "$OUT")/.hwdp-repack.XXXXXX")
  { printf '%s\n' "$_old" | awk -v OFS="$TAB" '{ print "old", $0 }'
    printf '%s\n' "$_now" | awk -F"$TAB" -v OFS="$TAB" \
      '{ print "new", $1, $4, $5 }'
  } | layout_repack >"$_plan"
  _rtmp=$(mktemp "$(dirname "$OUT")/.hwdp-layout.XXXXXX")
  awk -F"$TAB" -v b="${_bn:-}" 'NR == FNR { P[$1] = $2 "," $3; next }
    /^[ \t]*output "/ && !/ disable([ \t]|$)/ {
      nm = $0; sub(/^[ \t]*output "/, "", nm); sub(/".*/, "", nm)
      if (nm == b && ("@builtin" in P)) nm = "@builtin"
      if (nm in P) sub(/ position -?[0-9]+,-?[0-9]+/, " position " P[nm])
    }
    { print }' "$_plan" "$_otmp" >"$_rtmp"
  mv "$_rtmp" "$_otmp"
  rm -f "$_plan"
  echo "hwdp layout: re-placed the authored layout for the current" \
    "scales (${_v#*"$TAB"})" >&2
}

# No authored profile: lay the outputs out side by side, left to right, each
# starting exactly where the previous one ENDS in the compositor's own logical
# arithmetic (lsize: rotated, then truncated by scale). It used to advance by
# round(mode_w / scale), which was a pixel short of the compositor for any
# scale leaving a fraction >= .5, and wrong by the whole difference between
# width and height for a rotated output.
gen_fallback() {
  printf '# generated by hwdp layout (no matching layout profile)\n'
  printf 'profile autoscale {\n'
  _x=0
  while IFS="$TAB" read -r edid scale name rw rh rate tr; do
    _t=""; [ "$tr" != normal ] && _t=" transform $tr"
    printf '    output "%s" mode %sx%s@%.3fHz%s position %d,0 scale %s\n' \
      "$edid" "$rw" "$rh" "$rate" "$_t" "$_x" "$scale"
    _lw=$(awk -v w="$rw" -v h="$rh" -v t="$tr" -v s="$scale" \
      "$HWDP_AWK_LOGICAL"'BEGIN { lsize(w, h, t, s); printf "%d", LW }')
    _x=$((_x + _lw))
  done <"$_map"
  printf '}\n'
}

TEMPLATE=${KANSHI_TEMPLATE:-$(profile_for)}
_map=$(mktemp)
trap 'rm -f "$_map"' EXIT INT TERM
outputs | while IFS="$TAB" read -r edid name rw rh mmw mmh rate tr pos; do
  _sc=$(resolve "$edid" "${rw}x${rh}@${mmw}x${mmh}" \
    "$(scale_for "$rw" "$rh" "$mmw" "$mmh")")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$edid" "$_sc" "$name" "$rw" "$rh" "$rate" "$tr" >>"$_map"
done
mkdir -p "$(dirname "$OUT")"
# ATOMIC, because $OUT is LIVE: kanshi is watching this file and `hwdp watch`
# restarts it when the file changes. Generating straight into it truncates it
# first, so an abort part-way (a provider dying mid-stream under `set -e`) hands
# the running session a half-written layout rather than the previous good one.
# Temp beside the destination, for the cross-filesystem reason above.
_otmp=$(mktemp "$(dirname "$OUT")/.hwdp-layout.XXXXXX")
_plan=; _rtmp=   # repack_template's, when it runs
trap 'rm -f "$_map" "$_otmp" ${_plan:+"$_plan"} ${_rtmp:+"$_rtmp"}' \
  EXIT INT TERM
if [ -s "$TEMPLATE" ] && grep -q 'output ' "$TEMPLATE"; then
  gen_template >"$_otmp"
  repack_template
else
  gen_fallback >"$_otmp"
fi
# THE NO-GAP INVARIANT, checked HERE because this is the first point at which
# the logical sizes are known: an authored profile carries positions and NO
# scale (capture leaves it out on purpose), and the sticky scales are injected
# just above. So a profile captured edge to edge can still come out gapped or
# overlapping once a scale changes. WARN, never refuse: refusing would leave
# the session with no layout at all, which is worse than an imperfect one, and
# the warning lands in the supervisor's log where `check` can read it.
_faults=$(config_rects <"$_otmp" | layout_faults)
if [ -n "$_faults" ]; then
  printf '%s\n' "$_faults" | layout_fault_text \
    | sed 's/^/hwdp layout: WARNING: /' >&2
fi
# 0644: kanshi reads it as the session user, and mktemp makes it 0600.
chmod 644 "$_otmp"
mv "$_otmp" "$OUT"
printf '%s\n' "$OUT"
