#!/bin/sh
# hwdp shape: the workspace SHAPE, what KIND of desk is attached: one token per
# display, B(uilt-in) or E(xternal) then L(andscape) or P(ortrait), joined
# with `+` and sorted (BL, EL+EP, BL+EL+EP, EP+EP+EP). Empty with no displays.
# The grid, workspace names, window rules and wallpaper key on it; see shape()
# in displayset_lib for why sorted, and what a headless answer cannot know.
#
#   hwdp shape --outputs    each display's own token: `<connector> <token>`
set -eu
. "$HWDP_LIB/displayset_lib"
case "${1:-}" in
  '') shape ;;
  --outputs) shape_tokens | tr '\t' ' ' ;;
  *) echo "hwdp shape: unknown argument: $1 (try --outputs)" >&2; exit 2 ;;
esac
