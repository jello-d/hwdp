#!/bin/sh
# hwdp map: draw this desk in text. The outputs that are switched on, placed
# and sized as the compositor has them (logical pixels, after rotation and
# scale), each labelled with its connector, its shape token and its size;
# this desk's surfaces drawn into them; then the shape, a legend, and anything
# wrong with the arrangement.
#
#   --width N   columns to draw in (default: $COLUMNS, else 80)
#
# A REPORT, NOT A UI: it reads and prints, the way `usher doctor` does, so it
# is safe to run at any time and its output can be pasted into a note. It
# reads the surfaces through `hwdp surfaces` (the published contract) and the
# gap check through layout_faults, so it can never disagree with either.
#
# Halves that carry a surface, and panels CUT in two (`hwdp surfaces
# --splits`) even with nothing placed, are split with dots, so a panel's
# border (`|`, `-`) and a region's (`:`, `.`) cannot be confused. Every cell
# is drawn over one picture, a surface's label naming its cell, so a cut's
# own cell (and any half still empty) is in the legend. A box too small for
# its labels truncates them; the legend below always has the whole text.
#
# Then the GRID: the desk again in every workspace cell, small, holding only
# that cell's surfaces, cuts and, in parentheses, the DEFAULT where nothing
# in the cell claims its place (from `hwdp surfaces --map`, which is total).
# A desk with no grid of its own shows the cells its surfaces use. Cells
# wrap onto more lines when the width cannot hold a row of them.
set -eu
. "$HWDP_LIB/displayset_lib"

WIDTH=${COLUMNS:-80}
while [ $# -gt 0 ]; do
  case $1 in
    --width)   WIDTH=${2:-}; shift ;;
    --width=*) WIDTH=${1#*=} ;;
    -h|--help) . "$HWDP_LIB/help_lib"; help_print "$0"; exit 0 ;;
    *) echo "hwdp map: unexpected argument '$1'" >&2; exit 2 ;;
  esac
  shift
done
case $WIDTH in
  ''|*[!0-9]*) echo "hwdp map: --width wants a number" >&2; exit 2 ;;
esac
[ "$WIDTH" -ge 20 ] || WIDTH=20

# grid_map: the GRID section, from out/srf/spl/grd records (see above). A
# considered exception to the 50-line rule: one awk program, a drawing.
grid_map() {
  awk -F"$TAB" -v cols="$WIDTH" '
  function put(x, y, c) {
    if (x >= 0 && x < CW && y >= 0 && y < CH) G[y, x] = c
  }
  function text(x, y, s, max,   i) {
    if (max < 1) return
    s = substr(s, 1, max)
    for (i = 1; i <= length(s); i++) put(x + i - 1, y, substr(s, i, 1))
  }
  function box(x0, y0, x1, y1,   x, y) {
    for (x = x0; x <= x1; x++) { put(x, y0, "-"); put(x, y1, "-") }
    for (y = y0; y <= y1; y++) { put(x0, y, "|"); put(x1, y, "|") }
    put(x0, y0, "+"); put(x1, y0, "+"); put(x0, y1, "+"); put(x1, y1, "+")
  }
  # A part of panel i, from its fractions, as the cell draws it.
  function part(i, fx, fy, fw, fh,   pw, ph) {
    pw = P1[i] - P0[i]; ph = Q1[i] - Q0[i]
    a0 = P0[i] + int(fx * pw); a1 = P0[i] + int((fx + fw) * pw)
    b0 = Q0[i] + int(fy * ph); b1 = Q0[i] + int((fy + fh) * ph)
  }
  function label(s) {
    if (b1 - b0 >= 2) text(a0 + 1, b0 + int((b1 - b0) / 2), s, a1 - a0 - 1)
    else text(a0 + 1, b0 + 1, s, a1 - a0 - 1)
  }
  function cut(i, w,   x, y) {
    if (w == "top-bottom")
      for (x = P0[i] + 1; x < P1[i]; x++)
        put(x, int((Q0[i] + Q1[i]) / 2), ".")
    else
      for (y = Q0[i] + 1; y < Q1[i]; y++)
        put(int((P0[i] + P1[i]) / 2), y, ":")
  }
  $1 == "out" { n++; C[n] = $2; X[n] = $3; Y[n] = $4; W[n] = $5
                H[n] = $6; IX[$2] = n; next }
  $1 == "srf" && $4 == "*" { DN = $2; DC = $3; DF = $6 " " $7 " " $8 " " $9
                             next }
  $1 == "srf" { m++; SN[m] = $2; SC[m] = $3; SX[m] = $4; SY[m] = $5
                FX[m] = $6; FY[m] = $7; FW[m] = $8; FH[m] = $9
                if ($4 + 1 > UW) UW = $4 + 1; if ($5 + 1 > UH) UH = $5 + 1
                next }
  $1 == "spl" { q++; KC[q] = $2; KX[q] = $3; KY[q] = $4; KW[q] = $5
                if ($3 + 1 > UW) UW = $3 + 1; if ($4 + 1 > UH) UH = $4 + 1
                next }
  $1 == "grd" { GW = $2; GH = $3 }
  END {
    if (n == 0) exit
    note = ""
    if (!GW) { GW = UW ? UW : 1; GH = UH ? UH : 1
               note = "  (none set: the cells in use)" }
    minx = X[1]; miny = Y[1]; maxx = X[1] + W[1]; maxy = Y[1] + H[1]
    for (i = 2; i <= n; i++) {
      if (X[i] < minx) minx = X[i]; if (Y[i] < miny) miny = Y[i]
      if (X[i] + W[i] > maxx) maxx = X[i] + W[i]
      if (Y[i] + H[i] > maxy) maxy = Y[i] + H[i]
    }
    per = GW
    while (per > 1 && int((cols + 1) / per) - 1 < 32) per--
    cw = int((cols + 1) / per) - 1
    sx = (cw - 3) / (maxx - minx); sy = sx / 2
    ch = int((maxy - miny) * sy) + 3
    lines = int((GW + per - 1) / per)
    CW = cols; CH = GH * lines * (ch + 1)
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) G[y, x] = " "
    for (cy = 0; cy < GH; cy++) for (cx = 0; cx < GW; cx++) {
      ox = (cx % per) * (cw + 1)
      oy = (cy * lines + int(cx / per)) * (ch + 1)
      box(ox, oy, ox + cw - 1, oy + ch - 1)
      text(ox + 2, oy, " " cx "," cy " ", cw - 4)
      for (i = 1; i <= n; i++) {
        P0[i] = ox + 1 + int((X[i] - minx) * sx)
        P1[i] = ox + 1 + int((X[i] + W[i] - minx) * sx)
        Q0[i] = oy + 1 + int((Y[i] - miny) * sy)
        Q1[i] = oy + 1 + int((Y[i] + H[i] - miny) * sy)
        if (P1[i] > ox + cw - 2) P1[i] = ox + cw - 2
        if (Q1[i] > oy + ch - 2) Q1[i] = oy + ch - 2
        box(P0[i], Q0[i], P1[i], Q1[i])
      }
      for (j = 1; j <= q; j++)
        if (KX[j] == cx && KY[j] == cy && IX[KC[j]]) cut(IX[KC[j]], KW[j])
      delete TAKEN
      for (j = 1; j <= m; j++) {
        if (SX[j] != cx || SY[j] != cy || !IX[SC[j]]) continue
        if (FH[j] < 1) cut(IX[SC[j]], "top-bottom")
        if (FW[j] < 1) cut(IX[SC[j]], "left-right")
        TAKEN[SC[j], FX[j] " " FY[j] " " FW[j] " " FH[j]] = 1
        TAKEN[SC[j], "any"] = 1
        if (FW[j] == 1 && FH[j] == 1) TAKEN[SC[j], "whole"] = 1
      }
      for (j = 1; j <= m; j++) {
        if (SX[j] != cx || SY[j] != cy || !IX[SC[j]]) continue
        part(IX[SC[j]], FX[j], FY[j], FW[j], FH[j]); label(SN[j])
      }
      # The default where this cell leaves its place empty: its panel not
      # whole, and its own part not taken (a half beside it does not count).
      if (DN != "" && IX[DC] && !((DC, "whole") in TAKEN) &&
          !((DC, DF) in TAKEN) && !(DF == "0 0 1 1" && (DC, "any") in TAKEN)) {
        split(DF, f, " "); part(IX[DC], f[1], f[2], f[3], f[4])
        label("(" DN ")")
      }
    }
    printf "GRID %dx%d%s\n", GW, GH, note
    for (y = 0; y < CH; y++) {
      line = ""
      for (x = 0; x < CW; x++) line = line G[y, x]
      sub(/ +$/, "", line)
      if (line != "" || y < CH - 1) print line
    }
    if (DN != "")
      printf "  (name) is the default: where a cell leaves its place empty\n"
  }'
}

if ! _live=$(probe_layout); then
  echo "hwdp map: no layout provider could answer; the map needs a session" \
       "(only the compositor knows where the outputs are)" >&2
  exit 3
fi

# The surfaces as published; a broken file is reported, never drawn half.
_srf=; _srf_rc=0
_srf=$("$HWDP_LIBEXEC/cmd/surfaces" 2>/dev/null) || _srf_rc=$?
# A broken file answers nothing here either: the resolver refuses it whole
# before any mode runs.
_spl=$("$HWDP_LIBEXEC/cmd/surfaces" --splits 2>/dev/null) || _spl=

_shape=$(shape)
_map=$("$HWDP_LIBEXEC/cmd/surfaces" --map 2>/dev/null) || _map=
_grid=$("$HWDP_LIBEXEC/cmd/surfaces" --grid 2>/dev/null) || _grid=
_faults=$(live_rects | layout_faults | layout_fault_text)

_outs=$(printf '%s\n' "$_live" | awk -F"$TAB" -v OFS="$TAB" \
  "$HWDP_AWK_LOGICAL"'
    $12 == 1 && $3 + 0 > 0 {
      lsize($3, $4, $8, $9)
      k = ($2 ~ /^(eDP|LVDS|DSI)/) ? "B" : "E"
      print "out", $2, $10, $11, LW, LH, k ((LH > LW) ? "P" : "L"), $1
    }')
{
  printf '%s\n' "$_outs"
  [ -n "$_srf" ] && printf '%s\n' "$_srf" | awk -v OFS="$TAB" \
    '{ print "srf", $1, $2, $3, $4, $5, $6, $7, $8 }'
  [ -n "$_spl" ] && printf '%s\n' "$_spl" | awk -v OFS="$TAB" \
    '{ print "spl", $1, $2, $3, $4 }'
  :
} | awk -F"$TAB" -v cols="$WIDTH" '
  function put(x, y, c) {
    if (x >= 0 && x < CW && y >= 0 && y < CH) G[y, x] = c
  }
  # The divider a cut panel shows, the same for a surface in a half and for
  # a cut with nothing in it yet.
  function cut(i, w,   x, y, my, mx) {
    if (w == "top-bottom") {
      my = int((y0[i] + y1[i]) / 2)
      for (x = x0[i] + 1; x < x1[i]; x++) put(x, my, ".")
    } else {
      mx = int((x0[i] + x1[i]) / 2)
      for (y = y0[i] + 1; y < y1[i]; y++) put(mx, y, ":")
    }
  }
  function text(x, y, s, max,   i) {
    if (max < 1) return
    s = substr(s, 1, max)
    for (i = 1; i <= length(s); i++) put(x + i - 1, y, substr(s, i, 1))
  }
  $1 == "out" {
    n++; C[n] = $2; X[n] = $3; Y[n] = $4; W[n] = $5; H[n] = $6
    K[n] = $7; NM[n] = $8; IX[$2] = n
    next
  }
  $1 == "srf" {
    m++; SN[m] = $2; SC[m] = $3; SWX[m] = $4; SWY[m] = $5
    SX[m] = $6; SY[m] = $7; SW[m] = $8; SH[m] = $9
    # Which half it fills, for the legend of a cut: first or second. The
    # outputs came first, so the size of the panel is known here.
    i = IX[$3]
    if (i && (SW[m] < W[i] || SH[m] < H[i]))
      HALF[$3, $4, $5, (SX[m] > 0 || SY[m] > 0) ? 2 : 1] = 1
    next
  }
  $1 == "spl" {
    q++; KC[q] = $2; KX[q] = $3; KY[q] = $4; KW[q] = $5
  }
  END {
    if (n == 0) { print "(no outputs switched on)"; exit }
    minx = X[1]; miny = Y[1]; maxx = X[1] + W[1]; maxy = Y[1] + H[1]
    for (i = 2; i <= n; i++) {
      if (X[i] < minx) minx = X[i]; if (Y[i] < miny) miny = Y[i]
      if (X[i] + W[i] > maxx) maxx = X[i] + W[i]
      if (Y[i] + H[i] > maxy) maxy = Y[i] + H[i]
    }
    # A character cell is about twice as tall as it is wide.
    sx = (cols - 1) / (maxx - minx); sy = sx / 2
    CW = cols; CH = int((maxy - miny) * sy) + 1
    for (y = 0; y < CH; y++) for (x = 0; x < CW; x++) G[y, x] = " "
    for (i = 1; i <= n; i++) {
      x0[i] = int((X[i] - minx) * sx)
      x1[i] = int((X[i] + W[i] - minx) * sx)
      y0[i] = int((Y[i] - miny) * sy)
      y1[i] = int((Y[i] + H[i] - miny) * sy)
      if (x1[i] >= CW) x1[i] = CW - 1; if (y1[i] >= CH) y1[i] = CH - 1
      for (x = x0[i]; x <= x1[i]; x++) {
        put(x, y0[i], "-"); put(x, y1[i], "-")
      }
      for (y = y0[i]; y <= y1[i]; y++) {
        put(x0[i], y, "|"); put(x1[i], y, "|")
      }
    }
    # Corners after every edge, so the edge of a neighbour cannot erase one.
    for (i = 1; i <= n; i++) {
      put(x0[i], y0[i], "+"); put(x1[i], y0[i], "+")
      put(x0[i], y1[i], "+"); put(x1[i], y1[i], "+")
    }
    # Region dividers, then labels, so a label is never cut by a divider.
    for (j = 1; j <= m; j++) {
      i = IX[SC[j]]; if (!i) continue
      if (SH[j] < H[i]) cut(i, "top-bottom")
      if (SW[j] < W[i]) cut(i, "left-right")
    }
    for (j = 1; j <= q; j++) if (IX[KC[j]]) cut(IX[KC[j]], KW[j])
    for (i = 1; i <= n; i++) {
      w = x1[i] - x0[i] - 2
      text(x0[i] + 2, y0[i] + 1, C[i] " " K[i], w)
      text(x0[i] + 2, y0[i] + 2, W[i] "x" H[i], w)
    }
    for (j = 1; j <= m; j++) {
      i = IX[SC[j]]; if (!i) continue
      lx = x0[i] + 2; ly = y0[i] + 3; rw = x1[i] - x0[i] - 2
      if (SW[j] < W[i]) {
        rw = int((x1[i] - x0[i]) / 2) - 2
        if (SX[j] > 0) lx = int((x0[i] + x1[i]) / 2) + 2
      }
      if (SH[j] < H[i] && SY[j] > 0) ly = int((y0[i] + y1[i]) / 2) + 1
      while (ly < y1[i] && G[ly, lx] != " ") ly++
      if (ly < y1[i]) text(lx, ly, SN[j] " " SWX[j] "," SWY[j], rw)
    }
    for (y = 0; y < CH; y++) {
      line = ""
      for (x = 0; x < CW; x++) line = line G[y, x]
      sub(/ +$/, "", line); print line
    }
    print ""
    for (i = 1; i <= n; i++)
      printf "%-6s %s  %dx%d at %d,%d  %s\n", C[i], K[i], W[i], H[i], \
        X[i], Y[i], NM[i]
    for (j = 1; j <= m; j++)
      printf "  surface %-10s %s cell %d,%d  %dx%d at %d,%d\n", SN[j], \
        SC[j], SWX[j], SWY[j], SW[j], SH[j], SX[j], SY[j]
    for (j = 1; j <= q; j++) {
      split(KW[j] == "top-bottom" ? "top bottom" : "left right", hn, " ")
      e = ""
      for (h = 1; h <= 2; h++)
        if (!((KC[j], KX[j], KY[j], h) in HALF)) e = e (e ? " and " : "") hn[h]
      printf "  split   %-10s %s cell %d,%d%s\n", KW[j], KC[j], KX[j], \
        KY[j], e ? "  " e " empty" : ""
    }
  }'

if [ "$_srf_rc" = 0 ] && [ -n "$_map$_spl" ]; then
  echo
  {
    printf '%s\n' "$_outs"
    [ -n "$_map" ] && printf '%s\n' "$_map" | awk -v OFS="$TAB" \
      '{ print "srf", $1, $2, $3, $4, $10, $11, $12, $13 }'
    [ -n "$_spl" ] && printf '%s\n' "$_spl" | awk -v OFS="$TAB" \
      '{ print "spl", $1, $2, $3, $4 }'
    # shellcheck disable=SC2086  # `W H`, split into its two fields
    [ -n "$_grid" ] && printf 'grd\t%s\t%s\n' $_grid
    :
  } | grid_map
fi

printf '\nshape  %s\n' "${_shape:-(none)}"
# shellcheck disable=SC2016  # the backticks below are literal, for the reader
case $_srf_rc in
  0) [ -n "$_srf" ] || printf 'surfaces  none for this desk\n' ;;
  2) printf 'surfaces  BROKEN, not drawn: run `hwdp surfaces --check`\n' ;;
  *) printf 'surfaces  unavailable (hwdp surfaces exit %s)\n' "$_srf_rc" ;;
esac
if [ -n "$_faults" ]; then
  printf '%s\n' "$_faults" | sed 's/^/PROBLEM  /'
fi
