#!/bin/sh
# hwdp desks: every desk this box knows, by NAME.
#
#   hwdp desks                      list them; `*` marks the one attached now
#   hwdp desks --name <desk> <new>  give a desk a name (`-` goes back to the
#                                   one made from its hardware)
#   hwdp desks --resolve <desk>     print the KEY a name (or key) is filed by
#
# A desk is filed by a KEY (its desk id, its plain id, or a shape for a
# generic desk such as BL), which no one should have to type. Each also has a
# NAME: chosen here, or made from the hardware (u2715h+p2721q, aw2725q-x3,
# laptop). Names are lowercase `a-z 0-9 + - _` (a chosen one at most 24
# characters, so the list fits an 80-column terminal) and unique, which is
# what lets `hwdp arrange <name>` take one without being mistaken for a
# connector. See lib/desks_lib for how a name is made.
set -eu
. "$HWDP_LIB/displayset_lib"
. "$HWDP_LIB/desks_lib"

case "${1:-}" in
  '') ;;
  --resolve)
    [ $# -eq 2 ] || { echo "usage: hwdp desks --resolve <desk>" >&2; exit 2; }
    desk_resolve "$2" && exit 0
    echo "hwdp desks: no desk named \`$2\` (hwdp desks lists them)" >&2
    exit 1 ;;
  --name)
    [ $# -eq 3 ] || { echo "usage: hwdp desks --name <desk> <new>" >&2
                      exit 2; }
    _k=$(desk_resolve "$2") || { echo "hwdp desks: no desk named \`$2\`" >&2
                                 exit 1; }
    if [ "$3" != - ]; then
      { printf '%s\n' "$3" | grep -Eq "$DESK_NAME_RE" \
          && [ ${#3} -le 24 ]; } || {
        echo "hwdp desks: \`$3\` is not a name: up to 24 of lowercase" \
          "a-z 0-9 + - _, starting with a letter or digit (so it can never" \
          "be read as a connector)" >&2
        exit 2; }
      _o=$(desk_table | awk -F"$TAB" -v k="$_k" -v n="$3" \
             '$1 != k && ($2 == n || $1 == n) { print $1 }')
      if [ -n "$_o" ]; then
        echo "hwdp desks: \`$3\` is already the desk $_o" >&2
        exit 2
      fi
    fi
    mkdir -p "$(dirname "$DESK_NAMES")"
    _t=$(mktemp "$DESK_NAMES.XXXXXX")
    { echo "# desk names: <key> <name>; written by hwdp desks --name"
      [ -f "$DESK_NAMES" ] && awk -v k="$_k" \
        '!/^[ \t]*(#|$)/ && $1 != k' "$DESK_NAMES"
      [ "$3" = - ] || printf '%s %s\n' "$_k" "$3"
    } > "$_t"
    chmod 644 "$_t"
    mv "$_t" "$DESK_NAMES"
    desk_table | awk -F"$TAB" -v k="$_k" '$1 == k {
      print "hwdp desks: " $1 " is now `" $2 "`" }'
    exit 0 ;;
  -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
  *) echo "hwdp desks: unexpected argument '$1'" >&2; exit 2 ;;
esac

_here=$(desk_here)
desk_table | while IFS="$TAB" read -r _k _n; do
  _kind=$(desk_kind "$_k")
  _p=$(desk_panels "$_k" | awk -F"$TAB" '
    { m = split($1, w, " "); t = ($1 == "@builtin") ? "laptop" : \
        ((m >= 2) ? w[m - 1] : w[1])
      t = t ($6 == 0 ? " (off)" : "")
      if (t == last) { k++; next }
      flush(); last = t; k = 1 }
    # a run of the same monitor is one entry: AW2725Q x3
    function flush() { if (k) s = s (s ? ", " : "") last (k > 1 ? " x" k : "") }
    END { flush(); print s }')
  case $_k in
    *[!A-Z+]*) ;;
    *) _p="any ${_k} desk" ;;
  esac
  _g=-; _s=-
  if [ -f "$DESKS/$_k.conf" ]; then
    _g=$(awk '$1 == "grid" { print $2 "x" $3; exit }' "$DESKS/$_k.conf")
    _s=$(awk '$1 == "surface" { n++ } $1 == "default" { d = 1 }
           END { print (n + 0) (d ? "+default" : "") }' "$DESKS/$_k.conf")
    [ -n "$_g" ] || _g=-
  fi
  _m=" "
  printf '%s\n' "$_here" | grep -qxF "$_k" && _m="*"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$_m" "$_n" "$_k" "${_kind:--}" \
    "$_g" "$_s" "${_p:--}"
done | awk -F"$TAB" -v W=79 '
  # W is 79, NOT 80: a line that fills the last column of an 80-column
  # terminal wraps its final character on some (the user saw exactly that,
  # with the made names). The tool never writes that column either.
  # Columns as wide as their widest entry; PANELS takes what is left of W
  # and wraps inside its own column between words, so a long desk never
  # folds into the next row. Too narrow for that (under 16), it goes on
  # its own lines below the row instead.
  function pad(s, n) { return sprintf("%-" n "s", s) }
  BEGIN { split("NAME KEY KIND GRID SURFACES PANELS", H, " ") }
  { R[++n] = $0
    for (i = 2; i <= 6; i++) if (length($i) > C[i]) C[i] = length($i) }
  # NAME is at most 24 wide; a longer one (made from many monitors) takes
  # a line of its own, the rest of its row below it in the columns.
  END {
    if (!n) { print "  (no desks yet: hwdp arrange lays one out)"; exit }
    if (C[2] > 24) C[2] = 24
    at = 2
    for (i = 2; i <= 6; i++) {
      if (length(H[i - 1]) > C[i]) C[i] = length(H[i - 1])
      at += C[i] + 2
    }
    room = W - at; below = room < 16
    head = "  "
    for (i = 2; i <= 6; i++) head = head pad(H[i - 1], C[i]) "  "
    if (below) sub(/ +$/, "", head)
    print head (below ? "" : "PANELS")
    for (r = 1; r <= n; r++) {
      split(R[r], f, "\t")
      line = f[1] " "
      if (length(f[2]) > C[2]) { print line f[2]; line = "  "; f[2] = "" }
      for (i = 2; i <= 6; i++) line = line pad(f[i], C[i]) "  "
      if (below) { sub(/ +$/, "", line); print line; ind = "    "
                   room = W - 4 }
      else ind = sprintf("%" at "s", "")
      m = split(f[7], w, " "); cur = ""
      for (j = 1; j <= m; j++) {
        t = w[j]
        if (cur != "" && length(cur) + 1 + length(t) > room) {
          print (below ? ind : line) cur; line = ind; cur = t
        } else cur = (cur == "" ? t : cur " " t)
      }
      print (below ? ind : line) cur
    }
  }'
