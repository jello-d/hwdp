#!/bin/sh
# hwdp capture: snapshot the CURRENT arrangement into a profile named by the
# connected set's id, so a rig is onboarded by "arrange it once, then capture"
# instead of hand-editing a config. Writes $PROFILES/<id>.conf, prints its path.
#
# Transforms, positions and modes only; NO scale; `hwdp layout` fills that at
# session start from the sticky per-panel value, and baking one in here would
# freeze a number that is meant to track the hardware.
#
# WRITES ATOMICALLY, AND NEVER DESTROYS A PROFILE SILENTLY. This used to be a
# plain `> $dst`, which truncates BEFORE the block that fills it: a re-capture
# of a set whose profile had been hand-edited threw that work away with no
# warning, and a failure part-way through left a corrupt profile with no
# original to fall back on. The file carries comments inviting exactly that
# hand-editing, so overwriting it quietly was the wrong default.
#
#   unchanged  the file is left ALONE and the path printed (idempotent, so
#              re-capturing an unchanged rig is a genuine no-op)
#   changed    the previous file is kept as <id>.conf.bak in the state
#              dir ($XDG_STATE_HOME/hwdp/profiles), never beside it, and
#              the change is announced on stderr; stdout stays just the
#              path
#
# The temp file is made INSIDE $PROFILES so the rename is atomic: across
# filesystems `mv` degrades to copy-then-delete and stops being.
#
# A SWITCHED-OFF PANEL IS WRITTEN AS `disable`, NOT LEFT OUT. The profile is
# chosen by `hwdp id`, which counts every ATTACHED panel, and kanshi applies a
# profile only when it names EVERY connected output: measured in a nested
# wayfire, a profile naming one of two connected outputs gets "no profile
# matched" and nothing is applied, while the same profile plus `output <the
# other> disable` applies and switches it off. Leaving it out is exactly the
# docked laptop with its built-in panel off: a profile that silently never
# applies at the one desk it was captured for.
#
# AND IT REFUSES A LAYOUT WITH A GAP OR AN OVERLAP, writing nothing, because
# capture is where a gap made by hand would otherwise become permanent. The
# outputs must share edges exactly, or edge flipping reads a shared inner edge
# as two outer ones (see layout_faults). `hwdp layout` checks again once the
# scales are known.
set -eu
. "$HWDP_LIB/displayset_lib"

_id=$(hwdp_id)
[ -n "$_id" ] || { echo "hwdp capture: no outputs to capture" >&2; exit 1; }
# Written under the DESK id, the built-in as its role (see desk_id).
_desk=$(desk_id)

_faults=$(live_rects | layout_faults)
if [ -n "$_faults" ]; then
  printf '%s\n' "$_faults" | layout_fault_text | sed 's/^/hwdp capture: /' >&2
  echo "hwdp capture: NOT captured. Arrange the outputs edge to edge (e.g." \
       "wlr-randr --output <name> --pos X,Y) and capture again." >&2
  exit 1
fi

mkdir -p "$PROFILES"

# Clean up the temp on ANY exit, including the `set -e` aborts that the write
# below can trigger, and a stray .tmp beside the profiles is confusing litter.
_tmp=$(mktemp "$PROFILES/.$_desk.conf.XXXXXX")
trap 'rm -f "$_tmp"' EXIT HUP INT TERM
placed_records | desk_names \
  | profile_text "$_desk" "captured by hwdp capture" > "$_tmp"
profile_install "$_desk" "$_tmp" capture

# A profile is recorded: tell the integrator (see the `mapped` edge).
HWDP_ID=$_id; HWDP_PROFILE=$PROFILES/$_desk.conf; export HWDP_ID HWDP_PROFILE
# shellcheck disable=SC2034  # read by hooks_lib, sourced next
HWDP_HOOK_TAG='hwdp capture'
. "$HWDP_LIB/hooks_lib"
run_hooks mapped
