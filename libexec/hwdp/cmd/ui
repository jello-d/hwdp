#!/bin/sh
# hwdp ui -- the per-display UI sizing profile, as shell-sourceable KEY=VALUE.
#
# For apps whose font or size is a single GLOBAL config (kitty, the pixdecor
# titlebar, mako, the lock ring) and so cannot self-scale per output the way a
# bar can. ONE resolver, so every consumer gets the same answer; resolved
# specific-first:
#   1. an optional HWDP override file $PROFILES/<id>.ui (the same KEY=VALUE
#      lines) wins PER KEY -- hand-authored for a rig that wants exact sizes;
#   2. else a DENSITY default: a low-res SINGLE panel (< LODPI_MAX_W wide) is
#      `lodpi` (shrink); everything else -- a hi-res single or a >=3 wall -- is
#      `hidpi`, which MIRRORS the static configs, so a hi-res display is a
#      strict no-op.
#
# The keys:
#   KITTY_FONT    kitty font_size; EMPTY => leave kitty.conf's own (hidpi)
#   TITLE_FONT    pixdecor title_font (Pango); ALWAYS set, so switching a mode
#                 back to hi-res RESTORES the full titlebar (IPC state is live).
#   MAKO_FONT     mako font (Pango); EMPTY => leave mako/config's own (hidpi)
#   LOCK_RADIUS   swaylock --indicator-radius (px); EMPTY => swaylock's default
#   CURSOR_SIZE   the pointer cursor size (px); ALWAYS set (like TITLE_FONT), so
#                 a switch back to hi-res RESTORES it rather than leaving it
#                 shrunk (the consumer sets it live).
#   MAGNIFY       how much to enlarge a FIXED-LAYOUT app that cannot scale
#                 itself (run-scaled's default). A 640x480 program is unusable
#                 on a 2880x1800 panel and merely small on 1920x1080, so the
#                 factor is a property of the DISPLAY, not of the launcher --
#                 which is the whole reason it belongs here rather than being
#                 hardcoded by every caller. Bounded by what still FITS: 3x a
#                 640x480 app is 1920x1440, which fits a 1800-tall panel and
#                 does not fit a 1080-tall one.
# The hidpi TITLE_FONT and CURSOR_SIZE mirror wayfire.ini's [pixdecor]
# title_font and [input] cursor_size -- keep them in sync.
set -eu
. "$HWDP_LIBEXEC/displayset.sh"

UI_KITTY_LODPI=${UI_KITTY_LODPI:-10}
UI_TITLE_HIDPI=${UI_TITLE_HIDPI:-Lato Semibold 14}
UI_TITLE_LODPI=${UI_TITLE_LODPI:-Lato Semibold 10}
UI_MAKO_LODPI=${UI_MAKO_LODPI:-Inter 11}   # mako/config font is Inter 18
UI_LOCK_RADIUS_LODPI=${UI_LOCK_RADIUS_LODPI:-32}   # swaylock ring, default ~50
UI_CURSOR_HIDPI=${UI_CURSOR_HIDPI:-48}   # mirrors wayfire.ini cursor_size
UI_CURSOR_LODPI=${UI_CURSOR_LODPI:-32}   # shrink on a small panel
UI_MAGNIFY_HIDPI=${UI_MAGNIFY_HIDPI:-3}  # 640x480 -> 1920x1440, fits 1800 tall
UI_MAGNIFY_LODPI=${UI_MAGNIFY_LODPI:-2}  # 640x480 -> 1280x960, fits 1080 tall
LODPI_MAX_W=${LODPI_MAX_W:-2560}   # a single panel narrower than this = lodpi
# The midpoint between the two calibrations (lodpi ~92ppi, hidpi ~244ppi), used
# only when HWDP_TARGET_PPI is set: it decides which calibrated set the target
# is nearer to.
LODPI_MAX_PPI=${LODPI_MAX_PPI:-168}

# With NO display at all, say so and emit nothing. Every consumer reads these
# keys with its own default behind them, so silence leaves them correct -- where
# a confident wrong answer did not. This is the bug that started the split: the
# density test used to ask a LAYOUT probe a PANEL question, get nothing at a
# greeter, and fall through to hidpi, handing a 1920x1080 panel a 48px cursor.
_sh=$(shape)
if [ -z "$_sh" ]; then
  echo "hwdp ui: no displays; refusing to guess a UI size" >&2
  exit 3
fi

# WHICH DENSITY to size for. Two models, and this must agree with `hwdp
# layout`, which keys off the SAME variable -- they were inconsistent once and
# that is what produced 244ppi fonts on a 92ppi panel.
#
# HWDP_TARGET_PPI SET: layout has scaled every output so its LOGICAL density
# lands near the target, so the target IS the density to size for and no panel
# needs inspecting. This is the arrangement that makes MIXED densities work:
# one set of numbers is correct everywhere because every output now has the
# same logical density.
#
# The buckets are calibrated samples rather than a formula: lodpi is tuned for
# ~92ppi (a 1920 panel at 530mm) and hidpi for ~244ppi (manifold, 2880 at
# 300mm). So pick whichever calibration the target is nearer.
_mixed_warn=1
if [ -n "${HWDP_TARGET_PPI:-}" ]; then
  _mixed_warn=0
  if [ "${HWDP_TARGET_PPI:-0}" -lt "${LODPI_MAX_PPI:-168}" ] 2>/dev/null; then
    _rw=0                 # below the midpoint: the lodpi calibration
  else
    _rw=$LODPI_MAX_W      # at or above: the hidpi calibration
  fi
fi

# NO TARGET: every output is at scale 1, so physical density differences are
# real and unhandled. Say so.
#
# Every key below is ONE number for the whole session, because every consumer
# has one global config: kitty one font_size, pixdecor one title_font
# (compositor-wide), mako one font. So on panels of different physical density
# there is no right answer to emit -- not a gap in the code, a property of the
# consumers. Set HWDP_TARGET_PPI to actually fix it; short of that, warn, name
# the panels, and pick DELIBERATELY.
#
# Sizing for the DENSEST is the safer of two wrong answers: its numbers come
# out oversized on a coarser panel, which is clumsy but readable, where sizing
# for the coarsest is microscopic on a dense one. This used to be `head -1` --
# the same compromise, chosen by accident and in silence.
#
# Needs a session: the panels probe (DRM sysfs) carries no millimetre size, so
# headless there is nothing to compare and nothing to warn about.
if [ "$_mixed_warn" = 1 ]; then
  _dens=$(outputs 2>/dev/null | awk -F"$TAB" '
    $3 + 0 > 0 && $5 + 0 > 0 { printf "%d\t%d\t%s\n", $3 / ($5 / 25.4), $3, $1 }
  ' | sort -rn)
  if [ "$(printf '%s\n' "$_dens" | grep -c .)" -gt 1 ]; then
    _hi=$(printf '%s\n' "$_dens" | head -1 | cut -f1)
    _lo=$(printf '%s\n' "$_dens" | tail -1 | cut -f1)
    # 25% apart is the line: two of the same model vary a little through EDID
    # rounding, and a warning that cries wolf gets ignored when it matters.
    _far='BEGIN { exit !(l > 0 && h / l > 1.25) }'
    if awk -v h="$_hi" -v l="$_lo" "$_far"; then
      echo "hwdp ui: MIXED DPI -- these panels differ in physical density:" >&2
      printf '%s\n' "$_dens" | while IFS="$(printf '\t')" read -r _p _w _n; do
        echo "hwdp ui:   ${_n:-?} ${_w}px wide, ${_p} ppi" >&2
      done
      echo "hwdp ui: sizing for the densest; it will be oversized on the" \
        "rest. Set HWDP_TARGET_PPI to scale them to one logical density" \
        "instead." >&2
    fi
    _rw=$(printf '%s\n' "$_dens" | head -1 | cut -f2)
  fi
fi

# An unknown width (a connector the kernel listed no modes for) falls to hidpi,
# which mirrors the static configs and is the harmless answer when we cannot
# tell.
[ -n "${_rw:-}" ] || _rw=$(panel_width)
if [ "$_sh" = single ] && [ "${_rw:-99999}" -lt "$LODPI_MAX_W" ]; then
  _kitty=$UI_KITTY_LODPI; _title=$UI_TITLE_LODPI; _mako=$UI_MAKO_LODPI
  _lockr=$UI_LOCK_RADIUS_LODPI; _cursor=$UI_CURSOR_LODPI
  _magnify=$UI_MAGNIFY_LODPI
else
  _kitty=; _title=$UI_TITLE_HIDPI; _mako=; _lockr=; _cursor=$UI_CURSOR_HIDPI
  _magnify=$UI_MAGNIFY_HIDPI
fi

# The override wins per key. Read it LITERALLY (never shell-sourced), so a value
# with spaces (TITLE_FONT=Lato Semibold 12) needs no quoting and nothing in the
# file is ever executed.
_ovr=$PROFILES/$(hwdp_id).ui
if [ -f "$_ovr" ]; then
  _k=$(sed -n 's/^KITTY_FONT=//p' "$_ovr" | head -1)
  _t=$(sed -n 's/^TITLE_FONT=//p' "$_ovr" | head -1)
  _m=$(sed -n 's/^MAKO_FONT=//p' "$_ovr" | head -1)
  _lr=$(sed -n 's/^LOCK_RADIUS=//p' "$_ovr" | head -1)
  _cs=$(sed -n 's/^CURSOR_SIZE=//p' "$_ovr" | head -1)
  _mg=$(sed -n 's/^MAGNIFY=//p' "$_ovr" | head -1)
  [ -n "$_k" ]  && _kitty=$_k
  [ -n "$_t" ]  && _title=$_t
  [ -n "$_m" ]  && _mako=$_m
  [ -n "$_lr" ] && _lockr=$_lr
  [ -n "$_cs" ] && _cursor=$_cs
  [ -n "$_mg" ] && _magnify=$_mg
fi

printf 'KITTY_FONT=%s\n'  "$_kitty"
printf 'TITLE_FONT=%s\n'  "$_title"
printf 'MAKO_FONT=%s\n'   "$_mako"
printf 'LOCK_RADIUS=%s\n' "$_lockr"
printf 'CURSOR_SIZE=%s\n' "$_cursor"
printf 'MAGNIFY=%s\n'     "$_magnify"
