#!/bin/sh
# hwdp id -- the HWDP (hardware display profile id) for the CONNECTED set.
#
# A compound id over the connected connectors' EDIDs, so it names the MONITOR
# SET regardless of order or which connector each panel sits on. Empty, not the
# hash of nothing, with nothing connected.
#
# Resolves HEADLESS by design: this is the probe a provisioning run makes from a
# TTY to choose a greeter, and the one the greeter itself is rendered under,
# before any session exists.
set -eu
. "$HWDP_LIBEXEC/probe.sh"
hwdp_id
