#!/bin/sh
# hwdp geometry -- one line per ENABLED output, whitespace separated:
#
#   NAME MODE_W MODE_H TRANSFORM SCALE POS_X POS_Y LOG_W LOG_H ORIENTATION
#
# A STABLE CONTRACT: a consumer sorts by POS_X for left-to-right order and sizes
# itself from the LOGICAL w/h (the space it actually gets after scale and
# rotation). TRANSFORM values are wl_output_transform (COUNTER-CLOCKWISE), the
# kanshi/wlr-randr convention; a sway config `transform` is CLOCKWISE -- 180
# apart, so shift by 180 (90<->270) to reuse a value across the two.
#
#   default       settle: sample until the layout stops changing, then print
#   --now         print the first snapshot immediately (no settle)
#   --quiet-ms N  settle window in ms (default 200)
#   --timeout S   overall cap in seconds (default 30)
set -u
. "$HWDP_LIBEXEC/probe.sh"

NOW=0
QUIET_MS=200
TIMEOUT=30
while [ $# -gt 0 ]; do
  case $1 in
    --now)        NOW=1 ;;
    --quiet-ms)   QUIET_MS=$2; shift ;;
    --quiet-ms=*) QUIET_MS=${1#*=} ;;
    --timeout)    TIMEOUT=$2; shift ;;
    --timeout=*)  TIMEOUT=${1#*=} ;;
    -h|--help)    sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "hwdp geometry: unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

# Project the shared layout record onto the line contract. THIS is where the
# ENABLED filter lives: providers report every output they can see, and what
# counts as "an output worth a line" is each consumer's own policy -- ours is
# enabled, with a current mode. Logical size is the mode divided by scale, w/h
# swapped for a 90/270 (or flipped-90/270) transform.
_snapshot() {
  if ! _rec=$(probe_layout); then
    echo "hwdp geometry: no layout provider could answer (need wlr-randr on" \
         "Wayland or xrandr on X11; drop your own in" \
         "$HWDP_PROVIDER_ROOT/layout, or set HWDP_GEOM_BACKEND)" >&2
    return 3
  fi
  printf '%s\n' "$_rec" | awk -F'	' '
    $12 == 1 && $3 + 0 > 0 {
      tx = $8
      rot = (tx=="90"||tx=="270"||tx=="flipped-90"||tx=="flipped-270")
      cw = $3 + 0; ch = $4 + 0
      lw = rot ? ch : cw; lh = rot ? cw : ch
      s = ($9 + 0 > 0) ? $9 + 0 : 1
      lw = int(lw/s + 0.5); lh = int(lh/s + 0.5)
      orient = (lh > lw) ? "portrait" : "landscape"
      printf "%s %d %d %s %g %d %d %d %d %s\n",
        $2, cw, ch, tx, s, $10, $11, lw, lh, orient
    }
  '
}

# Generic settle: sample until two consecutive non-empty snapshots match (the
# layout held still for one quiet window), capped by --timeout. Approximates an
# event-driven provider's debounce without needing the protocol.
_settle() {
  _q=$(awk "BEGIN{print $QUIET_MS/1000}")
  _max=$(awk "BEGIN{print int($TIMEOUT/($QUIET_MS/1000)) + 1}")
  _prev=""
  _i=0
  while [ "$_i" -lt "$_max" ]; do
    _cur=$(_snapshot) || return $?
    if [ -n "$_cur" ] && [ "$_cur" = "$_prev" ]; then
      printf '%s\n' "$_cur"
      return 0
    fi
    _prev=$_cur
    sleep "$_q"
    _i=$((_i + 1))
  done
  if [ -n "$_prev" ]; then
    printf '%s\n' "$_prev"
    echo "hwdp geometry: settle timed out; last-known state" >&2
    return 0
  fi
  return 1
}

if [ "$NOW" -eq 1 ]; then
  out=$(_snapshot) || exit $?
else
  out=$(_settle) || exit $?
fi
[ -n "$out" ] || exit 1
printf '%s\n' "$out"
