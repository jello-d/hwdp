#!/usr/bin/env python3
"""hwdp arrange, interactively: lay out this desk by moving boxes around.

`hwdp arrange` with no placements, at a terminal, lands here. ONE layout on
screen, the live one, edited in place:

    Tab / arrows  select a monitor          r  rotate it a quarter turn
    s             swap (mark, then swap)    o  switch it off / back on
    m             move mode: arrows step it 25px, stopping flush and at
                  every alignment on the way; a step from flush jumps past
                  a neighbour, and off an edge's end turns the corner;
                  shift+arrow one pixel; m locks it, Esc undoes
    i             a label on every monitor, saying which one it is
    p             preview live, with a countdown that reverts unless kept
    Enter         save (and exit, or keep going)       q / Esc  quit

THIS FILE ONLY DRAWS AND DECIDES WHAT A KEY MEANS. The arithmetic is hwdp's:
sizes come from `hwdp geometry` (a quarter turn just swaps them), re-packing
after a rotate or a swap is the shell's layout_repack, and saving and
previewing go through `hwdp arrange`, whose edge check is the final word.
The one thing duplicated here is the touch/overlap test, because move mode
asks it of many candidate positions per keystroke; it only GUIDES a move.
"""
import curses
import os
import subprocess
import sys
import threading
import time

QUARTER = ("normal", "90", "180", "270")
ROTATED = ("90", "270", "flipped-90", "flipped-270")
PREVIEW_SECONDS = 15
STEP = 25           # a coarse move, in logical pixels, before any snap
NEAR = 200          # facing edges closer than this are worth a warning


def here():
    """The package's own dirs, from the dispatcher's environment or our own
    path (a checkout run directly)."""
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    return (os.environ.get("HWDP_LIBEXEC", os.path.join(root, "libexec")),
            os.environ.get("HWDP_LIB", os.path.join(root, "lib")))


# --- the model ---------------------------------------------------------------

class Output:
    def __init__(self, conn, transform, x, y, lw, lh):
        self.conn = conn
        self.transform = transform
        self.x, self.y = x, y
        self.on = True
        # The UNROTATED logical size: a quarter turn swaps it, exactly,
        # because the compositor's truncation applies to each axis alone.
        if transform in ROTATED:
            self.bw, self.bh = lh, lw
        else:
            self.bw, self.bh = lw, lh

    @property
    def w(self):
        return self.bh if self.transform in ROTATED else self.bw

    @property
    def h(self):
        return self.bw if self.transform in ROTATED else self.bh

    def rect(self):
        return (self.x, self.y, self.w, self.h)

    def token(self):
        kind = "B" if self.conn.startswith(("eDP", "LVDS", "DSI")) else "E"
        return kind + ("P" if self.h > self.w else "L")

    def degrees(self):
        t = self.transform.replace("flipped-", "")
        return "0" if t == "normal" else t


def span(a1, a2, b1, b2):
    """Overlap length of two ranges; 0 means they meet, below 0 apart."""
    return min(a2, b2) - max(a1, b1)


def overlaps(a, b):
    return (span(a[0], a[0] + a[2], b[0], b[0] + b[2]) > 0 and
            span(a[1], a[1] + a[3], b[1], b[1] + b[3]) > 0)


def touches(a, b):
    """Share an EDGE (not just a corner), the layout_faults rule."""
    ox = span(a[0], a[0] + a[2], b[0], b[0] + b[2])
    oy = span(a[1], a[1] + a[3], b[1], b[1] + b[3])
    return (ox == 0 and oy > 0) or (oy == 0 and ox > 0)


class Desk:
    def __init__(self, outputs, repack):
        self.outs = outputs
        self.repack = repack            # (old rects, new sizes) -> positions

    def on(self):
        return [o for o in self.outs if o.on]

    def normalise(self):
        on = self.on()
        if not on:
            return
        mx = min(o.x for o in on)
        my = min(o.y for o in on)
        for o in on:
            o.x -= mx
            o.y -= my

    def _relay(self, old):
        """Re-place every output at its CURRENT size, keeping the topology
        the OLD rects describe (layout_repack)."""
        new = {o.conn: (o.w, o.h) for o in self.on()}
        pos = self.repack(old, new)
        for o in self.on():
            if o.conn in pos:
                o.x, o.y = pos[o.conn]
        self.normalise()

    def rotate(self, o):
        old = {p.conn: p.rect() for p in self.on()}
        base = o.transform.replace("flipped-", "")
        i = QUARTER.index(base) if base in QUARTER else 0
        o.transform = QUARTER[(i + 1) % 4]
        self._relay(old)

    def swap(self, a, b):
        """Exchange the PLACES of two outputs, then re-pack at their own
        sizes, so a portrait and a landscape can trade sides."""
        old = {p.conn: p.rect() for p in self.on()}
        old[a.conn], old[b.conn] = old[b.conn], old[a.conn]
        self._relay(old)

    def faults(self):
        """True when the outputs that are on do not form one edge-joined,
        non-overlapping surface. A guide; `hwdp arrange` decides."""
        on = [o.rect() for o in self.on()]
        for i in range(len(on)):
            for j in range(i + 1, len(on)):
                if overlaps(on[i], on[j]):
                    return True
        seen, todo = {0}, [0]
        while todo:
            i = todo.pop()
            for j in range(len(on)):
                if j not in seen and touches(on[i], on[j]):
                    seen.add(j)
                    todo.append(j)
        return len(seen) != len(on)

    def placements(self):
        lines = []
        for o in self.outs:
            if o.on:
                lines.append("%s rotate %s at %d,%d"
                             % (o.conn, o.degrees(), o.x, o.y))
            else:
                lines.append("%s off" % o.conn)
        return lines


# --- move mode ---------------------------------------------------------------

def valid_spots(mover, others):
    """Every position along every other output's edges where the mover
    touches it, as (along-axis range) generators: (side, fixed, lo, hi)."""
    w, h = mover.w, mover.h
    for n in others:
        nx, ny, nw, nh = n.rect()
        yield ("x", nx + nw, ny - h + 1, ny + nh - 1)     # right of n
        yield ("x", nx - w, ny - h + 1, ny + nh - 1)      # left of n
        yield ("y", ny + nh, nx - w + 1, nx + nw - 1)     # below n
        yield ("y", ny - h, nx - w + 1, nx + nw - 1)      # above n


def nearest_valid(mover, others, cx, cy):
    """The touching, non-overlapping position nearest (cx, cy)."""
    best = None
    for axis, fixed, lo, hi in valid_spots(mover, others):
        if axis == "x":
            x, y = fixed, min(max(cy, lo), hi)
        else:
            x, y = min(max(cx, lo), hi), fixed
        r = (x, y, mover.w, mover.h)
        if any(overlaps(r, n.rect()) for n in others):
            continue
        d = (x - cx) ** 2 + (y - cy) ** 2
        if best is None or d < best[0]:
            best = (d, x, y)
    return None if best is None else best[1:]


def axis(o, ax):
    """An output's (start, length) along one axis."""
    return (o.x, o.w) if ax == "x" else (o.y, o.h)


def snaps(mover, others, ax):
    """The positions along AX where the mover lines up with another output:
    flush against either of its edges, or aligned with its start, end or
    centre. A coarse step stops at the first of these it would pass."""
    size = axis(mover, ax)[1]
    found = set()
    for n in others:
        a, ln = axis(n, ax)
        found.update((a - size, a + ln, a, a + ln - size,
                      a + (ln - size) // 2))
    return found


def at(mover, ax, v):
    """The mover's rect with its AX position replaced by V."""
    return (v, mover.y, mover.w, mover.h) if ax == "x" else \
        (mover.x, v, mover.w, mover.h)


def turn_corner(mover, others, ax, d):
    """Sliding along a neighbour's edge and off its end: the place on that
    neighbour's next side, aligned with the corner just passed (moving down
    the right side of n lands below n, right edges aligned). None when no
    neighbour it was sliding along has such a place free."""
    pa = "y" if ax == "x" else "x"         # the axis it is beside n on
    for n in others:
        if not touches(mover.rect(), n.rect()):
            continue
        ms, ml = axis(mover, pa)
        ns, nl = axis(n, pa)
        if ms == ns + nl:                  # mover after n on that axis
            p = ns + nl - ml
        elif ms + ml == ns:                # mover before n
            p = ns
        else:
            continue                       # touching along AX, not beside
        a, ln = axis(n, ax)
        v = a + ln if d > 0 else a - axis(mover, ax)[1]
        r = (v, p, mover.w, mover.h) if ax == "x" else \
            (p, v, mover.w, mover.h)
        if touches(r, n.rect()) and \
                not any(overlaps(r, o.rect()) for o in others):
            return r[0], r[1]
    return None


def step(desk, mover, dx, dy, snap=True):
    """Move one step along one axis. A coarse step (SNAP) stops early at the
    first alignment it would pass, so a monitor goes FLUSH before anything
    else. A step into a neighbour stops flush against it; only one taken
    from flush jumps to that neighbour's far side (how a monitor gets past
    another). Sliding off the end of a neighbour's edge turns the corner
    onto its next side. A step that would touch nothing goes nowhere."""
    others = [o for o in desk.on() if o is not mover]
    if not others:
        return
    ax = "x" if dx else "y"
    d = dx or dy
    cur = axis(mover, ax)[0]
    v = cur + d
    if snap:
        sign = 1 if d > 0 else -1
        ahead = [s for s in snaps(mover, others, ax)
                 if 0 < (s - cur) * sign <= abs(d)]
        if ahead:
            v = min(ahead, key=lambda s: abs(s - cur))
    hit = [n for n in others if overlaps(at(mover, ax, v), n.rect())]
    if hit:
        # The nearest thing in the way: flush against it, or past it when
        # already flush (the first step into it moved nothing yet).
        flush = [(a - axis(mover, ax)[1]) if d > 0 else (a + ln)
                 for a, ln in (axis(n, ax) for n in hit)]
        stop = min(flush, key=lambda s: abs(s - cur))
        if stop != cur:
            v = stop
        else:
            n = hit[flush.index(stop)]
            a, ln = axis(n, ax)
            v = a + ln if d > 0 else a - axis(mover, ax)[1]
    r = at(mover, ax, v)
    spot = (r[0], r[1])
    if any(overlaps(r, n.rect()) for n in others):
        spot = nearest_valid(mover, others, r[0], r[1])
    elif not any(touches(r, n.rect()) for n in others):
        # Adrift already (something it touched moved away): the nearest
        # place it touches anything, so one key brings it back flush.
        adrift = not any(touches(mover.rect(), n.rect()) for n in others)
        spot = nearest_valid(mover, others, r[0], r[1]) if adrift else \
            turn_corner(mover, others, ax, d)
    if spot is None:
        return
    mover.x, mover.y = spot
    desk.normalise()


def near_misses(desk, reach):
    """Facing edges of two outputs that are on, apart by less than REACH and
    overlapping along the edge: valid (each touches something) but a strip
    the pointer cannot cross, which reads as a broken edge. A guide."""
    on = desk.on()
    found = []
    for i, a in enumerate(on):
        for b in on[i + 1:]:
            for ax, pa in (("x", "y"), ("y", "x")):
                (s1, l1), (s2, l2) = axis(a, ax), axis(b, ax)
                g = max(s2 - (s1 + l1), s1 - (s2 + l2))
                (p1, q1), (p2, q2) = axis(a, pa), axis(b, pa)
                if 0 < g < reach and span(p1, p1 + q1, p2, p2 + q2) > 0:
                    found.append((a.conn, b.conn, g))
    return found


# --- talking to hwdp ---------------------------------------------------------

class Hwdp:
    """Every call out of this tool, in one place, so a test replaces it."""

    def __init__(self):
        self.libexec, self.lib = here()
        self.overlay = None

    def _run(self, *argv, stdin=None):
        # The package's dirs go to every child explicitly: displayset_lib
        # refuses to load without HWDP_LIB, and only the dispatcher exports
        # it, so a tool started any other way could not re-pack at all.
        env = dict(os.environ, HWDP_LIB=self.lib, HWDP_LIBEXEC=self.libexec)
        p = subprocess.run(argv, input=stdin, capture_output=True,
                           text=True, env=env)
        return p.returncode, p.stdout, p.stderr

    def geometry(self):
        rc, out, err = self._run(os.path.join(self.libexec, "cmd",
                                              "geometry"), "--now")
        if rc != 0 or not out.strip():
            raise SystemExit("hwdp arrange: no outputs to arrange (it needs"
                             " a session)\n" + err)
        outs = []
        for line in out.splitlines():
            f = line.split()
            outs.append(Output(f[0], f[3], int(f[5]), int(f[6]),
                               int(f[7]), int(f[8])))
        return outs

    def repack(self, old, new):
        lines = ["old\t%s\t%d\t%d\t%d\t%d" % ((n,) + r)
                 for n, r in old.items()]
        lines += ["new\t%s\t%d\t%d" % ((n,) + s) for n, s in new.items()]
        rc, out, err = self._run(
            "sh", "-c", '. "$1/displayset_lib"; layout_repack', "_",
            self.lib, stdin="\n".join(lines) + "\n")
        # LOUD: an empty answer here once meant "nothing moves", which left
        # a rotated monitor overlapping its neighbour with no word said.
        if rc != 0 or not out.strip():
            raise RuntimeError("hwdp arrange: layout_repack failed (%d): %s"
                               % (rc, err.strip()))
        pos = {}
        for line in out.splitlines():
            n, x, y = line.split("\t")
            pos[n] = (int(x), int(y))
        return pos

    def arrange(self, mode, placements, progress=None):
        """PROGRESS, when given, is called with each line arrange says as
        it says it, so a save that waits on a slow hook is not silent."""
        argv = [os.path.join(self.libexec, "cmd", "arrange")]
        if mode:
            argv.append(mode)
        env = dict(os.environ, HWDP_LIB=self.lib, HWDP_LIBEXEC=self.libexec)
        p = subprocess.Popen(argv + list(placements), stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE, text=True, env=env)
        said = [""]

        def read():
            for line in p.stderr:
                line = line.strip()
                if line:
                    said[0] = line
                    if progress:
                        progress(line)
        # Done when ARRANGE exits, not when its stderr closes: a hook that
        # leaves something running holding that pipe must not hold us.
        reader = threading.Thread(target=read, daemon=True)
        reader.start()
        rc = p.wait()
        reader.join(0.5)
        return rc, said[0]

    def surfaces(self, desk):
        """This desk's surfaces as the tool edits them, or (None, why) when
        the file cannot be read safely. Read through `hwdp surfaces`, the
        published answer, never by parsing the file."""
        rc, out, err = self._run(os.path.join(self.libexec, "cmd",
                                              "surfaces"))
        if rc != 0:
            return None, (err.strip().splitlines() or ["exit %d" % rc])[-1]
        size = {o.conn: (o.w, o.h) for o in desk.outs}
        found = []
        for line in out.splitlines():
            f = line.split()
            name, conn, cx, cy, x, y, w, h = f[0], f[1], *map(int, f[2:])
            W, H = size.get(conn, (w, h))
            region = ("full" if (w, h) == (W, H) else
                      ("top" if y == 0 else "bottom") if h < H else
                      ("left" if x == 0 else "right"))
            found.append(Surface(name, conn, region, cx, cy))
        return found, ""

    def write_surfaces(self, surfaces):
        lines = "".join("surface %s %s cell %d %d %s\n"
                        % (s.name, s.conn, s.cx, s.cy, s.region)
                        for s in surfaces)
        rc, out, err = self._run(os.path.join(self.libexec, "cmd",
                                              "surfaces"), "--write",
                                 stdin=lines)
        return rc, (err.strip().splitlines() or [""])[-1]

    def identify(self, on):
        if on and self.overlay is None:
            self.overlay = subprocess.Popen(
                [os.path.join(self.libexec, "cmd", "identify"),
                 "--parent", str(os.getpid())],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        elif not on and self.overlay is not None:
            self.overlay.terminate()
            try:
                self.overlay.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.overlay.kill()
            self.overlay = None
        return self.overlay is not None


# --- surfaces: named parts of a monitor --------------------------------------

REGIONS = ("full", "top", "bottom", "left", "right")


class Surface:
    def __init__(self, name, conn, region, cx, cy):
        self.name, self.conn, self.region = name, conn, region
        self.cx, self.cy = cx, cy

    def key(self):
        return (self.name, self.conn, self.region, self.cx, self.cy)


def clashes(a, b):
    """The same part of one monitor in one cell; opposite halves do not.
    The writer decides; this only answers the form at once."""
    if (a.conn, a.cx, a.cy) != (b.conn, b.cx, b.cy):
        return False
    pair = {a.region, b.region}
    return not (pair == {"top", "bottom"} or pair == {"left", "right"})


def region_rect(region, w, h):
    """Where a region sits inside a w x h output (halves, as hwdp does)."""
    return {"full": (0, 0, w, h), "top": (0, 0, w, h // 2),
            "bottom": (0, h // 2, w, h - h // 2),
            "left": (0, 0, w // 2, h),
            "right": (w // 2, 0, w - w // 2, h)}[region]


# --- the controller: what a key means ---------------------------------------

ARROWS = {curses.KEY_LEFT: (-1, 0), curses.KEY_RIGHT: (1, 0),
          curses.KEY_UP: (0, -1), curses.KEY_DOWN: (0, 1),
          ord("h"): (-1, 0), ord("l"): (1, 0),
          ord("k"): (0, -1), ord("j"): (0, 1)}
FINE = {curses.KEY_SLEFT: (-1, 0), curses.KEY_SRIGHT: (1, 0),
        curses.KEY_SR: (0, -1), curses.KEY_SF: (0, 1),
        ord("H"): (-1, 0), ord("L"): (1, 0),
        ord("K"): (0, -1), ord("J"): (0, 1)}
ESC = 27
ENTER = (10, 13, curses.KEY_ENTER)


class App:
    def __init__(self, desk, hw):
        self.desk, self.hw = desk, hw
        self.sel = 0
        self.mark = None          # the output marked for a swap
        self.moving = None        # (output, x, y) it started the move at
        self.saved = desk.placements()
        self.live_unsaved = False  # a preview was KEPT but not saved
        self.dialog = None        # ("save"|"quit"|"keep", deadline)
        self.msg = ""
        self.ident = False
        self.done = False
        self.form = None          # the naming form, while it is up
        self.busy = None          # [what, since, latest line] while saving
        self.job = None           # the save running beside the screen
        surf, why = hw.surfaces(desk)
        # A file `hwdp surfaces` refuses is NOT edited on top of: rewriting
        # it from what the tool could read would drop what it could not.
        self.names_blocked = why if surf is None else ""
        self.surfaces = surf or []
        self.saved_surfaces = self._surface_keys()

    @property
    def cur(self):
        return self.desk.outs[self.sel]

    def _surface_keys(self):
        return sorted(x.key() for x in self.surfaces)

    def dirty(self):
        return (self.desk.placements() != self.saved or self.live_unsaved
                or self._surface_keys() != self.saved_surfaces)

    def on_cur(self):
        return [x for x in self.surfaces if x.conn == self.cur.conn]

    # Dialogs first: while one is up, it owns the keyboard.
    def key(self, k, now):
        if self.busy:
            return                # a save owns the screen until it lands
        if self.dialog:
            return self._dialog_key(k, now)
        if self.moving and (k in ARROWS or k in FINE):
            return self._move(k)
        if k in ARROWS or k in (9, curses.KEY_BTAB):
            return self._select(k)
        action = {ord("r"): self._rotate, ord("s"): self._swap,
                  ord("m"): self._move_mode, ord("o"): self._toggle_on,
                  ord("i"): self._identify, ord("p"): self._preview,
                  ord("q"): self._quit, ord("n"): self._name,
                  ord("d"): self._delete}.get(k)
        if action:
            return action(now)
        if k in ENTER:
            self.dialog = ("save", None)
        elif k == ESC:
            return self._escape(now)

    def tick(self, now):
        self._landed()
        if self.dialog and self.dialog[0] == "keep" and now >= self.dialog[1]:
            self._revert("no answer: reverted")

    def _select(self, k):
        n = len(self.desk.outs)
        if k == 9:
            self.sel = (self.sel + 1) % n
            return
        if k == curses.KEY_BTAB:
            self.sel = (self.sel - 1) % n
            return
        dx, dy = ARROWS[k]
        c = self.cur
        cx, cy = c.x + c.w / 2, c.y + c.h / 2
        best = None
        for i, o in enumerate(self.desk.outs):
            if o is c or not o.on:
                continue
            ox, oy = o.x + o.w / 2 - cx, o.y + o.h / 2 - cy
            ahead = ox * dx + oy * dy
            if ahead <= 0:
                continue
            d = ahead + 2 * abs(ox * dy + oy * dx)
            if best is None or d < best[0]:
                best = (d, i)
        if best:
            self.sel = best[1]

    def _rotate(self, now):
        if self.cur.on:
            self.desk.rotate(self.cur)
            self.msg = "%s rotated" % self.cur.conn

    def _swap(self, now):
        c = self.cur
        if not c.on:
            self.msg = "%s is off" % c.conn
        elif self.mark is None or self.mark is c:
            self.mark = None if self.mark is c else c
            self.msg = ("%s marked: select another and press s"
                        % c.conn) if self.mark else ""
        else:
            self.desk.swap(self.mark, c)
            self.msg = "swapped %s and %s" % (self.mark.conn, c.conn)
            self.mark = None

    def _move_mode(self, now):
        c = self.cur
        if self.moving:
            self.moving = None
            self.msg = "%s locked at %d,%d" % (c.conn, c.x, c.y)
        elif c.on:
            self.moving = (c, c.x, c.y)
            self.msg = ("moving %s: arrows step, shift+arrow one pixel,"
                        " m locks, Esc undoes" % c.conn)

    def _move(self, k):
        o = self.moving[0]
        if k in FINE:
            dx, dy = FINE[k]
        else:
            dx, dy = ARROWS[k]
            dx, dy = dx * STEP, dy * STEP
        step(self.desk, o, dx, dy, snap=k not in FINE)

    def _toggle_on(self, now):
        c = self.cur
        if c.on and len(self.desk.on()) == 1:
            self.msg = "the last monitor on cannot be switched off"
            return
        c.on = not c.on
        if c.on:
            spot = nearest_valid(c, [o for o in self.desk.on()
                                     if o is not c], c.x, c.y)
            if spot:
                c.x, c.y = spot
        self.desk.normalise()
        self.msg = "%s switched %s" % (c.conn, "on" if c.on else "off")

    def _identify(self, now):
        self.ident = self.hw.identify(not self.ident)
        if not self.ident:
            self.msg = "labels off"

    def _preview(self, now):
        if self.desk.faults():
            self.msg = "the monitors must meet edge to edge first"
            return
        rc, why = self.hw.arrange("--preview", self.desk.placements())
        if rc == 0:
            self.dialog = ("keep", now + PREVIEW_SECONDS)
        else:
            self.msg = why or "preview failed (%d)" % rc

    def _revert(self, why):
        self.hw.arrange("--revert", [])
        self.live_unsaved = False
        self.dialog = None
        self.msg = why

    def _save(self, now, then_exit):
        """The layout, then the surfaces; done only if both landed. It runs
        BESIDE the screen, which says what it is waiting on: a save fires
        the integrator's hooks, and those can take seconds."""
        self.dialog = None
        place = self.desk.placements()
        layout = place != self.saved or self.live_unsaved
        names = self._surface_keys()
        surfaces = list(self.surfaces) if names != self.saved_surfaces \
            else None
        self.busy = ["saving the layout" if layout else "saving surfaces",
                     now, ""]

        def said(line):
            self.busy[2] = line

        def work():
            if layout:
                rc, why = self.hw.arrange(None, place, progress=said)
                if rc != 0:
                    return why or "not saved (%d)" % rc, None
            if surfaces is not None:
                self.busy[0] = "saving surfaces"
                rc, why = self.hw.write_surfaces(surfaces)
                if rc != 0:
                    return "surfaces not saved: " + \
                        (why or "exit %d" % rc), layout
            return "", None

        def finish(res):
            why, half = res
            if not why or half:
                self.saved, self.live_unsaved = place, False
            if not why:
                self.saved_surfaces = names
                self.msg, self.done = "saved", then_exit
            else:
                self.msg = why
        self.job = self.spawn(work, finish)
        self._landed()

    @staticmethod
    def spawn(work, finish):
        """Run WORK on a thread; the screen calls FINISH with its answer
        once it lands (see _landed). A test swaps in a synchronous one."""
        job = {"finish": finish}

        def run():
            try:
                job["res"] = work()
            except Exception as e:      # said on screen, never swallowed
                job["res"] = ("save failed: %s" % e, None)
        job["thread"] = threading.Thread(target=run, daemon=True)
        job["thread"].start()
        return job

    def _landed(self):
        if self.job and "res" in self.job:
            job, self.job, self.busy = self.job, None, None
            job["finish"](job["res"])

    # --- naming ---------------------------------------------------------
    def _name(self, now):
        if self.names_blocked:
            self.msg = ("surfaces cannot be edited: " + self.names_blocked +
                        " (see hwdp surfaces --check)")
        elif not self.cur.on:
            self.msg = "%s is off" % self.cur.conn
        else:
            self.form = {"field": 0, "region": 0, "cx": 0, "cy": 0,
                         "name": "", "err": ""}
            self.dialog = ("name", None)

    def _form_key(self, k):
        f = self.form
        if k == ESC:
            self.form, self.dialog = None, None
        elif k in ENTER:
            self._form_add()
        elif k in (9, curses.KEY_DOWN):
            f["field"] = (f["field"] + 1) % 4
        elif k in (curses.KEY_BTAB, curses.KEY_UP):
            f["field"] = (f["field"] - 1) % 4
        elif k in (curses.KEY_LEFT, curses.KEY_RIGHT) and f["field"] < 3:
            d = 1 if k == curses.KEY_RIGHT else -1
            if f["field"] == 0:
                f["region"] = (f["region"] + d) % len(REGIONS)
            else:
                c = "cx" if f["field"] == 1 else "cy"
                f[c] = max(0, f[c] + d)
        elif f["field"] == 3 and k in (curses.KEY_BACKSPACE, 127, 8):
            f["name"] = f["name"][:-1]
        elif f["field"] == 3 and 0 < k < 256 and \
                (chr(k).isalnum() or chr(k) in "_-"):
            f["name"] += chr(k)

    def _form_add(self):
        f = self.form
        new = Surface(f["name"], self.cur.conn, REGIONS[f["region"]],
                      f["cx"], f["cy"])
        if not new.name:
            f["err"] = "give it a name"
        elif any(x.name == new.name for x in self.surfaces):
            f["err"] = "the name %s is taken" % new.name
        elif any(clashes(new, x) for x in self.surfaces):
            f["err"] = "that part of %s in that cell is taken" % new.conn
        else:
            self.surfaces.append(new)
            self.form, self.dialog = None, None
            self.msg = "surface %s: %s of %s, cell %d %d" % (
                new.name, new.region, new.conn, new.cx, new.cy)

    def _delete(self, now):
        if not self.on_cur():
            self.msg = "no surfaces on %s" % self.cur.conn
        else:
            self.dialog = ("delete", None)

    def _quit(self, now):
        if self.dirty():
            self.dialog = ("quit", None)
        else:
            self.done = True

    def _escape(self, now):
        if self.moving:
            o, x, y = self.moving
            o.x, o.y = x, y
            self.moving = None
            self.desk.normalise()
            self.msg = "move undone"
        elif self.mark:
            self.mark, self.msg = None, ""
        else:
            self._quit(now)

    def _dialog_key(self, k, now):
        kind = self.dialog[0]
        if kind == "name":
            return self._form_key(k)
        if kind == "delete":
            mine = self.on_cur()
            if k == ESC:
                self.dialog = None
            elif ord("1") <= k <= ord("9") and k - ord("1") < len(mine):
                gone = mine[k - ord("1")]
                self.surfaces.remove(gone)
                self.dialog = None
                self.msg = "surface %s removed" % gone.name
            return
        if kind == "save":
            if k == ord("s"):
                self._save(now, True)
            elif k == ord("c"):
                self._save(now, False)
            elif k in (ESC, ord("n")):
                self.dialog = None
        elif kind == "quit":
            if k in (ord("q"), ord("y")):
                if self.live_unsaved:
                    self.hw.arrange("--revert", [])
                self.done = True
            elif k == ord("s"):
                self._save(now, True)
            elif k in (ESC, ord("n")):
                self.dialog = None
        elif kind == "keep":
            if k in (ord("y"), ord("k")) or k in ENTER:
                self.live_unsaved = True
                self.dialog = None
                self.msg = "kept live; Enter saves it"
            elif k in (ESC, ord("n")):
                self._revert("reverted")


# --- the view: drawing only --------------------------------------------------

HELP = ("Tab/arrows select  r rotate  s swap  m move  o off/on  i identify"
        "  n name  d delete  p preview  Enter save  q quit")


def put(scr, y, x, text, attr=0):
    h, w = scr.getmaxyx()
    if 0 <= y < h and x < w:
        try:
            scr.addstr(y, max(0, x), text[:max(0, w - x - 1)], attr)
        except curses.error:
            pass


def draw_desk(scr, app, top, rows, cols):
    on = app.desk.on()
    if not on:
        return
    mx = min(o.x for o in on)
    my = min(o.y for o in on)
    bw = max(o.x + o.w for o in on) - mx
    bh = max(o.y + o.h for o in on) - my
    sc = min((cols - 2) / bw, (rows - 2) * 2 / bh)
    for o in on:
        x0 = int((o.x - mx) * sc) + 1
        y0 = int((o.y - my) * sc / 2) + top
        w = max(4, int(o.w * sc))
        h = max(3, int(o.h * sc / 2))
        attr = curses.color_pair(0)
        if app.moving and app.moving[0] is o:
            attr = curses.color_pair(3) | curses.A_BOLD
        elif app.mark is o:
            attr = curses.color_pair(2) | curses.A_BOLD
        elif app.cur is o:
            attr = curses.color_pair(1) | curses.A_BOLD
        put(scr, y0, x0, "+" + "-" * (w - 2) + "+", attr)
        for r in range(1, h - 1):
            put(scr, y0 + r, x0, "|" + " " * (w - 2) + "|", attr)
        put(scr, y0 + h - 1, x0, "+" + "-" * (w - 2) + "+", attr)
        for i, line in enumerate(("%s %s" % (o.conn, o.token()),
                                  "%dx%d" % (o.w, o.h),
                                  "at %d,%d" % (o.x, o.y))):
            if i + 1 < h - 1:
                put(scr, y0 + 1 + i, x0 + 2, line[:w - 4], attr)
        draw_surfaces(scr, app, o, x0, y0, w, h, attr)


def draw_surfaces(scr, app, o, x0, y0, w, h, attr):
    """Each surface in its half: dots split top/bottom, colons left/right
    (as `hwdp map` draws them), its name and cell in the corner."""
    used = {}
    for sf in (x for x in app.surfaces if x.conn == o.conn):
        rx, ry, rw, rh = region_rect(sf.region, w, h)
        if sf.region in ("top", "bottom"):
            put(scr, y0 + h // 2, x0 + 1, "." * (w - 2), attr)
        elif sf.region in ("left", "right"):
            for r in range(1, h - 1):
                put(scr, y0 + r, x0 + w // 2, ":", attr)
        row = y0 + ry + (4 if ry == 0 else 1)
        row += used.get((rx, ry), 0)
        used[(rx, ry)] = used.get((rx, ry), 0) + 1
        if row < y0 + h - 1:
            put(scr, row, x0 + rx + 2, ("%s %d,%d" % (sf.name, sf.cx, sf.cy))
                [:max(0, rw - 3)], attr | curses.A_UNDERLINE)


def form_lines(app):
    f = app.form
    mark = ["  "] * 4
    mark[f["field"]] = "> "
    return ["Name a surface on %s" % app.cur.conn, "",
            mark[0] + "part   < %s >" % REGIONS[f["region"]],
            mark[1] + "column < %d >" % f["cx"],
            mark[2] + "row    < %d >" % f["cy"],
            mark[3] + "name   " + f["name"] + "_", "",
            f["err"] or "Tab next  arrows change  Enter add  Esc cancel"]


def draw_dialog(scr, app, now):
    kind, deadline = app.dialog
    if kind == "name":
        text = form_lines(app)
    elif kind == "delete":
        text = (["Remove which surface on %s?" % app.cur.conn, ""] +
                ["%d  %s (%s, cell %d %d)" % (i + 1, x.name, x.region,
                                              x.cx, x.cy)
                 for i, x in enumerate(app.on_cur()[:9])] +
                ["", "Esc  keep them all"])
    else:
        text = {
        "save": ["Save this layout?", "",
                 "s  save and exit", "c  save and continue",
                 "Esc  cancel"],
        "quit": ["Changes have not been saved.", "",
                 "q  quit anyway", "s  save and exit", "Esc  go back"],
        "keep": ["Keep this setting?", "",
                 "y  keep it (Enter saves it later)", "n  revert now",
                 "reverting in %ds" % max(0, int(deadline - now + 0.99))
                 if deadline else ""],
    }[kind]
    box(scr, text)


def box(scr, text):
    h, w = scr.getmaxyx()
    bw = max(len(t) for t in text) + 6
    y0, x0 = max(0, (h - len(text) - 2) // 2), max(0, (w - bw) // 2)
    attr = curses.color_pair(4) | curses.A_BOLD
    put(scr, y0, x0, "+" + "-" * (bw - 2) + "+", attr)
    for i, t in enumerate(text):
        put(scr, y0 + 1 + i, x0, "|  " + t.ljust(bw - 5) + "|", attr)
    put(scr, y0 + len(text) + 1, x0, "+" + "-" * (bw - 2) + "+", attr)


def render(scr, app, now):
    scr.erase()
    h, w = scr.getmaxyx()
    state = "MOVE" if app.moving else ("swap: pick the other" if app.mark
                                      else "select")
    put(scr, 0, 1, "hwdp arrange  [%s]%s%s" % (
        state, "  labels on" if app.ident else "",
        "  (unsaved)" if app.dirty() else ""), curses.A_BOLD)
    draw_desk(scr, app, 2, h - 6, w - 1)
    off = [o.conn for o in app.desk.outs if not o.on]
    if off:
        put(scr, h - 4, 1, "off: " + "  ".join(off),
            curses.color_pair(1) if not app.cur.on else 0)
    gaps = near_misses(app.desk, NEAR)
    if app.desk.faults():
        put(scr, h - 3, 1, "the monitors do not meet edge to edge",
            curses.color_pair(4) | curses.A_BOLD)
    elif gaps:
        put(scr, h - 3, 1, "  ".join(
            "%dpx gap between %s and %s" % (g, a, b) for a, b, g in gaps) +
            " (the pointer cannot cross it)",
            curses.color_pair(4) | curses.A_BOLD)
    put(scr, h - 2, 1, app.msg)
    put(scr, h - 1, 1, HELP, curses.A_DIM)
    if app.busy:
        what, since, line = app.busy
        box(scr, ["%s ... %ds" % (what, int(now - since)), "",
                  line[:60] or "working", ""])
    elif app.dialog:
        draw_dialog(scr, app, now)
    scr.refresh()


def run(scr, app):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_YELLOW)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_MAGENTA)
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_GREEN)
    curses.init_pair(4, curses.COLOR_WHITE, curses.COLOR_RED)
    scr.keypad(True)
    scr.timeout(250)
    while not app.done:
        now = time.monotonic()
        render(scr, app, now)
        k = scr.getch()
        if k == -1:
            app.tick(time.monotonic())
        else:
            app.key(k, time.monotonic())


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print(__doc__.split("\n\n")[1])
        return 0
    if len(argv) > 1:
        print("hwdp arrange: the interactive tool takes no arguments",
              file=sys.stderr)
        return 2
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hwdp arrange: the interactive tool needs a terminal; give"
              " placements to script it", file=sys.stderr)
        return 2
    os.environ.setdefault("ESCDELAY", "25")
    hw = Hwdp()
    app = App(Desk(hw.geometry(), hw.repack), hw)

    def leave(*_):
        raise SystemExit(130)
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, leave)
    # The overlay goes whatever ends this: a quit, an exception, a signal.
    # (A SIGKILL cannot run this; the overlay watches our pid for that.)
    try:
        curses.wrapper(run, app)
    finally:
        hw.identify(False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
