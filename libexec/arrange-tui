#!/usr/bin/env python3
"""hwdp arrange, interactively: the desk tool.

`hwdp arrange` with no placements, at a terminal, lands here. Four tabs over
ONE desk, in the order you work; beside all but the second, a READ-ONLY
sidebar of every surface NAME and where it is (D the default, N placed N
times, - not placed at this desk):

  1 PHYSICAL, the layout: where the panels sit and how they turn
    Tab / arrows  select a monitor          r  rotate it a quarter turn
    w             swap (mark, then swap)    o  switch it off / back on
    m             move mode: arrows step it 25px, stopping flush and at
                  every alignment on the way; a step from flush jumps past
                  a neighbour, and off an edge's end turns the corner;
                  shift+arrow one pixel
    i             a label on every monitor, saying which one it is
    p             preview live, with a countdown that reverts unless kept
    Enter         finish what is in progress (lock a move, make a marked
                  swap); nothing otherwise
  2 SURFACES, the names: each with its label and where it is at this desk
    arrows        select a name             a  add one (a fixed name, a label)
    e             its label                 D  delete it (from every desk's
                                               list; asked first)
  3 VIRTUAL, the grid: a miniature of the desk in every workspace cell
    arrows        select a cell             Tab  a panel in it
    g             cycle the region (full, top, bottom, left, right)
    Enter         pick the name for that spot (typing filters the list; it
                  MOVES if placed elsewhere at this desk; what overlapped
                  goes)
    f / F         pick the DEFAULT for that spot / no default
    x             clear that spot
    + / -         a column more / fewer     ] / [  a row more / fewer
                  (fewer refuses while that column or row holds a surface)
  4 REVIEW, the map as it will be saved, and what is missing from it
  everywhere
    1 - 4         the tabs
    s             save, and keep editing
    Esc           back out of what is in progress (undo the move, drop
                  the mark); with nothing in progress, the quit prompt
    q             quit; with unsaved changes it asks: save and quit,
                  discard and quit, or keep editing (Esc at the top asks
                  the same, with keep editing as Enter's answer)

THE WORDS: a PANEL is a physical screen, the GRID the virtual workspaces, a
WORKSPACE one cell (under wsync, the whole desk at once), a REGION a part of
a panel, a SURFACE a named region of a panel in one workspace. Names are
GLOBAL (hwdp surfaces --names); their places are this desk's. A desk with no
grid of its own starts at 3x3.

THIS FILE ONLY DRAWS AND DECIDES WHAT A KEY MEANS. The arithmetic is hwdp's:
sizes come from `hwdp geometry` (a quarter turn just swaps them), re-packing
after a rotate or a swap is the shell's layout_repack, and saving and
previewing go through `hwdp arrange`, whose edge check is the final word.
The one thing duplicated here is the touch/overlap test, because move mode
asks it of many candidate positions per keystroke; it only GUIDES a move.
"""
import curses
import os
import subprocess
import sys
import threading
import time

QUARTER = ("normal", "90", "180", "270")
ROTATED = ("90", "270", "flipped-90", "flipped-270")
PREVIEW_SECONDS = 15
STEP = 25           # a coarse move, in logical pixels, before any snap
NEAR = 200          # facing edges closer than this are worth a warning


def here():
    """The package's own dirs, from the dispatcher's environment or our own
    path (a checkout run directly)."""
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    return (os.environ.get("HWDP_LIBEXEC", os.path.join(root, "libexec")),
            os.environ.get("HWDP_LIB", os.path.join(root, "lib")))


# --- the model ---------------------------------------------------------------

class Output:
    def __init__(self, conn, transform, x, y, lw, lh):
        self.conn = conn
        self.transform = transform
        self.x, self.y = x, y
        self.on = True
        # The UNROTATED logical size: a quarter turn swaps it, exactly,
        # because the compositor's truncation applies to each axis alone.
        if transform in ROTATED:
            self.bw, self.bh = lh, lw
        else:
            self.bw, self.bh = lw, lh

    @property
    def w(self):
        return self.bh if self.transform in ROTATED else self.bw

    @property
    def h(self):
        return self.bw if self.transform in ROTATED else self.bh

    def rect(self):
        return (self.x, self.y, self.w, self.h)

    def token(self):
        kind = "B" if self.conn.startswith(("eDP", "LVDS", "DSI")) else "E"
        return kind + ("P" if self.h > self.w else "L")

    def degrees(self):
        t = self.transform.replace("flipped-", "")
        return "0" if t == "normal" else t


def span(a1, a2, b1, b2):
    """Overlap length of two ranges; 0 means they meet, below 0 apart."""
    return min(a2, b2) - max(a1, b1)


def overlaps(a, b):
    return (span(a[0], a[0] + a[2], b[0], b[0] + b[2]) > 0 and
            span(a[1], a[1] + a[3], b[1], b[1] + b[3]) > 0)


def touches(a, b):
    """Share an EDGE (not just a corner), the layout_faults rule."""
    ox = span(a[0], a[0] + a[2], b[0], b[0] + b[2])
    oy = span(a[1], a[1] + a[3], b[1], b[1] + b[3])
    return (ox == 0 and oy > 0) or (oy == 0 and ox > 0)


class Desk:
    def __init__(self, outputs, repack):
        self.outs = outputs
        self.repack = repack            # (old rects, new sizes) -> positions

    def on(self):
        return [o for o in self.outs if o.on]

    def normalise(self):
        on = self.on()
        if not on:
            return
        mx = min(o.x for o in on)
        my = min(o.y for o in on)
        for o in on:
            o.x -= mx
            o.y -= my

    def _relay(self, old):
        """Re-place every output at its CURRENT size, keeping the topology
        the OLD rects describe (layout_repack)."""
        new = {o.conn: (o.w, o.h) for o in self.on()}
        pos = self.repack(old, new)
        for o in self.on():
            if o.conn in pos:
                o.x, o.y = pos[o.conn]
        self.normalise()

    def rotate(self, o):
        old = {p.conn: p.rect() for p in self.on()}
        base = o.transform.replace("flipped-", "")
        i = QUARTER.index(base) if base in QUARTER else 0
        o.transform = QUARTER[(i + 1) % 4]
        self._relay(old)

    def swap(self, a, b):
        """Exchange the PLACES of two outputs, then re-pack at their own
        sizes, so a portrait and a landscape can trade sides."""
        old = {p.conn: p.rect() for p in self.on()}
        old[a.conn], old[b.conn] = old[b.conn], old[a.conn]
        self._relay(old)

    def faults(self):
        """True when the outputs that are on do not form one edge-joined,
        non-overlapping surface. A guide; `hwdp arrange` decides."""
        on = [o.rect() for o in self.on()]
        for i in range(len(on)):
            for j in range(i + 1, len(on)):
                if overlaps(on[i], on[j]):
                    return True
        seen, todo = {0}, [0]
        while todo:
            i = todo.pop()
            for j in range(len(on)):
                if j not in seen and touches(on[i], on[j]):
                    seen.add(j)
                    todo.append(j)
        return len(seen) != len(on)

    def placements(self):
        lines = []
        for o in self.outs:
            if o.on:
                lines.append("%s rotate %s at %d,%d"
                             % (o.conn, o.degrees(), o.x, o.y))
            else:
                lines.append("%s off" % o.conn)
        return lines


# --- move mode ---------------------------------------------------------------

def valid_spots(mover, others):
    """Every position along every other output's edges where the mover
    touches it, as (along-axis range) generators: (side, fixed, lo, hi)."""
    w, h = mover.w, mover.h
    for n in others:
        nx, ny, nw, nh = n.rect()
        yield ("x", nx + nw, ny - h + 1, ny + nh - 1)     # right of n
        yield ("x", nx - w, ny - h + 1, ny + nh - 1)      # left of n
        yield ("y", ny + nh, nx - w + 1, nx + nw - 1)     # below n
        yield ("y", ny - h, nx - w + 1, nx + nw - 1)      # above n


def nearest_valid(mover, others, cx, cy):
    """The touching, non-overlapping position nearest (cx, cy)."""
    best = None
    for axis, fixed, lo, hi in valid_spots(mover, others):
        if axis == "x":
            x, y = fixed, min(max(cy, lo), hi)
        else:
            x, y = min(max(cx, lo), hi), fixed
        r = (x, y, mover.w, mover.h)
        if any(overlaps(r, n.rect()) for n in others):
            continue
        d = (x - cx) ** 2 + (y - cy) ** 2
        if best is None or d < best[0]:
            best = (d, x, y)
    return None if best is None else best[1:]


def axis(o, ax):
    """An output's (start, length) along one axis."""
    return (o.x, o.w) if ax == "x" else (o.y, o.h)


def snaps(mover, others, ax):
    """The positions along AX where the mover lines up with another output:
    flush against either of its edges, or aligned with its start, end or
    centre. A coarse step stops at the first of these it would pass."""
    size = axis(mover, ax)[1]
    found = set()
    for n in others:
        a, ln = axis(n, ax)
        found.update((a - size, a + ln, a, a + ln - size,
                      a + (ln - size) // 2))
    return found


def at(mover, ax, v):
    """The mover's rect with its AX position replaced by V."""
    return (v, mover.y, mover.w, mover.h) if ax == "x" else \
        (mover.x, v, mover.w, mover.h)


def turn_corner(mover, others, ax, d):
    """Sliding along a neighbour's edge and off its end: the place on that
    neighbour's next side, aligned with the corner just passed (moving down
    the right side of n lands below n, right edges aligned). None when no
    neighbour it was sliding along has such a place free."""
    pa = "y" if ax == "x" else "x"         # the axis it is beside n on
    for n in others:
        if not touches(mover.rect(), n.rect()):
            continue
        ms, ml = axis(mover, pa)
        ns, nl = axis(n, pa)
        if ms == ns + nl:                  # mover after n on that axis
            p = ns + nl - ml
        elif ms + ml == ns:                # mover before n
            p = ns
        else:
            continue                       # touching along AX, not beside
        a, ln = axis(n, ax)
        v = a + ln if d > 0 else a - axis(mover, ax)[1]
        r = (v, p, mover.w, mover.h) if ax == "x" else \
            (p, v, mover.w, mover.h)
        if touches(r, n.rect()) and \
                not any(overlaps(r, o.rect()) for o in others):
            return r[0], r[1]
    return None


def step(desk, mover, dx, dy, snap=True):
    """Move one step along one axis. A coarse step (SNAP) stops early at the
    first alignment it would pass, so a monitor goes FLUSH before anything
    else. A step into a neighbour stops flush against it; only one taken
    from flush jumps to that neighbour's far side (how a monitor gets past
    another). Sliding off the end of a neighbour's edge turns the corner
    onto its next side. A step that would touch nothing goes nowhere."""
    others = [o for o in desk.on() if o is not mover]
    if not others:
        return
    ax = "x" if dx else "y"
    d = dx or dy
    cur = axis(mover, ax)[0]
    v = cur + d
    if snap:
        sign = 1 if d > 0 else -1
        ahead = [s for s in snaps(mover, others, ax)
                 if 0 < (s - cur) * sign <= abs(d)]
        if ahead:
            v = min(ahead, key=lambda s: abs(s - cur))
    hit = [n for n in others if overlaps(at(mover, ax, v), n.rect())]
    if hit:
        # The nearest thing in the way: flush against it, or past it when
        # already flush (the first step into it moved nothing yet).
        flush = [(a - axis(mover, ax)[1]) if d > 0 else (a + ln)
                 for a, ln in (axis(n, ax) for n in hit)]
        stop = min(flush, key=lambda s: abs(s - cur))
        if stop != cur:
            v = stop
        else:
            n = hit[flush.index(stop)]
            a, ln = axis(n, ax)
            v = a + ln if d > 0 else a - axis(mover, ax)[1]
    r = at(mover, ax, v)
    spot = (r[0], r[1])
    if any(overlaps(r, n.rect()) for n in others):
        spot = nearest_valid(mover, others, r[0], r[1])
    elif not any(touches(r, n.rect()) for n in others):
        # Adrift already (something it touched moved away): the nearest
        # place it touches anything, so one key brings it back flush.
        adrift = not any(touches(mover.rect(), n.rect()) for n in others)
        spot = nearest_valid(mover, others, r[0], r[1]) if adrift else \
            turn_corner(mover, others, ax, d)
    if spot is None:
        return
    mover.x, mover.y = spot
    desk.normalise()


def contacts(mover, others):
    """In words, what the mover is flush against and how it lines up, so
    a snap is visible as well as made."""
    said = []
    for n in others:
        if not touches(mover.rect(), n.rect()):
            continue
        if mover.x == n.x + n.w or mover.x + mover.w == n.x:
            side = "right of" if mover.x == n.x + n.w else "left of"
            ax, ends = "y", ("tops", "bottoms")
        else:
            side = "below" if mover.y == n.y + n.h else "above"
            ax, ends = "x", ("lefts", "rights")
        (ms, ml), (ns, nl) = axis(mover, ax), axis(n, ax)
        how = [e + " aligned" for e, hit in
               zip(ends, (ms == ns, ms + ml == ns + nl)) if hit]
        if not how and abs(2 * ms + ml - 2 * ns - nl) <= 1:
            how = ["centred"]
        said.append("%s %s: %s" % (side, n.conn, " and ".join(how)
                                   or "offset %+d" % (ms - ns)))
    return "  ".join(said) or "touching nothing"


def near_misses(desk, reach):
    """Facing edges of two outputs that are on, apart by less than REACH and
    overlapping along the edge: valid (each touches something) but a strip
    the pointer cannot cross, which reads as a broken edge. A guide."""
    on = desk.on()
    found = []
    for i, a in enumerate(on):
        for b in on[i + 1:]:
            for ax, pa in (("x", "y"), ("y", "x")):
                (s1, l1), (s2, l2) = axis(a, ax), axis(b, ax)
                g = max(s2 - (s1 + l1), s1 - (s2 + l2))
                (p1, q1), (p2, q2) = axis(a, pa), axis(b, pa)
                if 0 < g < reach and span(p1, p1 + q1, p2, p2 + q2) > 0:
                    found.append((a.conn, b.conn, g))
    return found


# --- talking to hwdp ---------------------------------------------------------

class Hwdp:
    """Every call out of this tool, in one place, so a test replaces it."""

    def __init__(self):
        self.libexec, self.lib = here()
        self.overlay = None

    def _run(self, *argv, stdin=None):
        # The package's dirs go to every child explicitly: displayset_lib
        # refuses to load without HWDP_LIB, and only the dispatcher exports
        # it, so a tool started any other way could not re-pack at all.
        env = dict(os.environ, HWDP_LIB=self.lib, HWDP_LIBEXEC=self.libexec)
        p = subprocess.run(argv, input=stdin, capture_output=True,
                           text=True, env=env)
        return p.returncode, p.stdout, p.stderr

    def geometry(self):
        rc, out, err = self._run(os.path.join(self.libexec, "cmd",
                                              "geometry"), "--now")
        if rc != 0 or not out.strip():
            raise SystemExit("hwdp arrange: no outputs to arrange (it needs"
                             " a session)\n" + err)
        outs = []
        for line in out.splitlines():
            f = line.split()
            outs.append(Output(f[0], f[3], int(f[5]), int(f[6]),
                               int(f[7]), int(f[8])))
        return outs

    def repack(self, old, new):
        lines = ["old\t%s\t%d\t%d\t%d\t%d" % ((n,) + r)
                 for n, r in old.items()]
        lines += ["new\t%s\t%d\t%d" % ((n,) + s) for n, s in new.items()]
        rc, out, err = self._run(
            "sh", "-c", '. "$1/displayset_lib"; layout_repack', "_",
            self.lib, stdin="\n".join(lines) + "\n")
        # LOUD: an empty answer here once meant "nothing moves", which left
        # a rotated monitor overlapping its neighbour with no word said.
        if rc != 0 or not out.strip():
            raise RuntimeError("hwdp arrange: layout_repack failed (%d): %s"
                               % (rc, err.strip()))
        pos = {}
        for line in out.splitlines():
            n, x, y = line.split("\t")
            pos[n] = (int(x), int(y))
        return pos

    def arrange(self, mode, placements, progress=None):
        """PROGRESS, when given, is called with each line arrange says as
        it says it, so a save that waits on a slow hook is not silent."""
        argv = [os.path.join(self.libexec, "cmd", "arrange")]
        if mode:
            argv.append(mode)
        env = dict(os.environ, HWDP_LIB=self.lib, HWDP_LIBEXEC=self.libexec)
        p = subprocess.Popen(argv + list(placements), stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE, text=True, env=env)
        said = [""]

        def read():
            for line in p.stderr:
                line = line.strip()
                if line:
                    said[0] = line
                    if progress:
                        progress(line)
        # Done when ARRANGE exits, not when its stderr closes: a hook that
        # leaves something running holding that pipe must not hold us.
        reader = threading.Thread(target=read, daemon=True)
        reader.start()
        rc = p.wait()
        reader.join(0.5)
        return rc, said[0]

    def _surf(self, *args, stdin=None):
        rc, out, err = self._run(os.path.join(self.libexec, "cmd",
                                              "surfaces"), *args, stdin=stdin)
        return rc, out, (err.strip().splitlines() or ["exit %d" % rc])[-1]

    def surfaces(self, desk):
        """(placements, default, why) for this desk, as the tool edits them;
        (None, None, why) when the files cannot be read safely. Read through
        `hwdp surfaces --map`, the published answer, never by parsing a
        file: the region comes back as fractions, the default as `* *`."""
        rc, out, why = self._surf("--map")
        if rc != 0:
            return None, None, why
        found, default = [], None
        for line in out.splitlines():
            f = line.split()
            region = REGION_OF.get(tuple(float(v) for v in f[9:13]), "full")
            if f[2] == "*":
                default = Surface(f[0], f[1], region, None, None)
            else:
                found.append(Surface(f[0], f[1], region, int(f[2]),
                                     int(f[3])))
        return found, default, ""

    def grid(self):
        """(w, h) the desk sets, or None."""
        rc, out, _ = self._surf("--grid")
        f = out.split()
        return (int(f[0]), int(f[1])) if rc == 0 and len(f) == 2 else None

    def names(self):
        """[[name, label], ...], the global list, in its order."""
        rc, out, _ = self._surf("--names")    # always `name label`
        return [ln.split(None, 1) for ln in out.splitlines()
                if len(ln.split(None, 1)) == 2] if rc == 0 else []

    def write_desk(self, grid, surfaces, default):
        lines = "grid %d %d\n" % grid
        lines += "".join("surface %s %s cell %d %d %s\n"
                         % (s.name, s.conn, s.cx, s.cy, s.region)
                         for s in surfaces)
        if default:
            lines += "default %s %s %s\n" % (default.name, default.conn,
                                             default.region)
        rc, _, why = self._surf("--write", stdin=lines)
        return rc, why

    def write_names(self, names):
        rc, _, why = self._surf("--write-names", stdin="".join(
            "%s %s\n" % (n, lab) for n, lab in names))
        return rc, why

    def identify(self, on):
        if on and self.overlay is None:
            self.overlay = subprocess.Popen(
                [os.path.join(self.libexec, "cmd", "identify"),
                 "--parent", str(os.getpid())],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        elif not on and self.overlay is not None:
            self.overlay.terminate()
            try:
                self.overlay.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.overlay.kill()
            self.overlay = None
        return self.overlay is not None


# --- surfaces: named parts of a monitor --------------------------------------

REGIONS = ("full", "top", "bottom", "left", "right")
# `hwdp surfaces --map` gives a region as fractions of its panel.
REGION_OF = {(0, 0, 1, 1): "full", (0, 0, 1, 0.5): "top",
             (0, 0.5, 1, 0.5): "bottom", (0, 0, 0.5, 1): "left",
             (0.5, 0, 0.5, 1): "right"}
NEW_GRID = (3, 3)       # a desk that sets no grid starts here (the user's)


class Surface:
    def __init__(self, name, conn, region, cx, cy):
        self.name, self.conn, self.region = name, conn, region
        self.cx, self.cy = cx, cy

    def key(self):
        return (self.name, self.conn, self.region, self.cx, self.cy)


def clashes(a, b):
    """The same part of one monitor in one cell; opposite halves do not.
    The writer decides; this only answers the form at once."""
    if (a.conn, a.cx, a.cy) != (b.conn, b.cx, b.cy):
        return False
    pair = {a.region, b.region}
    return not (pair == {"top", "bottom"} or pair == {"left", "right"})


def region_rect(region, w, h):
    """Where a region sits inside a w x h output (halves, as hwdp does)."""
    return {"full": (0, 0, w, h), "top": (0, 0, w, h // 2),
            "bottom": (0, h // 2, w, h - h // 2),
            "left": (0, 0, w // 2, h),
            "right": (w // 2, 0, w - w // 2, h)}[region]


# --- the controller: what a key means ---------------------------------------

ARROWS = {curses.KEY_LEFT: (-1, 0), curses.KEY_RIGHT: (1, 0),
          curses.KEY_UP: (0, -1), curses.KEY_DOWN: (0, 1),
          ord("h"): (-1, 0), ord("l"): (1, 0),
          ord("k"): (0, -1), ord("j"): (0, 1)}
FINE = {curses.KEY_SLEFT: (-1, 0), curses.KEY_SRIGHT: (1, 0),
        curses.KEY_SR: (0, -1), curses.KEY_SF: (0, 1),
        ord("H"): (-1, 0), ord("L"): (1, 0),
        ord("K"): (0, -1), ord("J"): (0, 1)}
ESC = 27
ENTER = (10, 13, curses.KEY_ENTER)


class App:
    def __init__(self, desk, hw):
        self.desk, self.hw = desk, hw
        self.sel = 0
        self.mark = None          # the output marked for a swap
        self.moving = None        # (output, x, y) it started the move at
        self.saved = desk.placements()
        self.live_unsaved = False  # a preview was KEPT but not saved
        self.dialog = None        # (kind, its deadline or default)
        self.msg = ""
        self.ident = False
        self.done = False
        self.form = None          # the name form, while it is up
        self.busy = None          # [what, since, latest line] while saving
        self.job = None           # the save running beside the screen
        self.tab = 0              # TABS: physical, virtual, review
        self.side = 0             # the sidebar's selected name
        self.vcell = [0, 0]       # the virtual tab's selected cell
        self.vpanel = 0           # ... panel in it (index into desk.on())
        self.vregion = 0          # ... and region (index into REGIONS)
        self.rscroll = 0          # the review tab's first line
        self.pick = None          # the picker, while it is up
        surf, default, why = hw.surfaces(desk)
        # Files `hwdp surfaces` refuses are NOT edited on top of: rewriting
        # them from what the tool could read would drop what it could not.
        self.names_blocked = why if surf is None else ""
        self.surfaces = surf or []
        self.default = default
        self.grid = hw.grid() or NEW_GRID
        self.names = hw.names()
        self._mark_saved()

    def _mark_saved(self):
        self.saved_surfaces = self._surface_keys()
        self.saved_default = self.default.key() if self.default else None
        self.saved_grid = self.grid
        self.saved_names = [list(n) for n in self.names]

    @property
    def cur(self):
        return self.desk.outs[self.sel]

    def _surface_keys(self):
        return sorted(x.key() for x in self.surfaces)

    def desk_dirty(self):
        return (self._surface_keys() != self.saved_surfaces
                or self.grid != self.saved_grid
                or (self.default.key() if self.default else None)
                != self.saved_default)

    def dirty(self):
        return (self.desk.placements() != self.saved or self.live_unsaved
                or self.desk_dirty() or self.names != self.saved_names)

    # Dialogs first: while one is up, it owns the keyboard. Then what is
    # the same on every tab (switching, the sidebar, save, quit), then the
    # tab's own keys.
    def key(self, k, now):
        if self.busy:
            return                # a save owns the screen until it lands
        if self.dialog:
            return self._dialog_key(k, now)
        if self.moving and (k in ARROWS or k in FINE):
            return self._move(k)
        tab = {ord("1"): 0, ord("2"): 1, ord("3"): 2, ord("4"): 3,
               curses.KEY_F1: 0, curses.KEY_F2: 1, curses.KEY_F3: 2,
               curses.KEY_F4: 3}.get(k)
        if tab is not None:
            self.tab, self.msg = tab, ""
            return
        common = {ord("q"): self._quit, ord("s"): self._save_here}.get(k)
        if common:
            return common(now)
        if k == ESC:
            return self._escape(now)
        if self.tab == 1:
            return self._surfaces_key(k, now)
        if self.tab == 2:
            return self._virtual_key(k, now)
        if self.tab == 3:
            if k in ARROWS:
                self.rscroll = max(0, self.rscroll + ARROWS[k][1] * 3)
            elif k in (curses.KEY_NPAGE, ord(" ")):
                self.rscroll += 15
            elif k == curses.KEY_PPAGE:
                self.rscroll = max(0, self.rscroll - 15)
            return
        if k in ARROWS or k in (9, curses.KEY_BTAB):
            return self._select(k)
        action = {ord("r"): self._rotate, ord("w"): self._swap,
                  ord("m"): self._move_mode, ord("o"): self._toggle_on,
                  ord("i"): self._identify, ord("p"): self._preview}.get(k)
        if action:
            return action(now)
        if k in ENTER:
            return self._commit(now)

    def tick(self, now):
        self._landed()
        if self.dialog and self.dialog[0] == "keep" and now >= self.dialog[1]:
            self._revert("no answer: reverted")

    def _select(self, k):
        n = len(self.desk.outs)
        if k == 9:
            self.sel = (self.sel + 1) % n
            return
        if k == curses.KEY_BTAB:
            self.sel = (self.sel - 1) % n
            return
        dx, dy = ARROWS[k]
        c = self.cur
        cx, cy = c.x + c.w / 2, c.y + c.h / 2
        best = None
        for i, o in enumerate(self.desk.outs):
            if o is c or not o.on:
                continue
            ox, oy = o.x + o.w / 2 - cx, o.y + o.h / 2 - cy
            ahead = ox * dx + oy * dy
            if ahead <= 0:
                continue
            d = ahead + 2 * abs(ox * dy + oy * dx)
            if best is None or d < best[0]:
                best = (d, i)
        if best:
            self.sel = best[1]

    def _rotate(self, now):
        if self.cur.on:
            self.desk.rotate(self.cur)
            self.msg = "%s rotated" % self.cur.conn

    def _swap(self, now):
        c = self.cur
        if not c.on:
            self.msg = "%s is off" % c.conn
        elif self.mark is None or self.mark is c:
            self.mark = None if self.mark is c else c
            self.msg = ("%s marked: select another and press w or Enter"
                        % c.conn) if self.mark else ""
        else:
            self.desk.swap(self.mark, c)
            self.msg = "swapped %s and %s" % (self.mark.conn, c.conn)
            self.mark = None

    def _move_mode(self, now):
        c = self.cur
        if self.moving:
            self.moving = None
            self.msg = "%s locked at %d,%d" % (c.conn, c.x, c.y)
        elif c.on:
            self.moving = (c, c.x, c.y)
            self.msg = ("moving %s: arrows step, shift+arrow one pixel,"
                        " Enter locks, Esc undoes" % c.conn)

    def _move(self, k):
        o = self.moving[0]
        if k in FINE:
            dx, dy = FINE[k]
        else:
            dx, dy = ARROWS[k]
            dx, dy = dx * STEP, dy * STEP
        step(self.desk, o, dx, dy, snap=k not in FINE)
        self.msg = "%s %d,%d  %s" % (
            o.conn, o.x, o.y,
            contacts(o, [n for n in self.desk.on() if n is not o]))

    def _toggle_on(self, now):
        c = self.cur
        if c.on and len(self.desk.on()) == 1:
            self.msg = "the last monitor on cannot be switched off"
            return
        c.on = not c.on
        if c.on:
            spot = nearest_valid(c, [o for o in self.desk.on()
                                     if o is not c], c.x, c.y)
            if spot:
                c.x, c.y = spot
        self.desk.normalise()
        self.msg = "%s switched %s" % (c.conn, "on" if c.on else "off")

    def _identify(self, now):
        self.ident = self.hw.identify(not self.ident)
        if not self.ident:
            self.msg = "labels off"

    def _preview(self, now):
        if self.desk.faults():
            self.msg = "the monitors must meet edge to edge first"
            return
        rc, why = self.hw.arrange("--preview", self.desk.placements())
        if rc == 0:
            self.dialog = ("keep", now + PREVIEW_SECONDS)
        else:
            self.msg = why or "preview failed (%d)" % rc

    def _revert(self, why):
        self.hw.arrange("--revert", [])
        self.live_unsaved = False
        self.dialog = None
        self.msg = why

    def _save(self, now, then_exit):
        """The layout, the names, the desk; done only if all landed. It runs
        BESIDE the screen, which says what it is waiting on: a save fires
        the integrator's hooks, and those can take seconds.

        THE NAMES GO IN TWO STEPS around the desk, because a desk may only
        place listed names and the list may not drop a placed one: first the
        new list PLUS anything removed that the saved desk still places,
        then the desk, then the new list alone."""
        self.dialog = None
        place = self.desk.placements()
        layout = place != self.saved or self.live_unsaved
        desk = (self.grid, list(self.surfaces), self.default) \
            if self.desk_dirty() else None
        names = [list(n) for n in self.names]
        keep = [n for n in self.saved_names
                if n[0] not in {m[0] for m in names}]
        names_changed = names != self.saved_names
        self.busy = ["saving", now, ""]

        def said(line):
            self.busy[2] = line

        def step(what, call, *args):
            self.busy[0] = what
            rc, why = call(*args)
            return "" if rc == 0 else "%s: %s" % (what, why or "exit %d" % rc)

        def work():
            if layout:
                self.busy[0] = "saving the layout"
                rc, why = self.hw.arrange(None, place, progress=said)
                if rc != 0:
                    return why or "not saved (%d)" % rc, "none"
            if names_changed:
                why = step("saving names", self.hw.write_names, names + keep)
                if why:
                    return why, "layout"
            if desk is not None:
                why = step("saving the desk", self.hw.write_desk, *desk)
                if why:
                    return why, "layout"
            if keep:
                why = step("removing names", self.hw.write_names, names)
                if why:
                    return why, "desk"
            return "", "all"

        def finish(res):
            why, upto = res
            if upto != "none":
                self.saved, self.live_unsaved = place, False
            if upto in ("desk", "all"):
                self._mark_saved()
                if upto == "desk":           # the list still holds `keep`
                    self.saved_names = names + keep
            self.msg = why or "saved"
            self.done = then_exit and not why
        self.job = self.spawn(work, finish)
        self._landed()

    @staticmethod
    def spawn(work, finish):
        """Run WORK on a thread; the screen calls FINISH with its answer
        once it lands (see _landed). A test swaps in a synchronous one."""
        job = {"finish": finish}

        def run():
            try:
                job["res"] = work()
            except Exception as e:      # said on screen, never swallowed
                job["res"] = ("save failed: %s" % e, None)
        job["thread"] = threading.Thread(target=run, daemon=True)
        job["thread"].start()
        return job

    def _landed(self):
        if self.job and "res" in self.job:
            job, self.job, self.busy = self.job, None, None
            job["finish"](job["res"])

    # --- the sidebar: the global surface names --------------------------
    def _blocked(self):
        if self.names_blocked:
            self.msg = ("surfaces cannot be edited: " + self.names_blocked +
                        " (see hwdp surfaces --check)")
        return bool(self.names_blocked)

    def side_name(self):
        return self.names[self.side][0] if self.names else None

    def _surfaces_key(self, k, now):
        """The SURFACES tab: the names, edited here and nowhere else."""
        if k in (curses.KEY_DOWN, ord("j")):
            return self._side_down(now)
        if k in (curses.KEY_UP, ord("k")):
            return self._side_up(now)
        act = {ord("a"): self._name_add, ord("e"): self._name_edit,
               ord("D"): self._name_delete}.get(k)
        if act:
            return act(now)

    def _side_down(self, now):
        if self.names:
            self.side = (self.side + 1) % len(self.names)

    def _side_up(self, now):
        if self.names:
            self.side = (self.side - 1) % len(self.names)

    def placed(self, name):
        """Where NAME is at this desk: its surfaces, and whether it is the
        default (the sidebar's marker reads this)."""
        here = [x for x in self.surfaces if x.name == name]
        return here, bool(self.default and self.default.name == name)

    def _name_add(self, now):
        if not self._blocked():
            self.form = {"field": 0, "name": "", "label": "", "err": "",
                         "edit": None}
            self.dialog = ("name", None)

    def _name_edit(self, now):
        if self._blocked() or not self.names:
            return
        n, lab = self.names[self.side]
        self.form = {"field": 1, "name": n, "label": lab, "err": "",
                     "edit": self.side}
        self.dialog = ("name", None)

    def _name_delete(self, now):
        if not self._blocked() and self.names:
            self.dialog = ("delname", None)

    def _form_key(self, k):
        """The name form: a NAME (the machine key: letters, digits, - and _;
        fixed once made, since other desks may place it) and a LABEL (what
        a workspace name shows; spaces allowed)."""
        f = self.form
        if k == ESC:
            self.form, self.dialog = None, None
        elif k in ENTER:
            self._form_done()
        elif k in (9, curses.KEY_DOWN, curses.KEY_BTAB, curses.KEY_UP):
            f["field"] = 1 if f["edit"] is not None else 1 - f["field"]
        elif k in (curses.KEY_BACKSPACE, 127, 8):
            fld = "name" if f["field"] == 0 else "label"
            f[fld] = f[fld][:-1]
        elif 32 <= k < 127:
            c = chr(k)
            if f["field"] == 0 and (c.isalnum() or c in "_-"):
                f["name"] += c
            elif f["field"] == 1:
                f["label"] += c

    def _form_done(self):
        f = self.form
        label = f["label"].strip() or f["name"]
        if f["edit"] is not None:
            self.names[f["edit"]][1] = label
            self.msg = "%s is labelled %s" % (f["name"], label)
        elif not f["name"]:
            f["err"] = "give it a name"
            return
        elif any(n == f["name"] for n, _ in self.names):
            f["err"] = "%s is already a name" % f["name"]
            return
        else:
            self.names.append([f["name"], label])
            self.side = len(self.names) - 1
            self.msg = "%s added; place it in the virtual tab" % f["name"]
        self.form, self.dialog = None, None

    def _name_gone(self):
        """Delete the selected name, and its places at THIS desk with it.
        Another desk placing it makes the save refuse, naming that desk."""
        n = self.names.pop(self.side)[0]
        self.surfaces = [x for x in self.surfaces if x.name != n]
        if self.default and self.default.name == n:
            self.default = None
        self.side = max(0, min(self.side, len(self.names) - 1))
        self.dialog, self.msg = None, "%s deleted" % n

    # --- the virtual tab: surfaces on the grid --------------------------
    def vspot(self):
        """(output, region) selected in the virtual tab, or (None, region)
        when no output is on."""
        on = self.desk.on()
        if not on:
            return None, REGIONS[self.vregion]
        self.vpanel %= len(on)
        return on[self.vpanel], REGIONS[self.vregion]

    def at_spot(self):
        """The surfaces that overlap the selected spot."""
        o, rg = self.vspot()
        probe = Surface("", o.conn if o else "", rg, *self.vcell)
        return [x for x in self.surfaces if clashes(probe, x)]

    def _virtual_key(self, k, now):
        if k in ARROWS:
            dx, dy = ARROWS[k]
            self.vcell = [min(max(self.vcell[0] + dx, 0), self.grid[0] - 1),
                          min(max(self.vcell[1] + dy, 0), self.grid[1] - 1)]
            return
        if k in (9, curses.KEY_BTAB):
            n = max(1, len(self.desk.on()))
            self.vpanel = (self.vpanel + (1 if k == 9 else -1)) % n
            return
        act = {ord("g"): self._vregion, ord("x"): self._vclear,
               ord("f"): lambda now: self._pick("default"),
               ord("F"): self._vnodefault,
               ord("+"): lambda now: self._regrid(1, 0),
               ord("-"): lambda now: self._regrid(-1, 0),
               ord("]"): lambda now: self._regrid(0, 1),
               ord("["): lambda now: self._regrid(0, -1)}.get(k)
        if act:
            return act(now)
        if k in ENTER:
            return self._pick("place")

    # --- the picker: which name goes on the selected spot -----------------
    def _pick(self, mode):
        """Open the picker over the names. PLACE puts the choice on the
        selected spot; DEFAULT makes it the default there. It starts on what
        is there now, so Enter twice changes nothing."""
        if self._blocked():
            return
        if not self.names:
            self.msg = "no names yet: tab 2 adds them"
            return
        if self.vspot()[0] is None:
            return
        here = [x.name for x in self.at_spot()] if mode == "place" else \
            [self.default.name] if self.default else []
        names = [n for n, _ in self.names]
        self.pick = {"mode": mode, "filter": "",
                     "sel": names.index(here[0]) if here else 0}
        self.dialog = ("pick", None)

    def pick_list(self):
        """The names the picker shows: those whose name or label holds what
        has been typed, in the list's order."""
        f = self.pick["filter"].lower()
        return [(n, lab) for n, lab in self.names
                if f in n.lower() or f in lab.lower()]

    def _pick_key(self, k, now):
        pk, shown = self.pick, self.pick_list()
        if k == ESC:
            self.pick, self.dialog = None, None
        elif k in ENTER:
            if shown:
                n = shown[min(pk["sel"], len(shown) - 1)][0]
                self.pick, self.dialog = None, None
                (self._vplace if pk["mode"] == "place" else
                 self._vdefault)(n)
        elif k == curses.KEY_DOWN:
            pk["sel"] = min(pk["sel"] + 1, max(0, len(shown) - 1))
        elif k == curses.KEY_UP:
            pk["sel"] = max(pk["sel"] - 1, 0)
        elif k in (curses.KEY_BACKSPACE, 127, 8):
            pk["filter"], pk["sel"] = pk["filter"][:-1], 0
        elif 32 < k < 127:
            pk["filter"], pk["sel"] = pk["filter"] + chr(k), 0

    def _vregion(self, now):
        self.vregion = (self.vregion + 1) % len(REGIONS)

    def _vplace(self, n):
        """Put name N HERE. A name is in one place per desk, so it MOVES if
        it was elsewhere; whatever overlapped this spot goes."""
        o, rg = self.vspot()
        if self._blocked() or o is None or n is None:
            return
        gone = [x.name for x in self.at_spot() if x.name != n]
        self.surfaces = [x for x in self.surfaces
                         if x.name != n and x.name not in gone]
        if self.default and self.default.name == n:
            self.default = None
        self.surfaces.append(Surface(n, o.conn, rg, *self.vcell))
        self.msg = "%s: %s of %s, cell %d %d%s" % (
            n, rg, o.conn, self.vcell[0], self.vcell[1],
            ("  (replaced %s)" % ", ".join(gone)) if gone else "")

    def _vclear(self, now):
        gone = self.at_spot()
        if not self._blocked() and gone:
            self.surfaces = [x for x in self.surfaces if x not in gone]
            self.msg = "cleared " + ", ".join(x.name for x in gone)

    def _vdefault(self, n):
        """Name N becomes the DEFAULT on this panel and region: where every
        cell no surface claims falls. Not also a surface."""
        o, rg = self.vspot()
        if self._blocked() or o is None or n is None:
            return
        self.surfaces = [x for x in self.surfaces if x.name != n]
        self.default = Surface(n, o.conn, rg, None, None)
        self.msg = "%s is the default: %s of %s" % (n, rg, o.conn)

    def _vnodefault(self, now):
        if self.default:
            self.default, self.msg = None, "no default"

    def _regrid(self, dw, dh):
        """Grow or shrink the grid. Shrinking REFUSES while the column or
        row going away holds a surface: clear it first, nothing silently."""
        w, h = self.grid[0] + dw, self.grid[1] + dh
        if w < 1 or h < 1:
            return
        lost = [x.name for x in self.surfaces if x.cx >= w or x.cy >= h]
        if lost:
            self.msg = "not shrinking: %s would fall off the grid" % \
                ", ".join(lost)
            return
        self.grid = (w, h)
        self.vcell = [min(self.vcell[0], w - 1), min(self.vcell[1], h - 1)]
        self.msg = "grid %dx%d" % self.grid

    def _save_here(self, now):
        if self.dirty():
            self._save(now, False)
        else:
            self.msg = "nothing to save"

    def _commit(self, now):
        """Enter finishes what is in progress, and is nothing otherwise:
        a move is locked, a marked swap is made with the selection."""
        if self.moving:
            self._move_mode(now)
        elif self.mark and self.mark is not self.cur:
            self._swap(now)

    def _quit(self, now, default=ord("s")):
        """Leave, at once when nothing is unsaved; otherwise ask. DEFAULT
        is the answer Enter picks: save from q (leaving was asked for),
        keep editing from Esc (a back-out key never writes or discards)."""
        if self.dirty():
            self.dialog = ("quit", default)
        else:
            self.done = True

    def _escape(self, now):
        if self.moving:
            o, x, y = self.moving
            o.x, o.y = x, y
            self.moving = None
            self.desk.normalise()
            self.msg = "move undone"
        elif self.mark:
            self.mark, self.msg = None, ""
        else:
            self._quit(now, ESC)

    def _dialog_key(self, k, now):
        kind = self.dialog[0]
        if kind == "name":
            return self._form_key(k)
        if kind == "pick":
            return self._pick_key(k, now)
        if kind == "delname":
            if k in (ord("y"), ord("D")):
                self._name_gone()
            elif k in (ESC, ord("n")) or k in ENTER:
                self.dialog = None      # Enter keeps it: deleting is asked
            return
        if kind == "quit":
            if k in ENTER:
                k = self.dialog[1]
            if k == ord("s"):
                self._save(now, True)
            elif k == ord("d"):
                if self.live_unsaved:
                    self.hw.arrange("--revert", [])
                self.done = True
            elif k == ESC:
                self.dialog = None
        elif kind == "keep":
            if k in (ord("y"), ord("k")) or k in ENTER:
                self.live_unsaved = True
                self.dialog = None
                self.msg = "kept live; s saves it"
            elif k in (ESC, ord("n")):
                self._revert("reverted")


# --- the view: drawing only --------------------------------------------------

TABS = ("Physical", "Surfaces", "Virtual", "Review")
HELP = (
    "Tab/arrows select  m move  r rotate  w swap  o off/on  i identify"
    "  p preview",
    "arrows select  a add  e label  D delete",
    "arrows cell  Tab panel  g region  Enter place  f default"
    "  F no default  x clear  +/- columns  ]/[ rows",
    "arrows / PgUp PgDn scroll")
HELP_ALL = "1-4 tabs  s save  q quit"
SIDE_W = 26             # the sidebar's columns, when the screen has them

# Line drawing: the box-drawing glyphs on a UTF-8 terminal, ASCII elsewhere
# (a Linux text console, an odd locale). main() picks once, after setting the
# locale; everything draws through G.
ASCII = {"h": "-", "v": "|", "tl": "+", "tr": "+", "bl": "+", "br": "+"}
UTF8 = {"h": "\u2500", "v": "\u2502", "tl": "\u250c", "tr": "\u2510",
        "bl": "\u2514", "br": "\u2518"}
G = dict(ASCII)


def frame(scr, y, x, w, h, attr=0, title="", fill=False):
    """A box in the line glyphs, TITLE set into its top edge; FILL clears
    the inside, so one box drawn over another hides what is under it."""
    top = G["tl"] + (" %s " % title if title else "")
    put(scr, y, x, top + G["h"] * max(0, w - 1 - len(top)) + G["tr"], attr)
    for r in range(1, h - 1):
        if fill:
            put(scr, y + r, x, G["v"] + " " * (w - 2) + G["v"], attr)
        else:
            put(scr, y + r, x, G["v"], attr)
            put(scr, y + r, x + w - 1, G["v"], attr)
    put(scr, y + h - 1, x, G["bl"] + G["h"] * max(0, w - 2) + G["br"], attr)


def put(scr, y, x, text, attr=0):
    h, w = scr.getmaxyx()
    if 0 <= y < h and x < w:
        try:
            scr.addstr(y, max(0, x), text[:max(0, w - x - 1)], attr)
        except curses.error:
            pass


def cells(o, mx, my, sc, top, left=1):
    """An output's box in screen cells. BOTH edges are rounded from the
    layout, never a rounded start plus a rounded width: that is what drew a
    one-cell gap between two outputs that were flush."""
    x0 = round((o.x - mx) * sc) + left
    x1 = round((o.x + o.w - mx) * sc) + left
    y0 = round((o.y - my) * sc / 2) + top
    y1 = round((o.y + o.h - my) * sc / 2) + top
    return x0, y0, max(4, x1 - x0), max(3, y1 - y0)


def pack(items, width, sep=2):
    """Greedy lines of ITEMS (each kept whole) joined by SEP spaces."""
    lines = [[]]
    for it in items:
        used = sum(map(len, lines[-1])) + sep * len(lines[-1])
        if lines[-1] and used + len(it) > width:
            lines.append([])
        lines[-1].append(it)
    return lines


def wrap(lines, width):
    """Pack each label line's words into WIDTH; a word longer than that
    keeps its own line and spills past the border rather than be cut."""
    out = []
    for words in lines:
        cur = ""
        for word in words:
            if cur and len(cur) + 1 + len(word) > width:
                out.append(cur)
                cur = word
            else:
                cur = (cur + " " + word) if cur else word
        out.append(cur)
    return out


def draw_desk(scr, app, top, rows, cols, left=1):
    on = app.desk.on()
    if not on:
        return
    mx = min(o.x for o in on)
    my = min(o.y for o in on)
    bw = max(o.x + o.w for o in on) - mx
    bh = max(o.y + o.h for o in on) - my
    sc = min((cols - 2) / bw, (rows - 2) * 2 / bh)
    boxes = []
    for o in on:
        x0, y0, w, h = cells(o, mx, my, sc, top, left)
        attr = curses.color_pair(0)
        if app.moving and app.moving[0] is o:
            attr = curses.color_pair(3) | curses.A_BOLD
        elif app.mark is o:
            attr = curses.color_pair(2) | curses.A_BOLD
        elif app.cur is o:
            attr = curses.color_pair(1) | curses.A_BOLD
        frame(scr, y0, x0, w, h, attr, fill=True)
        boxes.append((o, x0, y0, w, h, attr))
    # Labels after EVERY box, so one that spills is not drawn over.
    for o, x0, y0, w, h, attr in boxes:
        pad = 2 if w >= 14 else 1
        text = wrap(([o.conn, o.token()], ["%dx%d" % (o.w, o.h)],
                     ["at", "%d,%d" % (o.x, o.y)]), w - 2 * pad)
        for i, line in enumerate(text):
            put(scr, y0 + 1 + i, x0 + pad, line, attr)


def form_lines(app):
    f = app.form
    mark = ["  ", "  "]
    mark[f["field"]] = "> "
    edit = f["edit"] is not None
    return ["Label %s" % f["name"] if edit else "A new surface name", "",
            mark[0] + "name   " + f["name"] + ("" if edit else "_"),
            mark[1] + "label  " + f["label"] + "_", "",
            "name: letters, digits, - and _ (fixed once made)",
            "label: what a workspace name shows (blank = the name)",
            f["err"] or "Tab field  Enter %s  Esc cancel"
            % ("keep" if edit else "add")]


QUIT = ((ord("s"), "s    save and quit"), (ord("d"), "d    discard and quit"),
        (ESC, "Esc  keep editing"))


def draw_dialog(scr, app, now):
    kind, arg = app.dialog          # a deadline, or the default answer
    if kind == "name":
        text = form_lines(app)
    elif kind == "delname":
        n = app.side_name()
        here, dflt = app.placed(n)
        text = ["Delete the name %s?" % n, "",
                "It goes from EVERY desk's list; here it is %s." %
                ("placed %d time(s)%s" % (len(here), ", and the default"
                                         if dflt else "") if here or dflt
                 else "not placed"),
                "A desk elsewhere that places it makes the save refuse.",
                "", "y  delete it", "Esc  keep it"]
    elif kind == "pick":
        text = pick_lines(app)
    elif kind == "quit":
        text = (["Unsaved changes.", ""] +
                [("> " if arg == key else "  ") + line for key, line in QUIT]
                + ["", "Enter picks the >"])
    else:
        text = ["Keep this setting?", "", "y  keep it (s saves it)",
                "n  revert now",
                "reverting in %ds" % max(0, int(arg - now + 0.99))]
    box(scr, text)


def box(scr, text):
    h, w = scr.getmaxyx()
    bw = max(len(t) for t in text) + 6
    y0, x0 = max(0, (h - len(text) - 2) // 2), max(0, (w - bw) // 2)
    attr = curses.color_pair(4) | curses.A_BOLD
    frame(scr, y0, x0, bw, len(text) + 2, attr, fill=True)
    for i, t in enumerate(text):
        put(scr, y0 + 1 + i, x0 + 3, t, attr)


def pick_lines(app):
    """The picker: what the choice is for, the filter typed so far, and the
    names that match it, the chosen one marked."""
    pk, shown = app.pick, app.pick_list()
    o, rg = app.vspot()
    what = ("Place on cell %d,%d, %s of %s" % (app.vcell[0], app.vcell[1],
                                              rg, o.conn)
            if pk["mode"] == "place" else
            "The DEFAULT: %s of %s, every cell nothing claims" % (rg, o.conn))
    sel = min(pk["sel"], max(0, len(shown) - 1))
    first = max(0, min(sel - 5, len(shown) - 12))
    rows = ["%s %-20s %s" % ("> " if i == sel else "  ", n, lab)
            for i, (n, lab) in enumerate(shown) if first <= i < first + 12]
    return [what, "", "filter: " + pk["filter"] + "_", ""] + \
        (rows or ["  (no name matches)"]) + \
        ["", "type to filter  arrows choose  Enter %s  Esc cancel" %
         ("place" if pk["mode"] == "place" else "set")]


def label_of(app, name):
    for n, lab in app.names:
        if n == name:
            return lab
    return name


def covered(app, o, cx, cy):
    """The regions of output O claimed in cell (cx, cy), and whether that
    covers it whole (full, or both halves of one split)."""
    rg = {x.region for x in app.surfaces
          if x.conn == o.conn and (x.cx, x.cy) == (cx, cy)}
    return rg, ("full" in rg or {"top", "bottom"} <= rg
                or {"left", "right"} <= rg)


def review_lines(app):
    """The map as it will be saved, cell by cell, then what is missing from
    it: the Review tab. Pure, so a test reads it without a screen."""
    out = ["grid %dx%d" % app.grid]
    d = app.default
    out.append("default: %s, %s of %s" % (d.name, d.region, d.conn)
               if d else "default: none (a cell nothing claims is a gap)")
    gaps = []
    for cy in range(app.grid[1]):
        for cx in range(app.grid[0]):
            out.append("")
            out.append("cell %d,%d" % (cx, cy))
            for o in app.desk.on():
                here = sorted((x for x in app.surfaces if x.conn == o.conn
                               and (x.cx, x.cy) == (cx, cy)),
                              key=lambda x: REGIONS.index(x.region))
                rg, whole = covered(app, o, cx, cy)
                txt = "  ".join("%s %s" % (x.region, x.name) for x in here)
                if not whole:
                    if d and d.conn == o.conn:
                        txt += ("  " if txt else "") + "(rest: default)"
                    elif d:
                        txt += ("  " if txt else "") + "(rest: default " \
                            "on %s)" % d.conn
                    else:
                        gaps.append("cell %d,%d %s" % (cx, cy, o.conn))
                        txt += ("  " if txt else "") + "(GAP)"
                out.append("  %-6s %s  %s" % (o.conn, o.token(), txt))
    problems = []
    unplaced = [n for n, _ in app.names if app.placed(n) == ([], False)]
    if unplaced:
        problems.append("not placed here: " + ", ".join(unplaced))
    if gaps:
        problems.append("%d gap(s) and no default: %s" %
                        (len(gaps), "; ".join(gaps[:6]) +
                         (" ..." if len(gaps) > 6 else "")))
    return ["NOTES"] + (problems or ["none: every cell is covered"]) + \
        [""] + out


def mark_of(app, n):
    """A name's marker: D the default here, N placed here N times, - not
    placed at this desk."""
    here, dflt = app.placed(n)
    return ("D" if dflt else "%d" % len(here) if here else "-"), \
        bool(here or dflt)


def draw_sidebar(scr, app, top, rows, width):
    """READ-ONLY: every surface name and its marker, a solid rule on its
    right, its own legend at its foot. Names are edited in tab 2."""
    put(scr, top, 1, "SURFACES", curses.A_BOLD)
    room = rows - 4
    for i, (n, lab) in enumerate(app.names[:room]):
        mk, used = mark_of(app, n)
        put(scr, top + 2 + i, 1, ("%s %s" % (mk, n))[:width - 2],
            0 if used else curses.A_DIM)
    if len(app.names) > room:
        put(scr, top + 2 + room - 1, 1, "... %d more (tab 2)"
            % (len(app.names) - room + 1), curses.A_DIM)
    if not app.names:
        put(scr, top + 2, 1, "(none: tab 2 adds)", curses.A_DIM)
    put(scr, top + rows - 2, 1, "D default here", curses.A_DIM)
    put(scr, top + rows - 1, 1, "N placed N times  - not", curses.A_DIM)
    for r in range(top - 1, top + rows):
        put(scr, r, width, G["v"], curses.A_DIM)


def draw_surfaces_tab(scr, app, top, rows, width, left):
    """Tab 2: the names, with their labels and where each is at this desk;
    the selected one lit. The one place names are added, relabelled and
    deleted."""
    put(scr, top, left, "%-3s%-22s%-24s%s" % ("", "NAME", "LABEL",
                                              "AT THIS DESK"), curses.A_BOLD)
    room = rows - 2
    first = max(0, min(app.side - room + 1, len(app.names) - room))
    for i, (n, lab) in enumerate(app.names[first:first + room]):
        here, dflt = app.placed(n)
        at = "; ".join("cell %d,%d %s %s" % (x.cx, x.cy, x.conn, x.region)
                       for x in here)
        if dflt:
            at = (at + "; " if at else "") + "DEFAULT, %s %s" % (
                app.default.conn, app.default.region)
        mk, used = mark_of(app, n)
        attr = curses.A_REVERSE if first + i == app.side else \
            (0 if used else curses.A_DIM)
        put(scr, top + 2 + i, left, ("%-3s%-22s%-24s%s" % (
            mk, n, lab, at or "not placed"))[:width].ljust(width), attr)
    if not app.names:
        put(scr, top + 2, left, "no names yet: a adds one", curses.A_DIM)


def draw_virtual(scr, app, top, rows, cols, left):
    """The grid: in every cell a miniature of the desk, each surface drawn
    into its part of its panel; the selected cell, panel and region lit."""
    on = app.desk.on()
    gw, gh = app.grid
    cw, ch = max(8, cols // gw), max(4, (rows - 2) // gh)
    if not on:
        return
    mx = min(o.x for o in on)
    my = min(o.y for o in on)
    bw = max(o.x + o.w for o in on) - mx
    bh = max(o.y + o.h for o in on) - my
    sc = min((cw - 4) / bw, (ch - 3) * 2 / bh)
    sel_o, sel_r = app.vspot()
    for cy in range(gh):
        for cx in range(gw):
            x0, y0 = left + cx * cw, top + cy * ch
            cur = [cx, cy] == app.vcell
            battr = (curses.color_pair(1) | curses.A_BOLD) if cur else \
                curses.A_DIM
            frame(scr, y0, x0, cw, ch, battr, title="%d,%d" % (cx, cy))
            for o in on:
                bx, by, w, h = cells(o, mx, my, sc, y0 + 1, x0 + 2)
                frame(scr, by, bx, w, h, fill=True)
                if cur and o is sel_o:
                    rx, ry, rw, rh = region_rect(sel_r, w - 2, h - 2)
                    for r in range(rh):
                        put(scr, by + 1 + ry + r, bx + 1 + rx, " " * rw,
                            curses.color_pair(3))
                for x in app.surfaces:
                    if x.conn != o.conn or (x.cx, x.cy) != (cx, cy):
                        continue
                    rx, ry, rw, rh = region_rect(x.region, w - 2, h - 2)
                    lit = cur and o is sel_o and x.region == sel_r
                    put(scr, by + 1 + ry + max(0, (rh - 1) // 2),
                        bx + 1 + rx, x.name[:max(1, rw)].center(rw),
                        curses.color_pair(3) if lit else curses.A_BOLD)
    n = [x.name for x in app.at_spot()]
    put(scr, top + gh * ch, left,
        "cell %d,%d  %s %s  %s  -> %s" % (
            app.vcell[0], app.vcell[1], sel_o.conn, sel_o.token(), sel_r,
            ", ".join(n) if n else "(empty)"))
    d = app.default
    put(scr, top + gh * ch + 1, left,
        "default: " + ("%s, %s of %s" % (d.name, d.region, d.conn)
                       if d else "none"), curses.A_DIM)


def draw_physical(scr, app, b, cols, left):
    draw_desk(scr, app, 2, b - 5, cols, left)
    off = [o.conn for o in app.desk.outs if not o.on]
    if off:
        put(scr, b - 3, left, "off: " + "  ".join(off),
            curses.color_pair(1) if not app.cur.on else 0)
    gaps = near_misses(app.desk, NEAR)
    if app.desk.faults():
        put(scr, b - 2, left, "the monitors do not meet edge to edge",
            curses.color_pair(4) | curses.A_BOLD)
    elif gaps:
        put(scr, b - 2, left, "  ".join(
            "%dpx gap between %s and %s" % (g, a, b) for a, b, g in gaps) +
            " (the pointer cannot cross it)",
            curses.color_pair(4) | curses.A_BOLD)


def render(scr, app, now):
    scr.erase()
    h, w = scr.getmaxyx()
    state = "MOVE" if app.moving else ("swap: pick the other" if app.mark
                                      else "")
    tabs = "  ".join(("[%d %s]" if i == app.tab else " %d %s ") % (i + 1, t)
                     for i, t in enumerate(TABS))
    put(scr, 0, 1, "hwdp arrange  %s%s%s%s" % (
        tabs, ("  " + state) if state else "",
        "  labels on" if app.ident else "",
        "  (unsaved)" if app.dirty() else ""), curses.A_BOLD)
    # One help line: this tab's keys, then the global ones. It wraps by
    # whole entries rather than lose its tail at the screen edge, and
    # everything above it moves up to make room.
    keys = ["  ".join(line) for line in
            pack((HELP[app.tab] + "  " + HELP_ALL).split("  "), w - 2)]
    b = h - len(keys)
    # The sidebar everywhere but tab 2, which IS the list of names.
    sw = SIDE_W if w >= 70 and app.tab != 1 else 0
    if sw:
        draw_sidebar(scr, app, 2, b - 3, sw)
    left = sw + 2 if sw else 1
    if app.tab == 0:
        draw_physical(scr, app, b, w - 1 - left, left)
    elif app.tab == 1:
        draw_surfaces_tab(scr, app, 2, b - 3, w - 2, left)
    elif app.tab == 2:
        draw_virtual(scr, app, 2, b - 5, w - 1 - left, left)
    else:
        # Wrapped to the width, scrolled by the arrows; the scroll stops
        # where the last line reaches the bottom.
        lines = []
        for ln in review_lines(app):
            ind = len(ln) - len(ln.lstrip())
            lines += [" " * ind + x for x in
                      wrap([ln.split()], max(10, w - 1 - left - ind))] \
                if ln.strip() else [""]
        room = b - 4
        app.rscroll = min(app.rscroll, max(0, len(lines) - room))
        for i, line in enumerate(lines[app.rscroll:app.rscroll + room]):
            put(scr, 2 + i, left, line,
                curses.A_BOLD if line == "NOTES" or
                line.startswith("cell ") else 0)
        if len(lines) > room:
            put(scr, b - 2, left, "-- lines %d-%d of %d, arrows scroll --" % (
                app.rscroll + 1, min(len(lines), app.rscroll + room),
                len(lines)), curses.A_DIM)
    put(scr, b - 1, 1, app.msg)
    for i, line in enumerate(keys):
        put(scr, b + i, 1, line, curses.A_DIM)
    if app.busy:
        what, since, line = app.busy
        box(scr, ["%s ... %ds" % (what, int(now - since)), "",
                  line[:60] or "working", ""])
    elif app.dialog:
        draw_dialog(scr, app, now)
    scr.refresh()


def run(scr, app):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_YELLOW)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_MAGENTA)
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_GREEN)
    curses.init_pair(4, curses.COLOR_WHITE, curses.COLOR_RED)
    scr.keypad(True)
    scr.timeout(250)
    while not app.done:
        now = time.monotonic()
        render(scr, app, now)
        k = scr.getch()
        if k == -1:
            app.tick(time.monotonic())
        else:
            app.key(k, time.monotonic())


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print(__doc__.split("\n\n")[1])
        return 0
    if len(argv) > 1:
        print("hwdp arrange: the interactive tool takes no arguments",
              file=sys.stderr)
        return 2
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hwdp arrange: the interactive tool needs a terminal; give"
              " placements to script it", file=sys.stderr)
        return 2
    os.environ.setdefault("ESCDELAY", "25")
    # The locale first: curses draws the box glyphs only under it, and only
    # a UTF-8 terminal gets them (a Linux text console stays ASCII).
    import locale
    locale.setlocale(locale.LC_ALL, "")
    if locale.getpreferredencoding(False).upper().replace("-", "") == "UTF8":
        G.update(UTF8)
    hw = Hwdp()
    app = App(Desk(hw.geometry(), hw.repack), hw)

    def leave(*_):
        raise SystemExit(130)
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, leave)
    # The overlay goes whatever ends this: a quit, an exception, a signal.
    # (A SIGKILL cannot run this; the overlay watches our pid for that.)
    try:
        curses.wrapper(run, app)
    finally:
        hw.identify(False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
