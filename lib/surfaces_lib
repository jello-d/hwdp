# surfaces_lib: resolve a desk file against the outputs switched on now.
# Sourced by cmd/surfaces, never executed. See that file for the words and the
# file formats; this holds only the resolver, which is one awk program because
# a panel name is quoted and holds spaces, so the file is parsed by hand.
#
# surfaces_resolve <mode> <desk file> <names file> <built-in name> <pids>
#   stdin   probe_layout's TAB records (the live outputs)
#   mode    emit (the frozen 8 fields) | map (R7) | check (words)
#   names   the global names file, or /dev/null for "do not check names"
#   pids    "<connector> <panel id>" lines, for map
# Exit 2 with every problem on stderr and NOTHING on stdout when the files
# are broken; 0 otherwise.
surfaces_resolve() {
  awk -v mode="$1" -v file="$2" -v namesf="$3" -v bn="$4" -v pids="$5" \
    "$HWDP_AWK_LOGICAL"'
  function err(m) { E[++ne] = FILENAME ":" FNR ": " m }
  function note(m) { O[++no] = m }
  # <region> <W> <H>: sets RX RY RW RH inside a W x H output, and FX FY FW FH
  # as fractions of it.
  function region(r, W, H) {
    RX = 0; RY = 0; RW = W; RH = H; FX = 0; FY = 0; FW = 1; FH = 1
    if (r == "top")    { RH = int(H / 2); FH = 0.5 }
    if (r == "bottom") { RY = int(H / 2); RH = H - RY; FY = 0.5; FH = 0.5 }
    if (r == "left")   { RW = int(W / 2); FW = 0.5 }
    if (r == "right")  { RX = int(W / 2); RW = W - RX; FX = 0.5; FW = 0.5 }
  }
  # Two regions of one panel overlap unless they are opposite halves.
  function clash(a, b) {
    if (a == "full" || b == "full" || a == b) return 1
    if ((a == "top" && b == "bottom") || (a == "bottom" && b == "top"))
      return 0
    if ((a == "left" && b == "right") || (a == "right" && b == "left"))
      return 0
    return 1
  }
  # Is every part of panel p covered in cell x y?
  function covered(p, x, y,   k, t, b, l, r) {
    k = p SUBSEP x SUBSEP y
    if ((k, "full") in AT) return 1
    t = ((k, "top") in AT); b = ((k, "bottom") in AT)
    l = ((k, "left") in AT); r = ((k, "right") in AT)
    return (t && b) || (l && r)
  }
  # <name> "<panel>" ... : sets NM PN and leaves the rest of the line in REST,
  # or reports and returns 0.
  function name_panel(line, what) {
    if (!match(line, /^[A-Za-z0-9_-]+/)) { err("bad " what " name"); return 0 }
    NM = substr(line, 1, RLENGTH); line = substr(line, RLENGTH + 1)
    if (!match(line, /^[ \t]+"[^"]+"/)) {
      err(NM ": the panel must be a quoted EDID name or \"@builtin\"")
      return 0
    }
    PN = substr(line, RSTART, RLENGTH); REST = substr(line, RLENGTH + 1)
    sub(/^[ \t]+"/, "", PN); sub(/"$/, "", PN)
    return 1
  }
  function region_word(s) {
    gsub(/^[ \t]+|[ \t]+$/, "", s)
    if (s == "") s = "full"
    if (s !~ /^(top|bottom|left|right|full)$/) {
      err(NM ": region `" s "` is not one of top bottom left right full")
      return ""
    }
    return s
  }
  function listed(n) {
    if (namesf == "/dev/null" || (n in LIST)) return 1
    err("`" n "` is not in the names file " namesf " (a typo? add it there)")
    return 0
  }
  BEGIN {
    np = split(pids, pl, "\n")
    for (i = 1; i <= np; i++) { split(pl[i], f, " "); PID[f[1]] = f[2] }
  }
  FILENAME == "-" {
    split($0, f, "\t")
    if (f[1] == "") next
    # The built-in answers to its role as well as its name, so a generic
    # file and a docked desk can both say "@builtin".
    na = (bn != "" && f[1] == bn) ? 2 : 1; AL[1] = f[1]; AL[2] = "@builtin"
    for (q = 1; q <= na; q++) {
      ATT[AL[q]] = 1
      if (f[12] == 1 && f[3] + 0 > 0) {
        ON[AL[q]] = f[2]; lsize(f[3], f[4], f[8], f[9])
        LWD[AL[q]] = LW; LHT[AL[q]] = LH
      }
    }
    # The real name only, so a panel is judged once, not once per alias.
    if (f[12] == 1 && f[3] + 0 > 0) REAL[f[1]] = 1
    next
  }
  FILENAME == namesf {
    if ($0 ~ /^[ \t]*(#|$)/) next
    if ($1 !~ /^[A-Za-z0-9_-]+$/) { err("bad name `" $1 "`"); next }
    if ($1 in LIST) { err("`" $1 "` is listed twice"); next }
    LIST[$1] = ++nl; LN[nl] = $1
    next
  }
  /^[ \t]*(#|$)/ { next }
  {
    line = $0; sub(/^[ \t]+/, "", line)
    kw = line; sub(/[ \t].*/, "", kw); sub(/^[a-z]+[ \t]*/, "", line)
    if (kw == "grid") {
      if (line !~ /^[1-9][0-9]*[ \t]+[1-9][0-9]*[ \t]*$/) {
        err("expected `grid <w> <h>`"); next
      }
      if (GW) { err("the grid is set twice"); next }
      split(line, g, /[ \t]+/); GW = g[1] + 0; GH = g[2] + 0; next
    }
    if (kw == "default") {
      if (!name_panel(line, "default")) next
      if ((rg = region_word(REST)) == "") next
      if (DN != "") { err("the default is set twice"); next }
      if (!listed(NM)) next
      DN = NM; DP = PN; DR = rg; DL = FNR; next
    }
    if (kw != "surface") {
      err("expected `grid`, `surface` or `default`"); next
    }
    if (!name_panel(line, "surface")) next
    if (!match(REST, /^[ \t]+cell[ \t]+[0-9]+[ \t]+[0-9]+/)) {
      err(NM ": expected `cell <x> <y>` after the panel"); next
    }
    cs = substr(REST, RSTART, RLENGTH); REST = substr(REST, RLENGTH + 1)
    sub(/^[ \t]+/, "", cs); split(cs, c, /[ \t]+/)   # cell, x, y
    if ((rg = region_word(REST)) == "") next
    if (NM in SEEN) { err("surface `" NM "` is defined twice"); next }
    if (!listed(NM)) next
    SEEN[NM] = 1
    n++; SN[n] = NM; SP[n] = PN; SX[n] = c[2]; SY[n] = c[3]; SR[n] = rg
    SL[n] = FNR
  }
  END {
    for (i = 1; i <= n; i++) {
      if (GW && (SX[i] + 0 >= GW || SY[i] + 0 >= GH))
        E[++ne] = file ":" SL[i] ": `" SN[i] "` is in cell " SX[i] " " \
          SY[i] ", outside the grid (" GW "x" GH ")"
      if (SN[i] == DN)
        E[++ne] = file ":" SL[i] ": `" SN[i] "` is both a surface and" \
          " the default"
      for (j = i + 1; j <= n; j++)
        if (SP[i] == SP[j] && SX[i] == SX[j] && SY[i] == SY[j] \
            && clash(SR[i], SR[j]))
          E[++ne] = file ": `" SN[i] "` (" SR[i] ") and `" SN[j] "` (" \
            SR[j] ") claim the same part of \"" SP[i] "\" in cell " \
            SX[i] " " SY[i]
    }
    if (ne > 0) {
      for (i = 1; i <= ne; i++) print "hwdp surfaces: " E[i] > "/dev/stderr"
      exit 2
    }
    if (mode == "check" && GW) print "grid  " GW "x" GH
    for (i = 1; i <= n; i++) {
      p = SP[i]
      if (!(p in ATT)) {
        note("`" SN[i] "`: no attached panel is named \"" p "\" (a typo?)")
        continue
      }
      if (!(p in ON)) {
        note("`" SN[i] "`: \"" p "\" is attached but switched off; skipped")
        continue
      }
      PLACED[SN[i]] = 1
      # Coverage is judged on the panel itself, so the role and the real
      # name of the built-in count as one panel.
      rp = (p == "@builtin") ? bn : p
      AT[rp, SX[i], SY[i], SR[i]] = 1
      region(SR[i], LWD[p], LHT[p])
      if (mode == "emit")
        printf "%s %s %d %d %d %d %d %d\n", SN[i], ON[p], SX[i], SY[i], \
          RX, RY, RW, RH
      else if (mode == "map")
        printf "%s %s %d %d %d %d %d %d %s %g %g %g %g\n", SN[i], ON[p], \
          SX[i], SY[i], RX, RY, RW, RH, PID[ON[p]], FX, FY, FW, FH
      else
        printf "ok    %-12s %s, %s of %s (%dx%d at %d,%d), cell %d %d\n", \
          SN[i], ON[p], (SR[i] == "full") ? "all" : SR[i] " half", p, \
          RW, RH, RX, RY, SX[i], SY[i]
    }
    if (DN != "") {
      if (!(DP in ON))
        note("the default `" DN "`: \"" DP "\" is not switched on; there" \
          " is no default here")
      else {
        PLACED[DN] = 1
        region(DR, LWD[DP], LHT[DP])
        if (mode == "map")
          printf "%s %s * * %d %d %d %d %s %g %g %g %g\n", DN, ON[DP], \
            RX, RY, RW, RH, PID[ON[DP]], FX, FY, FW, FH
        else if (mode == "check")
          printf "ok    %-12s %s, %s of %s: the DEFAULT, for any cell no" \
            " surface claims\n", DN, ON[DP], (DR == "full") ? "all" : \
            DR " half", DP
      }
    }
    if (mode == "check") {
      for (p in REAL) {
        used = 0
        for (k in AT) { split(k, kk, SUBSEP); if (kk[1] == p) used = 1 }
        if (!used && DP != p && !(DP == "@builtin" && p == bn))
          note("\"" p "\" (" ON[p] ") is switched on and has no surface")
        if (!GW || (DN != "" && (DP in ON))) continue
        gaps = 0
        for (x = 0; x < GW; x++) for (y = 0; y < GH; y++)
          if (!covered(p, x, y)) gaps++
        if (gaps)
          note("\"" p "\": " gaps " of " GW * GH " cells are not fully" \
            " covered and there is no default (a gap in the map)")
      }
      for (i = 1; i <= nl; i++)
        if (!(LN[i] in PLACED)) note("`" LN[i] "` is not placed at this desk")
    }
    for (i = 1; i <= no; i++)
      if (mode == "check") print "note  " O[i]
      else print "hwdp surfaces: " O[i] > "/dev/stderr"
  }' - "$3" "$2"
}
