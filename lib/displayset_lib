# lib/displayset_lib: the DISPLAY SET view, shared by the subcommands
# that reason about "the monitors on this box" rather than about one output.
# Sourced after (or instead of) probe_lib, which it pulls in itself.
#
# probe_lib answers what the hardware and the compositor report. This file is
# the layer above: where this box keeps its per-display-set state, and the
# two coarsenings every consumer asks for: the output list in the shape
# kanshi needs, and the panel COUNT bucketed into a workspace shape.
#
# Everything density- or layout-specific stays in the subcommand that owns it
# (cmd/ui owns the density policy, cmd/layout owns the sticky scale), so this
# holds only what more than one of them genuinely needs.

: "${HWDP_LIB:?displayset_lib: HWDP_LIB must be set}"
. "$HWDP_LIB/probe_lib"

# ${HOME:-}: see probe_lib. A daemon-invoked probe with no HOME must degrade to
# "no user-scope profiles", not abort under set -u.
_cfg=${XDG_CONFIG_HOME:-${HOME:-}/.config}/kanshi
PROFILES=${KANSHI_PROFILES:-$_cfg/profiles}
STICKY=${KANSHI_STICKY:-$_cfg/auto-scale}
# IN OUR OWN RUNTIME DIRECTORY, like the supervisor's files: one directory per
# package is what lets `setup.sh paths` name the root and an audit sweep it.
# Created here because a consumer may generate the config before any supervisor
# has run. The fallback keeps a box with no XDG_RUNTIME_DIR working.
_rtd=${XDG_RUNTIME_DIR:-/tmp}/hwdp
mkdir -p "$_rtd" 2>/dev/null || _rtd=${XDG_RUNTIME_DIR:-/tmp}
OUT=${KANSHI_OUT:-$_rtd/layout.config}
TAB=$(printf '\t')

# outputs: one TAB record per output we can actually act on,
#   edid \t connector \t res_w \t res_h \t mm_w \t mm_h \t rate \t
#   transform \t pos
#
# A projection of probe_layout, and the FILTER is this layer's policy, not the
# provider's: an output is keyed by its EDID "Make Model Serial" and its sticky
# scale is signed with its physical size, so one missing either is not one we
# can place. The `enabled` test used to be implicit: a disabled output has no
# current mode, so it fell out by accident, and is explicit here.
outputs() {
  probe_layout | awk -F"$TAB" -v OFS="$TAB" '
    $1 != "" && $12 == 1 && $3 + 0 > 0 && $5 + 0 > 0 {
      print $1, $2, $3, $4, $5, $6, $7, $8, $10 "," $11
    }'
}

# layout_faults: read the LOGICAL rects of the enabled outputs, one per line,
#   name \t x \t y \t w \t h
# and print one TAB line per fault, nothing at all when the layout is sound:
#   overlap \t A \t B \t <w>x<h>     two outputs share area
#   gap     \t A \t B \t <px>        A touches nothing joined to the first
#                                    output; B is its nearest, <px> away
#   corner  \t A \t B \t 0           the same, but A meets B at a corner
#                                    only, which shares no edge
#
# THE INVARIANT IS EDGE-TO-EDGE. Every output must share an edge (not a
# corner) with the rest, so the outputs form ONE connected surface. That is
# what edge-flipping reads: it marks an edge INTERIOR only when a neighbour's
# edge sits at EXACTLY the same coordinate, so a 40px gap makes every edge
# exterior and pushing the pointer at a neighbour flips the workspace instead
# of crossing. Measured in a nested wayfire (the usher session's edge probe).
# A vertical OFFSET is fine, a portrait beside a centred landscape still
# shares an edge, which is why this asks about edges and not about alignment.
#
# PURE (stdin to stdout), so every verdict is reachable from a test.
layout_faults() {
  awk -F"$TAB" '
    function find(i) { while (P[i] != i) i = P[i]; return i }
    function span(a1, a2, b1, b2,   lo, hi) {   # overlap length, < 0 = apart
      lo = (a1 > b1) ? a1 : b1; hi = (a2 < b2) ? a2 : b2
      return hi - lo
    }
    NF >= 5 {
      n++; N[n] = $1; X[n] = $2 + 0; Y[n] = $3 + 0
      W[n] = $4 + 0; H[n] = $5 + 0; P[n] = n
    }
    END {
      for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) {
        ox = span(X[i], X[i] + W[i], X[j], X[j] + W[j])
        oy = span(Y[i], Y[i] + H[i], Y[j], Y[j] + H[j])
        # An overlap is reported AND joined: the overlap is the fault, and
        # calling the same pair "apart" as well would be a second, false one.
        if (ox > 0 && oy > 0)
          printf "overlap\t%s\t%s\t%dx%d\n", N[i], N[j], ox, oy
        if ((ox >= 0 && oy > 0) || (oy >= 0 && ox > 0)) {
          a = find(i); b = find(j); if (a != b) P[b] = a
        }
      }
      root = find(1)
      for (i = 2; i <= n; i++) {
        if (find(i) == root) continue
        best = 0; bg = -1
        for (j = 1; j <= n; j++) {
          if (find(j) != root) continue
          ox = span(X[i], X[i] + W[i], X[j], X[j] + W[j])
          oy = span(Y[i], Y[i] + H[i], Y[j], Y[j] + H[j])
          g = (-ox > -oy) ? -ox : -oy
          if (bg < 0 || g < bg) { bg = g; best = j }
        }
        if (bg == 0) printf "corner\t%s\t%s\t0\n", N[i], N[best]
        else printf "gap\t%s\t%s\t%d\n", N[i], N[best], bg
      }
    }'
}

# layout_fault_text: layout_faults' records as sentences, for a human.
layout_fault_text() {
  awk -F"$TAB" '
    $1 == "overlap" { printf "%s and %s OVERLAP by %s\n", $2, $3, $4 }
    $1 == "gap"     { printf "%s does not touch %s: %dpx apart, so they " \
                        "share no edge and edge flipping treats both as " \
                        "outer edges\n", $2, $3, $4 }
    $1 == "corner"  { printf "%s meets %s only at a corner, so they share " \
                        "no edge to cross\n", $2, $3 }'
}

# live_rects [edid]: the enabled outputs' LOGICAL rects as the compositor has
# them now, in layout_faults' input format, named by connector, or with `edid`
# by the EDID name a kanshi profile keys on.
live_rects() {
  _lk=2; [ "${1:-}" = edid ] && _lk=1
  probe_layout | awk -F"$TAB" -v OFS="$TAB" -v k="$_lk" "$HWDP_AWK_LOGICAL"'
    $12 == 1 && $3 + 0 > 0 && $k != "" {
      lsize($3, $4, $8, $9); print $k, $10, $11, LW, LH
    }'
}

# profile_rects: the rects an authored profile was CAPTURED at, from the
# `# hwdp-rect "<name>" x y w h` comments capture writes, in layout_faults'
# format. Empty for a profile written by hand or by an older capture.
profile_rects() {
  awk -v OFS="$TAB" '
    /^# hwdp-rect "/ {
      nm = $0; sub(/^# hwdp-rect "/, "", nm); sub(/".*/, "", nm)
      r = $0; sub(/^# hwdp-rect "[^"]*" */, "", r); split(r, a, " ")
      print nm, a[1], a[2], a[3], a[4]
    }'
}

# layout_repack: re-place an authored arrangement at NEW sizes, keeping its
# shape. Reads, TAB separated,
#   old \t name \t x \t y \t w \t h     the rects it was captured at
#   new \t name \t w \t h               each output's size NOW
# and prints `name \t x \t y` for every old output.
#
# WHY: a captured profile's positions are only right at the scales it was
# captured at, since capture records no scale and layout injects the sticky
# ones. Change a scale afterwards (a hand edit, or HWDP_TARGET_PPI) and the
# outputs no longer meet: halve one panel's logical width and its neighbour
# is left a whole half-panel away.
#
# THE TOPOLOGY IS KEPT, THE COORDINATES ARE RECOMPUTED. Which output sits on
# which side of which is read from the OLD rects (they shared exact edges, or
# capture would have refused them), then each is placed against a neighbour
# already placed, walking out from the first. Along the shared edge the old
# offset is kept by MEANING: top/left-aligned stays aligned, bottom/right
# stays aligned, and anything else keeps its midpoint at the same fraction of
# the neighbour's edge, which keeps a centred panel centred. The result is
# shifted so the top-left is 0,0. An output the walk cannot reach (the old
# rects did not join it) keeps its old position, and the gap check that
# follows will say so.
#
# PURE (stdin to stdout).
layout_repack() {
  awk -F"$TAB" -v OFS="$TAB" '
    function span(a1, a2, b1, b2,   lo, hi) {
      lo = (a1 > b1) ? a1 : b1; hi = (a2 < b2) ? a2 : b2
      return hi - lo
    }
    # <old offset> <old edge a> <old edge b> <new edge a> <new edge b>
    function off(d, ea, eb, na, nb,   v) {
      if (d == 0) return 0
      if (d + eb == ea) return na - nb
      v = (d + eb / 2) / ea * na - nb / 2
      return (v >= 0) ? int(v + 0.5) : -int(-v + 0.5)
    }
    $1 == "old" {
      n++; N[n] = $2; X[n] = $3 + 0; Y[n] = $4 + 0
      W[n] = $5 + 0; H[n] = $6 + 0
    }
    $1 == "new" { NW[$2] = $3 + 0; NH[$2] = $4 + 0 }
    END {
      if (n == 0) exit
      for (i = 1; i <= n; i++) {
        w[i] = (N[i] in NW) ? NW[N[i]] : W[i]
        h[i] = (N[i] in NH) ? NH[N[i]] : H[i]
        px[i] = X[i]; py[i] = Y[i]
      }
      seen[1] = 1; q[1] = 1; qh = 1; qt = 1
      while (qh <= qt) {
        a = q[qh++]
        for (b = 1; b <= n; b++) {
          if (b in seen) continue
          ox = span(X[a], X[a] + W[a], X[b], X[b] + W[b])
          oy = span(Y[a], Y[a] + H[a], Y[b], Y[b] + H[b])
          if (oy > 0 && X[a] + W[a] == X[b]) {
            px[b] = px[a] + w[a]
            py[b] = py[a] + off(Y[b] - Y[a], H[a], H[b], h[a], h[b])
          } else if (oy > 0 && X[b] + W[b] == X[a]) {
            px[b] = px[a] - w[b]
            py[b] = py[a] + off(Y[b] - Y[a], H[a], H[b], h[a], h[b])
          } else if (ox > 0 && Y[a] + H[a] == Y[b]) {
            py[b] = py[a] + h[a]
            px[b] = px[a] + off(X[b] - X[a], W[a], W[b], w[a], w[b])
          } else if (ox > 0 && Y[b] + H[b] == Y[a]) {
            py[b] = py[a] - h[b]
            px[b] = px[a] + off(X[b] - X[a], W[a], W[b], w[a], w[b])
          } else continue
          seen[b] = 1; q[++qt] = b
        }
      }
      mx = px[1]; my = py[1]
      for (i = 2; i <= n; i++) {
        if (px[i] < mx) mx = px[i]
        if (py[i] < my) my = py[i]
      }
      for (i = 1; i <= n; i++) print N[i], px[i] - mx, py[i] - my
    }'
}

# config_rects: the same, read from a generated kanshi config on stdin, so the
# check runs against what kanshi will APPLY (after hwdp layout injected the
# scales), named by the EDID descriptor the config uses. A disabled output
# occupies no space and is skipped.
config_rects() {
  awk -v OFS="$TAB" "$HWDP_AWK_LOGICAL"'
    /^[ \t]*output "/ && !/ disable([ \t]|$)/ {
      nm = $0; sub(/^[ \t]*output "/, "", nm); sub(/".*/, "", nm)
      w = h = x = y = 0; tx = "normal"; s = 1
      if (match($0, / mode [0-9]+x[0-9]+/)) {
        m = substr($0, RSTART + 6, RLENGTH - 6); split(m, a, "x")
        w = a[1]; h = a[2]
      }
      if (match($0, / position -?[0-9]+,-?[0-9]+/)) {
        m = substr($0, RSTART + 10, RLENGTH - 10); split(m, a, ",")
        x = a[1]; y = a[2]
      }
      if (match($0, / transform [a-z0-9-]+/))
        tx = substr($0, RSTART + 11, RLENGTH - 11)
      if (match($0, / scale [0-9.]+/))
        s = substr($0, RSTART + 7, RLENGTH - 7)
      if (w > 0) { lsize(w, h, tx, s); print nm, x, y, LW, LH }
    }'
}

# heads: one TAB line per display that counts, `connector \t w \t h`, with
# w and h the LOGICAL size (after rotation and scale) so the orientation is
# the one a user sees.
#
# LAYOUT first, PANELS as the fallback: in a session the compositor's view is
# the one to act on (an output you switched off does not count), but at the
# greeter or from a TTY there is no compositor and the kernel's view is the
# only truthful answer available. HEADLESS HAS NO ROTATION: the kernel reports
# a panel's native mode, so a portrait-mounted panel reads landscape there.
# Every consumer of the shape runs in a session, so that is said rather than
# guessed around (an authored profile names panels by EDID and the kernel by
# connector, and nothing headless joins the two).
heads() {
  _hd=$(probe_layout | awk -F"$TAB" -v OFS="$TAB" "$HWDP_AWK_LOGICAL"'
    $12 == 1 && $3 + 0 > 0 { lsize($3, $4, $8, $9); print $2, LW, LH }')
  [ -n "$_hd" ] || _hd=$(probe_panels | awk -F"$TAB" -v OFS="$TAB" '
    $2 != "" { print $2, $3 + 0, $4 + 0 }')
  [ -n "$_hd" ] && printf '%s\n' "$_hd"
  return 0
}

# panel_count: how many heads count, for policy that depends on HOW MANY
# (cmd/ui: a wall of three or more never takes the low-density set).
panel_count() {
  heads | grep -c . || true
}

# shape: the workspace SHAPE, a DESK KIND rather than a count. One token per
# head: `B` for a built-in panel (an eDP, LVDS or DSI connector) or `E` for an
# external one, then `L` or `P` for landscape or portrait as the user sees it,
# joined with `+` and SORTED, which in plain byte order is B before E and L
# before P:
#
#   BL            a laptop on its own
#   EL+EP         two externals, the built-in switched off
#   BL+EL+EP      the same with the built-in on
#   EP+EP+EP      a portrait wall (what `triple` always meant)
#
# SORTED, NOT LEFT TO RIGHT, so rearranging the panels does not change the
# shape, and it needs no positions (which only a compositor has). Empty with
# no displays at all. A square panel reads landscape.
#
# It replaced `single | triple` (2026-10-29), which keyed on the COUNT alone:
# a laptop and a lone external were the same shape, and a landscape pair was
# the same as a portrait one. The grid, the workspace names and the wallpaper
# are functions of what KIND of desk this is, which the count could not say.
shape() {
  heads | awk -F"$TAB" '
    {
      k = ($1 ~ /^(eDP|LVDS|DSI)/) ? "B" : "E"
      t[++n] = k (($3 + 0 > $2 + 0) ? "P" : "L")
    }
    END {
      for (i = 2; i <= n; i++) {          # insertion sort, n is tiny
        v = t[i]; j = i - 1
        while (j > 0 && t[j] > v) { t[j + 1] = t[j]; j-- }
        t[j + 1] = v
      }
      for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "+" : ""), t[i]
      if (n) printf "\n"
    }'
}

# panel_width: the width in px of the first display, for density decisions.
# Layout first then panels, exactly as shape does. Prints nothing when no
# display answers, or when the kernel lists a connector with no modes (width 0
# means UNKNOWN, not tiny, and a caller must not read it as a small panel).
panel_width() {
  _pw=$(outputs | head -1 | cut -f3)
  [ -n "$_pw" ] || _pw=$(probe_panels | head -1 | cut -f3)
  [ "${_pw:-0}" -gt 0 ] 2>/dev/null || return 0
  printf '%s' "$_pw"
}
